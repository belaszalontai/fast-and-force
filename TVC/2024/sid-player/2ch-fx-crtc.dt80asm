				
				org	6639			; TVC programok kezdőcíme
                                ;{BASIC Header
				db	$0F,$0A,$0,$DD		; "10 PRINT" - basic token
				db	' USR'			; " USR"
				db	$96			; "("
				db	'6659'			; "6659"
				db	$95,$FF			; ")"                         
				db	0,0,0,0,0		; így 20 byte a BASIC header, a kód pedig 6659-nél ($1A03) kezdődik
                                ;}
				
				jp	INIT			; <- 6659 ($1A03) memóriacím (a BASIC header ezt hívja meg a "10 PRINT USR(6659)" utasítással)
				
;******************************************************************
; INTERRUPT HANDLER 
; Worst Case Execution time: 204 cycle 
; Interrupt Frequency: ~ 4340 Hz
; CPU load by IRQ max: 29% (71% of CPU can be used)
;
; DE' = ch 1 phase accumulator counter;
; HL' = ch 2 phase accumulator counter
; BC' = local variable
;
;******************************************************************                                         
	IT_HANDLER		ex	af,af'
				exx
				out	(7),a			; ack interrupt
				
	CRTC_SYNC_CNT		ld	a,SYNC_COUNT		; alter crtc sync counter         
				dec	a
				ld	(CRTC_SYNC_CNT+1),a	; self modifying code
				
; alter phase accumulator counters for channels
	PAC1			ld	bc,$0000
				ex	de,hl
				add	hl,bc
				ex	de,hl			; DE = DE + phase accumulator increment 1
	PAC2			ld	bc,$0000
				add	hl,bc			; HL = HL + phase accumulator increment 2
				
; convert signal to waveform
	ch1_waveform_tableH	ld	b,$1D			; address of wave table for channel 1
				ld	c,d
				ld	a,(bc)			; lookup wave table for channel 1
				ld	c,h			; save h
				ld	h,a
	ch2_waveform_tableH	ld	b,$1E			; address of wave table for channel 2
				ld	a,(bc)			; lookup wave table for channel 2
				add	a,h			; mix two channels
				ld	h,c			; restore h
; write to sound port				
				or	1			; must have in 16 color graphics mode (or 1 in 4 color mode)
				out	(6),a			; write to sound port
				exx
				ex	af,af'
				ei
				ret
				
	SYNC_COUNT		equ	85			; 85 for 20ms 50FPS, 171 for 40ms 25FPS (1 / 3125000/16/45/SYNC_COUNT)
				
;******************************************************************
; INIT MUSIC MIXER INTERRUPT HANDLER
;******************************************************************
	IT_HANDLER_1		db	00h
	IT_HANDLER_2		dw	0000h
				
	START_MUSIC_MIXER	ld	A,SYNC_COUNT
				ld	(CRTC_SYNC_CNT+1),A
				ld	A,10			; disable CRTC CURSOR IT
				out	(112),A
				ld	A,35
				out	(113),A
				ld	A,$D3			; Sound IT counter divider LO
				out	(4),A			; (4096 - 45 = 4051 = $0FD3)
				ld	A,32+$0F		; Sound IT enabled, sound is OFF + divider HI
				out	(5),A			; IT frequency = Fsys / 16 / 45 = ~ 4340,27 Hz
				ld	A,(0038h)		; SAVE IT HANDLER
				ld	(IT_HANDLER_1),A
				ld	HL,(0039h)
				ld	(IT_HANDLER_2),HL
				ld	A,0C3h			; @038h -> JP Address_of_IT_HANDLER
				ld	(0038h),A
				ld	HL,IT_HANDLER
				ld	(0039H),HL
				ei				; enable interrupt
				ret
				
;******************************************************************
; RESTORE INTERRUPT HANDLER
;******************************************************************
	STOP_MUSIC_MIXER	di
				ld	A,10			; restore the original interrupt
				out	(112),A
				ld	A,3
				out	(113),A			; CURSOR IT enabled
				xor	A
				out	(4),A
				out	(5),A			; Sound IT disabled, Sound is OFF
				ld	A,(IT_HANDLER_1)	; RESTORE IT HANDLER
				ld	(0038h),A
				ld	HL,(IT_HANDLER_2)
				ld	(0039h),HL
				ei
				ret
				
;******************************************************************
; trigger a sound effect on channel 2
;******************************************************************
	SOUND_FX_XPLODE		ld	a,$20			; address high value of noise table
				ld	(ch2_waveform_tableH+1),a; channel 2 is used for sound effect from now
				ld	bc,$0040		; starting frequency 
				ld	(PAC2+1),bc
				ret
				
;******************************************************************
; init sound player
;******************************************************************
	INIT			di				; IT disabled
				exx				; save shadow registers
				push	HL
				push	BC
				push	DE
				exx
				
				call	START_MUSIC_MIXER	; starts SOUND GENERATOR INTERRUPT
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   
	RUNLOOP			ld	A,(CRTC_SYNC_CNT+1)	; WAITING FOR THE GIVEN NUMBER OF INTERRUPTS
				or	A			; INSTEAD OF Z80's HALT
				jr	NZ,RUNLOOP		; wait for proper number of cycle
				ld	A,SYNC_COUNT
				ld	(CRTC_SYNC_CNT+1),A	; ack the SIGNAL            
				ld	A,10			; restore the original interrupt
				out	(112),A
				ld	A,3
				out	(113),A			; CURSOR IT enabled                   
				xor	A			; sound IT disabled
				out	(5),A
				halt				; WAIT for a real CRTC sync by cursor interrupt
				ld	A,10
				out	(112),A
				ld	A,35
				out	(113),A			; CURSOR IT disabled
				ld	A,32+15			; Sound IT enabled, HW sound generator is OFF
				out	(5),A
				
;--------------------------------------------------------------------------------------------------------------------------------------                                                                      	
; now we are synced with crtc (for 50 fps -> we have 14 msec to process game, for 25 fps -> we have 28 msec to process the game)
				
	PROCESSING_GAME		ld	a,255
				out	(0),a
				halt				; @4340Hz it is 1/4340*1000 ms = 0,23msec
				xor	a
				out	(0),a
				
	KEY_CHECK		ld	A,7			; check the SPACE button
				out	(3),A			; select 7th row of keyboard matrix
				in	A,(88)			; read keyboard matrix row
				bit	5,A			; check SPACE key is pressed                           
				jr	NZ,PG_ESC
				call	SOUND_FX_XPLODE		; trigger explode sound fx
				
	PG_ESC			ld	A,7			; check the ESC button
				out	(3),A			; select 7th row of keyboard matrix
				in	A,(88)			; read keyboard matrix row
				bit	3,A			; check ESC key is pressed                           
				jr	NZ,MUSIC_PROCESSOR
				jr	END_OF_GAME		; end of GAME (exit)
				
;-------------------------------------------------------------------------------------------------------------------------------------- 
; music processor must be at the end of game processing loop
				
	MUSIC_PROCESSOR		ld	a,(ch2_waveform_tableH+1); processing possible EFX on channel 2
				cp	$20			; check if channel-1 is sound or EFX channel
				jr	nz,MP_NEXT
				ld	a,(PAC2+1)
				sub	4			; decrement effect channel frequency
				ld	(PAC2+1),a
				jr	nz,MP_NEXT
				ld	a,$1E			; effect is over change the channel back to sound
				ld	(ch2_waveform_tableH+1),a
				
	MP_NEXT			ld	A,1			; count duration
				dec	A
				ld	(MP_NEXT+1),A
				jr	NZ,RUNLOOP
				ld	a,1
				ld	(MP_NEXT+1),A
				
	MUSICPOS		ld	HL,MUSIC_DATA-1
				ld	d,$1c			; high address of sound frequency constant lookup table
	MP_CH1			inc	hl
				ld	a,(hl)			; load first byte of music record
; check control codes for channel 1
				cp	LOOP			; first byte can be LOOP control
				jr	nz,MP_SKIP
	MUSIC_RESTART		ld	HL,MUSIC_DATA-1		; reset music data pointer
				ld	(MUSICPOS+1),HL
				jr	MP_CH1			; restart parsing
				
	MP_SKIP			cp	SKIP
				jr	z,MP_CH2		; SKIP -> skip channel 1
; handle normal musical note on CH1
				ld	e,a
				sla	e			; low address of sound frequency constant lookup table = control code * 2
				ld	a,(de)			; load frequ constant for CH1
				inc	de
				ld	c,a
				ld	a,(de)
				ld	b,a
				ld	(PAC1+1),BC		; put into CH1 freq constant in irq handler    	
				
	MP_CH2			ld	a,(ch2_waveform_tableH+1)
				cp	$20			; check if channel-1 is sound or EFX channel
				jr	nz,ch2_is_sound
				inc	hl			; skip music record for channel 2
				ld	(MUSICPOS+1),HL
				jp	RUNLOOP			; go to runloop
				
	ch2_is_sound		inc	hl
				ld	a,(hl)
; check control codes for channel 2
				cp	SKIP
				jr	z,MP_END		; SKIP -> skip channel 2
; handle normal musical note on CH2
				ld	e,a
				sla	e			; low address of sound frequency constant lookup table
				ld	a,(de)			; load frequ constant for CH2
				inc	de
				ld	c,a
				ld	a,(de)
				ld	b,a
				ld	(PAC2+1),BC		; put into CH2 freq constant in irq handler     				
				
	MP_END			ld	(MUSICPOS+1),HL
				jp	RUNLOOP			; go to runloop
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   
	END_OF_GAME		call	STOP_MUSIC_MIXER	; stops SOUND GENERATOR INTERRUPT
				exx				; restore ex registers
				pop	DE
				pop	BC
				pop	HL
				exx
				ret				; exit
				
;******************************************************************
; MUSIC PLAYER DATA
;******************************************************************
				
	DURATION_COUNTER	db	0
	MUSIC_DATA_POINTER	dw	$0000
				
				org	$1c00
; Freq divider table for musical sounds (address must be divisible by 256)			
	SOUND_TABLE		dw	494			; 32.7 Hz
				dw	523			; 34.65 Hz
				dw	554			; 36.71 Hz
				dw	587			; 38.89 Hz
