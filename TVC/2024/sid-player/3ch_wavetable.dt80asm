	C5			equ	49
	CISZ5			equ	50
	D5			equ	51
	DISZ5			equ	52
	E5			equ	53
	F5			equ	54
	FISZ5			equ	55
	G5			equ	56
	GISZ5			equ	57
	A5			equ	58
