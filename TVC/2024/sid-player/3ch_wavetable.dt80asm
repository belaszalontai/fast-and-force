	C8			equ	85
				
; definition of control codes	
	MUTE			equ	86			; 0 Hz	channel is muted
	SKIP			equ	0			; channel is skipped (previous sound continues)
				
	FRQINC00		equ	87			; increase freq const by 256
	FRQINC01		equ	88			; increase freq const by 16
	FRQINC02		equ	89			; increase freq const by 32
	FRQINC03		equ	90			; increase freq const by 48
	FRQINC04		equ	91			; increase freq const by 64
	FRQINC05		equ	92			; increase freq const by 80
	FRQINC06		equ	93			; increase freq const by 96
	FRQINC07		equ	94			; increase freq const by 112
	FRQINC08		equ	95			; increase freq const by 128
	FRQINC09		equ	96			; increase freq const by 144
	FRQINC0A		equ	97			; increase freq const by 160
	FRQINC0B		equ	98			; increase freq const by 176
	FRQINC0C		equ	99			; increase freq const by 192
	FRQINC0D		equ	100			; increase freq const by 208
	FRQINC0E		equ	101			; increase freq const by 224
	FRQINC0F		equ	102			; increase freq const by 240					
				
	FRQDEC00		equ	103			; decrease freq const by 256
	FRQDEC01		equ	104			; decrease freq const by 16
	FRQDEC02		equ	105			; decrease freq const by 32
	FRQDEC03		equ	106			; decrease freq const by 48
	FRQDEC04		equ	107			; decrease freq const by 64
	FRQDEC05		equ	108			; decrease freq const by 80
	FRQDEC06		equ	109			; decrease freq const by 96
