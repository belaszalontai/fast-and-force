				
				org	6639			; TVC programok kezdőcíme
                                ;{BASIC Header
				db	$0F,$0A,$0,$DD		; "10 PRINT" - basic token
				db	' USR'			; " USR"
				db	$96			; "("
				db	'6659'			; "6659"
				db	$95,$FF			; ")"                         
				db	0,0,0,0,0		; így 20 byte a BASIC header, a kód pedig 6659-nél ($1A03) kezdődik
                                ;}
				
				jp	MAIN			; <- 6659 ($1A03) memóriacím (a BASIC header ezt hívja meg a "10 PRINT USR(6659)" utasítással)
				
;******************************************************************
; INTERRUPT HANDLER 
; Execution time: 258 cycle 
; Interrupt Frequency: ~ 8491.847826086956 Hz
; CPU load by IRQ: 71%
;
; EXX IX = channel 1 phase accumulator 
; EXX IY = channel 2 phase accumulator 
; EXX HL = channel 3 phase accumulator 
;
; EXX BC = local variable for calculation 
; EXX DE = local variable for mixing
;******************************************************************                                         
	IT_HANDLER		ex	af,af'
				exx
				out	(7),a			;   	ack interrupt
				
; alter phase accumulator counter for channel 1
	PAC1			ld	BC,$0000
				add	IX,BC			; 	IX = IX + phase accumulator freq const
				
; alter phase accumulator counter for channel 2
	PAC2			ld	BC,$0000
				add	IY,BC			; 	IY = IY + phase accumulator freq const
				
; alter phase accumulator counter for channel 3
	PAC3			ld	BC,$0000
				add	HL,BC			; 	HL = HL + phase accumulator freq const
				
; convert signal to waveform
				ld	c,ixh
	CH1_WAVE		ld	b,WAVEFORM01		; 	address of wave table for channel 1
				ld	a,(bc)			;	lookup wave table for channel 1		
				ld	d,a			; 	MIX CH1
				ld	c,iyh
	CH2_WAVE		ld	b,WAVEFORM01		; 	address of wave table for channel 2
				ld	a,(bc)			;	lookup wave table for channel 3
				add	a,d
				ld	d,a			;	MIX CH1 + CH2
				ld	c,h
	CH3_WAVE		ld	b,WAVEFORM01		; 	address of wave table for channel 3
				ld	a,(bc)			; 	lookup wave table for channel 3
				add	a,d			;	MIX CH1 + CH2 + CH3
				
				or	1			; 	must have in 4 color graphics mode (2 for 16 color mode)
				out	(6),A			;	write to sound port
				
	DURATION_COUNTER	ld	A,DURATION_IRQ_CONST	; 06h -> 1 ms, 55h -> 10 ms
				dec	A
				ld	(DURATION_COUNTER+1),A
				jr	Z,MUSIC_PROCESSOR	; music processor is part of interrupt
				
				exx
				ex	AF,af'
				ei
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------                                                                      
	MUSIC_PROCESSOR		ld	A,DURATION_IRQ_CONST	; reset duration counter (06h -> 1 ms, 55h -> 10 ms)
				ld	(DURATION_COUNTER+1),A
;--------------------------------------------------------------------------------------------------------------------------------------                                                                      
				exx
				ex	AF,af'
				ei				; interrupt is enabled but not finished. running on (the next interrupt) is not a problem
				push	AF			; running in the interrupt -> normal registers are need to be saved
				push	BC
				push	DE
				push	HL
				
; process BPM counter				
	BPM_COUNTER		ld	a,BPM_DIVIDER/BPM
				dec	a
				ld	(BPM_COUNTER+1),A
				jp	NZ,END_INT
				ld	A,BPM_DIVIDER/BPM	; reset BPM divider (IRQfreq/BPM_DIVIDER)/BPM
				ld	(BPM_COUNTER+1),A
				
; parse record							
	MUSICPOS		ld	HL,MUSIC_DATA
				ld	d,$1d			; high address of sound frequency constant lookup table
	MP_CH1			inc	hl
				ld	a,(hl)			; load first byte of music record
; check control codes for channel 1
				cp	LOOP			; first byte can be LOOP control
				jr	nz,MP_SKIP
	MUSIC_RESTART		ld	HL,MUSIC_DATA-1		; reset music data pointer
				ld	(MUSICPOS+1),HL
				jr	MP_CH1			; restart parsing
				
	MP_SKIP			cp	SKIP
				jr	z,MP_CH2		; SKIP -> skip channel 1
				cp	FRQINC00
				jr	c,MP_CH1_NEXT1
				cp	FRQINC0F + 1
				jr	nc,MP_CH1_NEXT1
; INCFREQ0x -> increment frequency
				sub	FRQINC00		; A = freq delta / 16
				rlca
				push	hl
				ld	hl,(PAC1+1)
				ld	b,0
				ld	c,a
				add	hl,bc
				ld	(PAC1+1),hl
				pop	hl
				jr	MP_CH2
	MP_CH1_NEXT1		cp	FRQDEC00
				jr	c,MP_CH1_NEXT2
				cp	FRQDEC0F + 1
				jr	nc,MP_CH1_NEXT2
; DECFREQ0x -> decrement frequency
				sub	FRQDEC00		; A = freq delta / 16
				rlca
				push	hl
				ld	hl,(PAC1+1)
				ld	b,0
				ld	c,a
				or	a			; clear CY
				sbc	hl,bc
				ld	(PAC1+1),hl
				pop	hl
				jr	MP_CH2
	MP_CH1_NEXT2		cp	WAVE01			; handle waveform control codes
				jr	nz,MP_CH1_NEXT21
				ld	a,WAVEFORM01
				ld	(CH1_WAVE+1),a
				jr	MP_CH1
	MP_CH1_NEXT21		cp	WAVE02
				jr	nz,MP_CH1_NEXT22
				ld	a,WAVEFORM02
				ld	(CH1_WAVE+1),a
				jr	MP_CH1
	MP_CH1_NEXT22		cp	WAVE03
				jr	nz,MP_CH1_NEXT23
				ld	a,WAVEFORM03
				ld	(CH1_WAVE+1),a
				jr	MP_CH1
	MP_CH1_NEXT23		cp	WAVE04
				jr	nz,MP_CH1_NEXT24
				ld	a,WAVEFORM04
				ld	(CH1_WAVE+1),a
				jr	MP_CH1
	MP_CH1_NEXT24		cp	ADSR00			; ADSR commands are not processed
				jr	nc,MP_CH1
; handle normal musical note on CH1
	MP_CH1_NEXT3		ld	e,a
				sla	e			; low address of sound frequency constant lookup table = control code * 2
				ld	a,(de)			; load frequ constant for CH1
				inc	de
				ld	c,a
				ld	a,(de)
				ld	b,a
				ld	(PAC1+1),BC		; put into CH1 freq constant in irq handler    
				
	MP_CH2			inc	hl
				ld	a,(hl)
; check control codes for channel 2
				cp	SKIP
				jr	z,MP_CH3		; SKIP -> skip channel 2
				cp	FRQINC00
				jr	c,MP_CH2_NEXT1
				cp	FRQINC0F + 1
				jr	nc,MP_CH2_NEXT1
; INCFREQ0x -> increment frequency
				sub	FRQINC00		; A = freq delta / 16
				rlca
				push	hl
				ld	hl,(PAC2+1)
				ld	b,0
				ld	c,a
				add	hl,bc
				ld	(PAC2+1),hl
				pop	hl
				jr	MP_CH3
	MP_CH2_NEXT1		cp	FRQDEC00
				jr	c,MP_CH2_NEXT2
				cp	FRQDEC0F + 1
				jr	nc,MP_CH2_NEXT2
; DECFREQ0x -> decrement frequency
				sub	FRQDEC00		; A = freq delta / 16
				rlca
				push	hl
				ld	hl,(PAC2+1)
				ld	b,0
				ld	c,a
				or	a			; clear CY
				sbc	hl,bc
				ld	(PAC2+1),hl
				pop	hl
				jr	MP_CH3
	MP_CH2_NEXT2		cp	WAVE01			; handle waveform control codes
				jr	nz,MP_CH2_NEXT21
				ld	a,WAVEFORM01
				ld	(CH2_WAVE+1),a
				jr	MP_CH2
	MP_CH2_NEXT21		cp	WAVE02
				jr	nz,MP_CH2_NEXT22
				ld	a,WAVEFORM02
				ld	(CH2_WAVE+1),a
				jr	MP_CH2
	MP_CH2_NEXT22		cp	WAVE03
				jr	nz,MP_CH2_NEXT23
				ld	a,WAVEFORM03
				ld	(CH2_WAVE+1),a
				jr	MP_CH2
	MP_CH2_NEXT23		cp	WAVE04
				jr	nz,MP_CH2_NEXT24
				ld	a,WAVEFORM04
				ld	(CH2_WAVE+1),a
				jr	MP_CH2
	MP_CH2_NEXT24		cp	ADSR00			; ADSR commands are not processed
				jr	nc,MP_CH2
; handle normal musical note on CH2
	MP_CH2_NEXT3		ld	e,a
				sla	e			; low address of sound frequency constant lookup table
				ld	a,(de)			; load frequ constant for CH2
				inc	de
				ld	c,a
				ld	a,(de)
				ld	b,a
				ld	(PAC2+1),BC		; put into CH2 freq constant in irq handler     
				
	MP_CH3			inc	hl
				ld	a,(hl)
; check control codes for channel 3
				cp	SKIP
				jr	z,MP_END		; SKIP -> skip channel 3
				cp	FRQINC00
				jr	c,MP_CH3_NEXT1
				cp	FRQINC0F + 1
				jr	nc,MP_CH3_NEXT1
; INCFREQ0x -> increment frequency
				sub	FRQINC00		; A = freq delta / 16
				rlca
				push	hl
				ld	hl,(PAC3+1)
				ld	b,0
				ld	c,a
				add	hl,bc
				ld	(PAC3+1),hl
				pop	hl
				jr	MP_END
	MP_CH3_NEXT1		cp	FRQDEC00
				jr	c,MP_CH3_NEXT2
				cp	FRQDEC0F + 1
				jr	nc,MP_CH3_NEXT2
; DECFREQ0x -> decrement frequency
				sub	FRQDEC00		; A = freq delta / 16
				rlca
				push	hl
				ld	hl,(PAC3+1)
				ld	b,0
				ld	c,a
				or	a			; clear CY
				sbc	hl,bc
				ld	(PAC3+1),hl
				pop	hl
				jr	MP_END
	MP_CH3_NEXT2		cp	WAVE01			; handle waveform control codes
				jr	nz,MP_CH3_NEXT21
				ld	a,WAVEFORM01
				ld	(CH3_WAVE+1),a
				jr	MP_CH3
	MP_CH3_NEXT21		cp	WAVE02
				jr	nz,MP_CH3_NEXT22
				ld	a,WAVEFORM02
				ld	(CH3_WAVE+1),a
				jr	MP_CH3
	MP_CH3_NEXT22		cp	WAVE03
				jr	nz,MP_CH3_NEXT23
				ld	a,WAVEFORM03
				ld	(CH3_WAVE+1),a
				jr	MP_CH3
	MP_CH3_NEXT23		cp	WAVE04
				jr	nz,MP_CH3_NEXT24
				ld	a,WAVEFORM04
				ld	(CH3_WAVE+1),a
				jr	MP_CH3
	MP_CH3_NEXT24		cp	ADSR00			; ADSR commands are not processed
				jr	nc,MP_CH3
; handle normal musical note on CH3
	MP_CH3_NEXT3		ld	e,a
				sla	e			; low address of sound frequency constant lookup table
				ld	a,(de)			; load frequ constant for CH3
				inc	de
				ld	c,a
				ld	a,(de)
				ld	b,a
				ld	(PAC3+1),BC		; put into CH3 freq constant in irq handler    				
				
	MP_END			ld	(MUSICPOS+1),HL
	END_INT			pop	HL
				pop	DE
				pop	BC
				pop	AF
				ret
				
;******************************************************************
; INIT MUSIC MIXER INTERRUPT HANDLER
;******************************************************************
	IT_HANDLER_1		db	00h
	IT_HANDLER_2		dw	0000h
				
	START_MUSIC_MIXER	ld	A,BPM_DIVIDER/BPM
				ld	(BPM_COUNTER+1),A
				ld	A,DURATION_IRQ_CONST
				ld	(DURATION_COUNTER+1),A
				ld	HL,MUSIC_DATA-1		; -1 is needed because parsing is started with inc hl
				ld	(MUSICPOS+1),HL
				ld	(MUSIC_RESTART+1),HL
				ld	A,10			; disable CRTC CURSOR IT
				out	(112),A
				ld	A,35
				out	(113),A
				ld	A,$E9			; Sound IT counter divider LO
				out	(4),A			; (4096 - 23 = 4073 = $0FE9)
				ld	A,32+$0F		; Sound IT enabled, sound is OFF + divider HI
				out	(5),A			; IT frequency = Fsys / 16 / 23 = ~ 8491,847826 Hz
				ld	A,(0038h)		; SAVE IT HANDLER
				ld	(IT_HANDLER_1),A
				ld	HL,(0039h)
				ld	(IT_HANDLER_2),HL
				ld	A,0C3h			; @038h -> JP Address_of_IT_HANDLER
				ld	(0038h),A
				ld	HL,IT_HANDLER
				ld	(0039H),HL
				ei				; enable interrupt
				ret
				
;******************************************************************
; RESTORE INTERRUPT HANDLER
;******************************************************************
	STOP_MUSIC_MIXER	di
				ld	A,10			; restore the original interrupt
				out	(112),A
				ld	A,3
				out	(113),A			; CURSOR IT enabled
				xor	A
				out	(4),A
				out	(5),A			; Sound IT disabled, Sound is OFF
				ld	A,(IT_HANDLER_1)	; RESTORE IT HANDLER
				ld	(0038h),A
				ld	HL,(IT_HANDLER_2)
				ld	(0039h),HL
				ei
				ret
				
;******************************************************************
; MAIN PROGRAM
;******************************************************************
; developer could set this constants
				
	BPM			equ	500			; <- set the Beat per Minutes (BPM) HERE
				
	WAVEFORM01		equ	$1e			; address high of square table
	WAVEFORM02		equ	$1f			; address high of triangle table
	WAVEFORM03		equ	$20			; address high of sawtooth table
	WAVEFORM04		equ	$21			; address high of noise table
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   		
	DURATION_IRQ_CONST	equ	6
	BPM_DIVIDER		equ	8491/DURATION_IRQ_CONST*10
				
	MAIN			di				; IT disabled
				exx				; save registers
				push	HL
				push	BC
				push	DE
				exx
				push	IX
				push	IY
				
				call	START_MUSIC_MIXER	; starts SOUND GENERATOR and MUSIC PLAYER INTERRUPT
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   
	RUNLOOP			halt				; wait for next interrupt 0,70656ms
;--------------------------------------------------------------------------------------------------------------------------------------                 				                                  
	KEYBOARD_HANDLER	ld	A,7			; check the ESC button
				out	(3),A			; select 7th row of keyboard matrix
				in	A,(88)			; read keyboard matrix row
				bit	3,A			; check ESC key is pressed                           
				jp	NZ,RUNLOOP
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   
	END_OF_GAME		call	STOP_MUSIC_MIXER	; stops SOUND GENERATOR INTERRUPT
				pop	IY			; restore registers
				pop	IX
				exx
				pop	DE
				pop	BC
				pop	HL
				exx
				ret				; end of game
;--------------------------------------------------------------------------------------------------------------------------------------   
; 175 byte is free from 1c50-1cff				
				org	$1d00
; Freq divider table for musical sounds (address must be divisible by 256)
	SOUND_TABLE		dw	0			; 0.00 Hz
				dw	252			; 32.7 Hz
				dw	267			; 34.65 Hz
				dw	283			; 36.71 Hz
				dw	300			; 38.89 Hz
				dw	318			; 41.2 Hz
				dw	337			; 43.65 Hz
