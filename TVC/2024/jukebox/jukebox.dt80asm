; definition of music data record elements
; musical sounds C1-C8	
				
	C1			equ	1
	CISZ1			equ	2
	D1			equ	3
	DISZ1			equ	4
	E1			equ	5
	F1			equ	6
	FISZ1			equ	7
	G1			equ	8
	GISZ1			equ	9
	A1			equ	10
	AISZ1			equ	11
	B1			equ	12
				
	C2			equ	13
	CISZ2			equ	14
	D2			equ	15
	DISZ2			equ	16
	E2			equ	17
	F2			equ	18
	FISZ2			equ	19
	G2			equ	20
	GISZ2			equ	21
	A2			equ	22
	AISZ2			equ	23
	B2			equ	24
				
	C3			equ	25
	CISZ3			equ	26
	D3			equ	27
	DISZ3			equ	28
	E3			equ	29
	F3			equ	30
	FISZ3			equ	31
	G3			equ	32
	GISZ3			equ	33
	A3			equ	34
	AISZ3			equ	35
	B3			equ	36
				
	C4			equ	37
