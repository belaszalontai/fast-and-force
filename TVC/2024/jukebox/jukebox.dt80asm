;--------------------------------------------------------------------------------------------------------------------------------------                                   			
; Waveform visualization
				
	WAVE_VID_ADDR		ld	hl,$9E1D
				ld	bc,$FFFF-63
				ld	a,(actual_sound_value)	; actual size of waveform
				rrca
				ld	d,a
				ld	e,a			; save to e
				ld	a,$77
	waveform_loop_white	ld	(hl),a			; draw white line
				add	hl,bc
				dec	d
				jp	nz,waveform_loop_white
				ld	d,e
	waveform_loop_black	ld	a,63			; the rest of line is black
				ld	(hl),a
				add	hl,bc
				inc	d
				ld	a,d
				cp	32
				jp	nz,waveform_loop_black
				ld	hl,(WAVE_VID_ADDR+1)
				inc	hl
				ld	(WAVE_VID_ADDR+1),hl
				ld	a,l
				cp	$2B
				ret	nz
				ld	hl,$9E1D
				ld	(WAVE_VID_ADDR+1),hl
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   			
; decompress actual MUSIC DATA RECORDS
				
	DECOMPRESS_MUSIC	di
				ld	A,$B0			; lapozási kód: U0, U1, U2, U3
				out	($02),a			; Belapozás
				ld	a,(current_song)
				cp	1
				jp	nz,DECOMPRESS_02
				ld	HL,MUSIC_DATA_01	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_02		cp	2
				jp	nz,DECOMPRESS_03
				ld	HL,MUSIC_DATA_02	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_03		cp	3
				jp	nz,DECOMPRESS_04
				ld	HL,MUSIC_DATA_03	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_04		cp	4
				jp	nz,DECOMPRESS_05
				ld	HL,MUSIC_DATA_04	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_05		cp	5
				jp	nz,DECOMPRESS_06
				ld	HL,MUSIC_DATA_05	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_06		cp	6
				jp	nz,DECOMPRESS_07
				ld	HL,MUSIC_DATA_06	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_07		cp	7
				jp	nz,DECOMPRESS_08
				ld	HL,MUSIC_DATA_07	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_08		cp	8
				jp	nz,DECOMPRESS_09
				ld	HL,MUSIC_DATA_08	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_09		cp	9
				jp	nz,DECOMPRESS_0A
				ld	HL,MUSIC_DATA_09	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_0A		cp	10
				jp	nz,DECOMPRESS_0B
				ld	HL,MUSIC_DATA_0A	; HL-be a tömörített intro zene memóriacíme
				jp	DECOMPRESS
	DECOMPRESS_0B		ld	HL,MUSIC_DATA_01	; fallback
				
	DECOMPRESS		ld	DE,MUSIC_DATA		; DE-be a célmemória címe
				call	ZX7_DECOMPRESS		; Intro zene kitmörítése
				ld	A,$90			; lapozási kód: U0, U1, VID, U3
				out	($02),a			; Belapozás
				
				ld	hl,0			; reset PLAYER
				ld	(PAC1+1),hl
				ld	(PAC2+1),hl
				ld	(PAC3+1),hl
				ld	A,BPM_DIVIDER/BPM
				ld	(BPM_COUNTER+1),A
				ld	A,DURATION_IRQ_CONST
				ld	(DURATION_COUNTER+1),A
				ld	HL,MUSIC_DATA-1		; -1 is needed because parsing is started with inc hl
				ld	(MUSICPOS+1),HL
				ld	(MUSIC_RESTART+1),HL
				ret
;--------------------------------------------------------------------------------------------------------------------------------------                                   			
				
	INTRO_PICTURE_ZX7	incbin	"jukebox.zx7"		; compressed size: 4993 byte
				
	MUSIC_DATA_01		incbin	"1.zx7"			; compressed size: 1249 byte
	MUSIC_DATA_02		incbin	"2.zx7"			; compressed size: 762 byte
	MUSIC_DATA_03		incbin	"3.zx7"			; compressed size: 4940 byte
	MUSIC_DATA_04		incbin	"4.zx7"			; compressed size: 733 byte
	MUSIC_DATA_05		incbin	"5.zx7"			; compressed size: 2980 byte
	MUSIC_DATA_06		incbin	"6.zx7"			; compressed size: 2184 byte
	MUSIC_DATA_07		incbin	"7.zx7"			; compressed size: 6881 byte
	MUSIC_DATA_08		incbin	"8.zx7"			; compressed size: 2956 byte
	MUSIC_DATA_09		incbin	"9.zx7"			; compressed size: 2496 byte
	MUSIC_DATA_0A		incbin	"10.zx7"		; compressed size: 669 byte
				
	MUSIC_DATA		equ	$A500			; ide lesz kitömörítve a zene
				nop
				
				end