; Version 2026-05-02 17:55
;				
; MEMORY MAP				
; MUSIC_BY_TEXT		equ	$0100
; tunel_dist_row		equ	$0100	; for TUNNEL
; tunel_angle_row		equ	$0200	; for TUNNEL
; siny			equ	$0100		; for ROTOZOOM
; MUSIC_BY_TEXT		equ	$0100		; decompressed by ZX7 to $0100
; FEATURES_TEXT		equ	$0100		; decompressed by ZX7 to $0100
; sinx			equ	$0200		; for ROTOZOOM
; redefined characters	equ	$0740		; Á and É is redefined
; CH_DATA:		equ	$0754		; used by SAA player (rom character redefine table Í)
; SONG_DATA		equ	$C000
; CHAR_SET		equ	$F0FF-$FFFF	; for rendering special characters
				
				;{BASIC Header
				org	6639			; TVC programok kezdőcíme
				db	$0F,$0A,$0,$DD		; "10 PRINT" - basic token
				db	' USR'			; " USR"
				db	$96			; "("
				db	'6659'			; "6659"
				db	$95,$FF			; ")"                         
				db	0,0,0,0,0		; így 20 byte a BASIC header, a kód pedig 6659-nél ($1A03) kezdődik
                                ;}
				
				jp	MAIN
				
; ===========================================================================
; --- Hardware Definitions ---
	SAA_ADDR_PORT		equ	$23
	SAA_DATA_PORT		equ	$22
				
; --- Variables ---
	VAR_GLOBAL_SPEED:	db	6
	VAR_CUR_TICK:		db	1
	VAR_POS_ROWS_LEFT:	db	1			; Force reload on first frame
	VAR_POS_PTR:		dw	0			; Pointer to current Position Block
	VAR_PATS_PTR:		dw	0			; Pointer to Pattern Pointer List
	VAR_MUSIC_BASE:		dw	0
	VAR_SAA_OCTAVES:	ds	3			; Shadow for Reg $10, $11, $12
	VAR_SAA_FREQ_EN:	db	0			; Shadow for Reg $14
	VAR_SAA_NOISE_EN:	db	0			; Shadow for Noise Enable bits
	VAR_SAA_NOISE_FREQ:	db	0			; Shadow for Reg $16 (Noise Freq Control)
	VAR_CH_IDX:		db	0			; Current channel index for ProcessSample
	VAR_EG0_SHAPE:		db	0			; Saved EG0 ($18) shape
	VAR_EG1_SHAPE:		db	0			; Saved EG1 ($19) shape
	VAR_TEMP_NOTE:		db	0			; Previous note for Glissando init
				
; ===========================================================================
; Channel Structure Definition
; ===========================================================================
	SONG_DATA		equ	$C000
				
	CH_STRUCT_SIZE		equ	37
				
; --- Playback Control ---
	O_PTR_L			equ	0			; Current Pattern Data Pointer L
	O_PTR_H			equ	1			; Current Pattern Data Pointer H
	O_WAIT			equ	2			; Rows to wait
	O_NOTE			equ	3			; Current Note Index (1-96)
				
; --- Instrument Status ---
	O_SAMP_NUM		equ	4			; Current Sample ID
	O_ORN_NUM		equ	5			; Current Ornament ID
	O_VOL_L			equ	6			; Current Calculated Volume Left (0-15)
	O_VOL_R			equ	7			; Current Calculated Volume Right (0-15)
				
; --- Commands & Data ---
	O_CMD			equ	8			; Current Command ID
	O_CMD_DAT		equ	9			; Command Data (8-bit standard)
	O_CMD_DAT16		equ	10			; Command Data (16-bit for Break/Slide) - LOW BYTE
	O_CMD_DAT16_H		equ	11			; Command Data (16-bit) - HIGH BYTE
				
; --- Sample & Ornament Engine Pointers ---
	O_SAMP_PTR_L		equ	12			; Pointer to Sample Data L
	O_SAMP_PTR_H		equ	13			; Pointer to Sample Data H
	O_ORN_PTR_L		equ	14			; Pointer to Ornament Data L
	O_ORN_PTR_H		equ	15			; Pointer to Ornament Data H
				
; --- Engine Counters ---
	O_RELEASED		equ	16			; Released flag (1 = in release phase)
	O_CMD_PHASE		equ	17			; Portamento/Glissando phase counter
				
; --- Frequency Modifications ---
	O_POS_TRANSPOSE		equ	18			; Base Transpose from Position List (Signed Byte)
	O_FREQ_OFFSET_L		equ	19			; Fine frequency offset (Vibrato/Slide) L
	O_FREQ_OFFSET_H		equ	20			; Fine frequency offset (Vibrato/Slide) H
				
; --- Flags & Internal ---
	O_FLAGS			equ	21			; General flags (bit0=tone enable, bit1=noise enable)
				
; --- Ornament ---
	O_ORN_OFFSET		equ	22
				
	O_SAMP_BASE_L		equ	23			; Base pointer to Sample Data L
	O_SAMP_BASE_H		equ	24			; Base pointer to Sample Data H
	O_ORN_BASE_L		equ	25			; Base pointer to Ornament Data L
	O_ORN_BASE_H		equ	26
				
	O_PAT_VOL_L		equ	27			; Saved Pattern Volume L
	O_PAT_VOL_R		equ	28			; Saved Pattern Volume R
				
	O_ACT_NOTE		equ	29			; Last calculated pitch for decay
	O_NOTE_TRIG		equ	30			; Flag for envelope retrigger
	O_RELEASABLE		equ	31			; Flag: sample has release section ($FF marker)
	O_CMD_SHIFT_L		equ	32			; Fine pitch shift from command (L)
	O_CMD_SHIFT_H		equ	33			; Fine pitch shift from command (H)
	O_GLISS_NOTE		equ	34			; Glissando target note
	O_GLISS_TGT_L		equ	35			; Glissando target word L
	O_GLISS_TGT_H		equ	36			; Glissando target word H
				
	CH_DATA:		equ	$0754			; ds	6 * CH_STRUCT_SIZE AT CHARACTER DEFINE AREA (from character: Í)
				
	MSC_INDEX		db	0
				
				
;******************************************************************
; INTERRUPT HANDLER 
;******************************************************************                                         
	IT_HANDLER		out	(7),A
				push	af
				
				ld	a,(IT_IDX)
				xor	1			; alternate ITs
				ld	(IT_IDX),a
				jp	nz,IT_SND
; NORMAL IT	
	IRQ_PALETTE1:		ld	A,$05			; sötét lila       
				out	($61),A
	IRQ_PALETTE2:		ld	A,$01			; sötét kék  
				out	($62),A
	IRQ_PALETTE3:		ld	A,$55			; fehér       
				out	($63),A
				
				ld	a,14			; NEXT CURSOR POS
				out	(112),a
				ld	a,11
				out	(113),a
				ld	a,15
				out	(112),a
				ld	a,1
				out	(113),a
				pop	af
				ei
				ret
				
; SOUND PLAYER IT
	IRQ_PALETTE4:		
	IT_SND:			ld	A,$51			; kékeszöld       
				out	($61),A
	IRQ_PALETTE5:		ld	A,$01			; sötét kék
				out	($62),A
	IRQ_PALETTE6:		ld	A,$54			; sárga
				out	($63),A
				
				ld	a,1			; restore 4 color mode
				out	(6),A
				
				ld	a,(MUSIC_ENABLE_FLAG)
				or	a
				jp	z,IT_NO_MUSIC
				
				push	bc
				push	de
				push	hl
				push	ix
				
				call	PlayFrame
				
				pop	ix
				pop	hl
				pop	de
				pop	bc
				
	IT_NO_MUSIC:		ld	a,14			; next cursor pos
				out	(112),a
				ld	a,0
				out	(113),a
				ld	a,15
				out	(112),a
				ld	a,1
				out	(113),a
	DRAW_AREA_GR_MODE:	
				ld	a,1
				out	(6),A
				
				pop	af
				ei
				ret
				
	IT_HANDLER_1		db	00H
	IT_HANDLER_2		dw	0000H
	IT_IDX			db	0
	MUSIC_ENABLE_FLAG	db	1
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   					
	MAIN:			ld	C,$01			; C = Graphics 4
				rst	$30			; $30 system call                              
				db	$4			; set VMODE       
				
; init main screen			
				di
				call	SET_CHARACTER
				call	CRTC_DISABLE
				
				ld	A,$90			; lapozási kód: U0, U1, VID, U3
				out	($02),a			; Belapozás				
				
				ld	A,$00			; fekete       
				out	($60),A
				ld	A,$05			; sötét lila       
				out	($61),A
				ld	A,$01			; sötét kék  
				out	($62),A
				ld	A,85			; fehér       
				out	($63),A
				
; draw main picture							
				call	DRAW_JUKEBOX
; COPYRIGHT TEXT
				ld	A,$50			; lapozási kód: U0, U1, U2, SYS
				out	($02),a			; Belapozás
				ld	a,2			; set ink to palette 2
				ld	(2893),a
				ld	bc,$0118		; B = oszlop(1-32): 1, C = sor(1-24): 24
				rst	$30
				db	$23
				ld	a,(TEXT00)
				ld	c,a
				ld	b,0
				ld	de,TEXT00 + 1
				rst	$30
				db	$22
; SAA 1099 TEXT
				ld	a,2			; set ink to palette 2
				ld	(2893),a
				ld	bc,$0113		; B = oszlop(1-32): 1, C = sor(1-24): 19
				rst	$30
				db	$23
				ld	a,(TEXT_1)
				ld	c,a
				ld	b,0
				ld	de,TEXT_1 + 1
				rst	$30
				db	$22
; PLAYING: TEXT
				ld	a,1			; set ink to palette 1
				ld	(2893),a
				ld	bc,$0115		; B = oszlop(1-32): 1, C = sor(1-24): 21
				rst	$30
				db	$23
				ld	a,(TEXT_0)
				ld	c,a
				ld	b,0
				ld	de,TEXT_0 + 1
				rst	$30
				db	$22
				
				ld	A,(0038H)		; SAVE IT HANDLER
				ld	(IT_HANDLER_1),A
				ld	HL,(0039H)
				ld	(IT_HANDLER_2),HL
				ld	A,0C3H			; @038h -> JP Address_of_IT_HANDLER
				ld	(0038H),A
				ld	HL,IT_HANDLER
				ld	(0039H),HL
				
				xor	a
				ld	(MUSIC_ENABLE_FLAG),a
				ei
				
				call	CRTC_ENABLE
				
				ld	a,0			; 0 init music (track 1)
				ld	(MSC_INDEX),a
				call	LOAD_MUSIC
				ld	hl,0
				ld	(DEMO_FRAME_CNT),hl
				ld	(SCENE_START_FRAME),hl
				ld	a,1			; 1 init first scene
				ld	(SCENE_ID),a
				xor	a
				ld	(SCENE_LOCAL_FLAG),a
				
				jp	PlayerLoop
				
;--------------------------------------------------------------------------------------------------------------------------------------	
; 222 byte free area
;--------------------------------------------------------------------------------------------------------------------------------------	
	SC_15_CLS_FLAG		db	0
	SC_15_CLS_FLAG2		db	0
				
	SCENE_15_PH_A:						; RENDER MUSIC BY TEXTS
				ld	a,(SC_15_CLS_FLAG)
				or	a
				ret	nz
				inc	a			; set flag ensures run this only ONCE
				ld	(SC_15_CLS_FLAG),a
				
				call	CLS
				ld	a,$55			; set color of text in all irq
				ld	(IRQ_PALETTE1+1),a
				ld	(IRQ_PALETTE4+1),a
				
				ld	de,MUSIC_BY_TEXT
				ld	hl,$0102		; col=1, row=2
				ld	b,22
				
	char_loop001:		call	HALT_ON_TOP
				push	bc
				push	hl
				push	de
				ld	b,h			; B = col
				ld	c,l			; C = row
				call	RST30DB3		; compute VRAM_POSITION from BC
				pop	de
				push	de
				call	RST30DB2		; write text (stops at db 0 terminator)
				pop	de			; DE = text row start
				ld	hl,33
				add	hl,de			; HL = text_ptr + 33 (next row)
				ex	de,hl			; DE = text_ptr + 33
				pop	hl
				inc	l			; next row
				pop	bc
				djnz	char_loop001
				
				ret
				
	SCENE_15_PH_B:		
				ld	a,(SC_15_CLS_FLAG2)
				or	a
				ret	nz
				inc	a			; set flag ensures run this only ONCE
				ld	(SC_15_CLS_FLAG2),a
				ld	A,$B0			; lapozási kód: U0, U1, U2, U3
				out	($02),a			; Belapozás
				call	INIT_FEATURES
				ld	A,$90			; lapozási kód: U0, U1, VID, U3
				out	($02),a			; Belapozás
				call	CLS
				ret				; placeholder B (frame 800)
				
; LAST SCENE  -> FEATURES			
	SCENE_15_PH_C:		ld	de,FEATURES_TEXT
				ld	hl,$0108		; col=1, row=8
				ld	b,9
				call	char_loop001
				
				ld	b,255
	Feat_Wait:		halt
				halt
				halt
				halt
				djnz	Feat_Wait
				
; FINISH DEMO
				call	CLS
				xor	a			; initial fadeout attenuation = 0
	Fade_Loop:		ld	(FADE_ATT_PATCH+1),a	; patch self-mod operand in MixVolume
				cp	$0F			; max attenuation reached?
				jr	z,Fade_Done		; yes: end demo
				push	af
				ld	b,$07			; 7 frames per step (15 steps = ~105 frames total)
	Fade_Wait:		halt				; 20ms tick (IRQ-based)
				halt
				djnz	Fade_Wait
				pop	af
				inc	a			; next attenuation level
				jr	Fade_Loop
				
	Fade_Done:		di
				ld	e,0			; disable sound and noise on SAA
				ld	a,$14
				call	WriteSAA_Reg
				ld	e,0
				ld	a,$15
				call	WriteSAA_Reg
				
				ld	A,$B0			; lapozási kód: U0, U1, U2, U3
				out	($02),a			; Belapozás
				call	CRTC_DISABLE
; set palette for FAF LOGO
				ld	A,$55			; fehér         
				out	($61),A
				ld	A,$41			; kék  
				out	($62),A
				ld	A,$01			; sötétkék       
				out	($63),A
				
				ld	hl,PIC_TVC40_ZX7
				ld	de,$c000
				ld	bc,723
				ldir
				ld	A,$90			; lapozási kód: U0, U1, VID, U3
				out	($02),a			; Belapozás
				ld	hl,$c000
				ld	de,$8000
				call	ZX7_DECOMPRESS
				call	CRTC_ENABLE
				
; final delay befor end								
				ld	hl,65535
	end_wait		dec	hl
				ld	a,h
				or	l
				jr	nz,end_wait
				call	CLS
				halt				; freeze CPU - DEMO END
				
;--------------------------------------------------------------------------------------------------------------------------------------
; tables aligned to 256 byte DO NOT REMOVE FROm HERE
;--------------------------------------------------------------------------------------------------------------------------------------				
				org	$1C00			; DO NOT MODIFY this ORG
				
	data:			incbin	"smooth_data_gfx16.bin"	; 256 byte, GFX16
	TUNEL_TEX:		incbin	"tunnel_tex.bin"	; 256 byte
	TUNEL_TEX2:		incbin	"tunnel_tex2.bin"	; 256 byte - noisy intro texture
				
	sin:			db	$3f, $40, $42, $43, $45, $46, $48, $49; 256 byte
				db	$4b, $4c, $4e, $4f, $51, $52, $54, $55
				db	$57, $58, $59, $5b, $5c, $5e, $5f, $60
				db	$62, $63, $64, $65, $66, $68, $69, $6a
				db	$6b, $6c, $6d, $6e, $6f, $70, $71, $72
				db	$73, $74, $75, $75, $76, $77, $77, $78
				db	$79, $79, $7a, $7a, $7b, $7b, $7c, $7c
				db	$7c, $7d, $7d, $7d, $7d, $7d, $7d, $7d
				db	$7e, $7d, $7d, $7d, $7d, $7d, $7d, $7d
				db	$7c, $7c, $7c, $7b, $7b, $7a, $7a, $79
				db	$79, $78, $77, $77, $76, $75, $75, $74
				db	$73, $72, $71, $70, $6f, $6e, $6d, $6c
				db	$6b, $6a, $69, $68, $66, $65, $64, $63
				db	$62, $60, $5f, $5e, $5c, $5b, $59, $58
				db	$57, $55, $54, $52, $51, $4f, $4e, $4c
				db	$4b, $49, $48, $46, $45, $43, $42, $40
				db	$3f, $3d, $3b, $3a, $38, $37, $35, $34
				db	$32, $31, $2f, $2e, $2c, $2b, $29, $28
				db	$26, $25, $24, $22, $21, $1f, $1e, $1d
				db	$1b, $1a, $19, $18, $17, $15, $14, $13
				db	$12, $11, $10, $0f, $0e, $0d, $0c, $0b
				db	$0a, $09, $08, $08, $07, $06, $06, $05
				db	$04, $04, $03, $03, $02, $02, $01, $01
				db	$01, $00, $00, $00, $00, $00, $00, $00
				db	$00, $00, $00, $00, $00, $00, $00, $00
				db	$01, $01, $01, $02, $02, $03, $03, $04
				db	$04, $05, $06, $06, $07, $08, $08, $09
				db	$0a, $0b, $0c, $0d, $0e, $0f, $10, $11
				db	$12, $13, $14, $15, $17, $18, $19, $1a
				db	$1b, $1d, $1e, $1f, $21, $22, $24, $25
				db	$26, $28, $29, $2b, $2c, $2e, $2f, $31
				db	$32, $34, $35, $37, $38, $3a, $3b, $3d
				
	; --- Tunnel precomputed lookup tables (32 cols x 32 rows = 1024 bytes each) ---
	; Placed here to guarantee U0 page ($0000-$3FFF) - safe to read during VID paging ($90)
	TUNEL_ANGLE_TABLE:	incbin	"tunnel_angle.bin"	; (1024 bytes)
	TUNEL_DIST_TABLE:	incbin	"tunnel_dist.bin"	; (1024 bytes)					
				
;----------------------------------------------------------------------------------------------------------------				
	CLS			ld	hl,$8000
				ld	bc,$3FFF
				ld	d,0
	cls_loop		ld	(hl),d
				inc	hl
				dec	bc
				ld	a,b
				or	c
				jr	nz,cls_loop
				ret
				
; ===========================================================================
; Main Loop
; ===========================================================================
	SCENE_DUR_01		equ	500			; MUSIC 1 + JUKEBOX + BORDER DRAW + CRTC EFFECT
	SCENE_DUR_02		equ	480			; MUSIC 1 + JUKEBOX + BORDER DRAW
	SCENE_DUR_03		equ	1000			; change to MUSIC 2 (one time action) then -> JUKEBOX + BORDER DRAW
	SCENE_DUR_04		equ	370			; change to MUSIC 3 (one time action) then -> JUKEBOX + BORDER DRAW
	SCENE_DUR_05		equ	1970			; MUSIC 3 + PLASMA EFFECT
	SCENE_DUR_06		equ	330			; MUSIC 3 + JUKEBOX + BORDER DRAW
	SCENE_DUR_07		equ	380			; change to MUSIC 4 + JUKEBOX + BORDER DRAW
	SCENE_DUR_08		equ	1600			; MUSIC 4 + ROTO ZOOM EFFECT
	SCENE_DUR_09		equ	400			; MUSIC 4 + JUKEBOX + BORDER DRAW
	SCENE_DUR_10		equ	760			; change to MUSIC 5 + JUKEBOX + BORDER DRAW
	SCENE_DUR_11		equ	1270			; MUSIC 5 + TUNEL effect
	SCENE_DUR_12		equ	380			; MUSIC 5 + JUKEBOX + BORDER DRAW
	SCENE_DUR_13		equ	640			; change to MUSIC 6 + JUKEBOX + BORDER DRAW
	SCENE_DUR_14		equ	1270			; MUSIC 6 + TEXTURE FLYTHROUGH
	SCENE_DUR_15		equ	5000			; MUSIC 6 + GREETINGS
				
				
	BAND_HEIGHT		equ	152			; draw to border music band height
	LINE_HEIGHT		equ	2			; draw to border line height
	DEMO_FRAME_CNT		dw	0
	SCENE_START_FRAME	dw	0
	SCENE_ID		db	1
	SCENE_LOCAL_FLAG	db	0
				
				
	PlayerLoop:		halt
				ld	a,(IT_IDX)		; wait for non music IT (20ms)
				or	a
				jp	nz,PlayerLoop
				
	; render BORDER		
	BORDER_RENDER_GATE:	nop
				nop
				nop
				call	COUNT_DOWN_WHITE
				
				ld	a,(CH_DATA+0*CH_STRUCT_SIZE+O_VOL_L)
				call	COLOR_BORDER
				ld	b,BAND_HEIGHT
				call	COUNT_DOWN
				call	COUNT_DOWN_WHITE
				
				ld	a,(CH_DATA+1*CH_STRUCT_SIZE+O_VOL_L)
				call	COLOR_BORDER
				ld	b,BAND_HEIGHT
				call	COUNT_DOWN
				call	COUNT_DOWN_WHITE
				
				ld	a,(CH_DATA+2*CH_STRUCT_SIZE+O_VOL_L)
				call	COLOR_BORDER
				ld	b,BAND_HEIGHT
				call	COUNT_DOWN
				call	COUNT_DOWN_WHITE
				
				ld	a,(CH_DATA+3*CH_STRUCT_SIZE+O_VOL_L)
				call	COLOR_BORDER
				ld	b,BAND_HEIGHT
				call	COUNT_DOWN
				call	COUNT_DOWN_WHITE
				
				ld	a,(CH_DATA+4*CH_STRUCT_SIZE+O_VOL_L)
				call	COLOR_BORDER
				ld	b,BAND_HEIGHT
				call	COUNT_DOWN
				call	COUNT_DOWN_WHITE
				
				ld	a,(CH_DATA+5*CH_STRUCT_SIZE+O_VOL_L)
				call	COLOR_BORDER
				ld	b,BAND_HEIGHT
				call	COUNT_DOWN
				call	COUNT_DOWN_WHITE
				
				xor	a
				out	($0),a
	; end of render BORDER			
	BORDER_SKIP:		
				call	SCENE_DISPATCH
				call	DEMO_FRAME_TICK
				jp	PlayerLoop
				
; Scene scheduler and scene handlers
	DEMO_FRAME_TICK:	ld	hl,(DEMO_FRAME_CNT)
				inc	hl
				ld	(DEMO_FRAME_CNT),hl
				ret
				
	SCENE_DISPATCH:		ld	a,(SCENE_ID)
				cp	1
				jp	z,SCENE_01
				cp	2
				jp	z,SCENE_02
				cp	3
				jp	z,SCENE_03
				cp	4
				jp	z,SCENE_04
				cp	5
				jp	z,SCENE_05
				cp	6
				jp	z,SCENE_06
				cp	7
				jp	z,SCENE_07
				cp	8
				jp	z,SCENE_08
				cp	9
				jp	z,SCENE_09
				cp	10
				jp	z,SCENE_10
				cp	11
				jp	z,SCENE_11
				cp	12
				jp	z,SCENE_12
				cp	13
				jp	z,SCENE_13
				cp	14
				jp	z,SCENE_14
				cp	15
				jp	z,SCENE_15
				ret
				
	SCENE_01:		ld	hl,(sine_speed)
				dec	hl
				dec	hl
				dec	hl
				ld	(sine_speed),hl
				ld	a,h
				or	a
				jr	nz,SCENE_01_RENDER
				ld	a,l
				cp	$ca
				jr	nc,SCENE_01_RENDER
				jp	SCENE_01_NO_RENDER
	SCENE_01_RENDER:	call	CRTC_HORIZONTAL_EFFECT
	SCENE_01_NO_RENDER:	call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_01
				or	a
				sbc	hl,de
				ret	c
				ld	a,2
				call	SCENE_SET
				ret
				
	SCENE_02:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_02
				or	a
				sbc	hl,de
				ret	c
				ld	a,3
				call	SCENE_SET
				ret
				
	SCENE_03:		ld	a,(SCENE_LOCAL_FLAG)
				or	a
				jp	nz,SCENE_03_WAIT
				call	MUSIC_NEXT
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
	SCENE_03_WAIT:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_03
				or	a
				sbc	hl,de
				ret	c
				ld	a,4
				call	SCENE_SET
				ret
				
	SCENE_04:		ld	a,(SCENE_LOCAL_FLAG)
				or	a
				jp	nz,SCENE_04_WAIT
				call	MUSIC_NEXT
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
	SCENE_04_WAIT:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_04
				or	a
				sbc	hl,de
				ret	c
				ld	a,5
				call	SCENE_SET
				call	CLEAR_JUKEBOX
				call	CLEARFAF		; delete Copyright
				call	SET_PLASMA_PALETTE
				ld	a,2			; Graphics 16 for plasma draw area
				ld	(DRAW_AREA_GR_MODE+1),a
				;xor	a
				;ld	(IRQ_PALETTE5+1),a
				halt
				;halt
				ret
				
	SCENE_05:		call	GET_SCENE_ELAPSED	; HL = elapsed frames in SCENE_05
				ld	a,(SCENE_LOCAL_FLAG)
				cp	1
				jp	nc,SCENE_05_CHK_S2
				
				; --- Stage 0->1: zoom starts at frame 340 ---
				ld	de,340
				or	a
				sbc	hl,de			; CF=1 if elapsed < 340
				jp	c,SCENE_05_RENDER	; < 340: no zoom, just render
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
				jp	SCENE_05_ZOOM
				
	SCENE_05_CHK_S2:	cp	2
				jp	nc,SCENE_05_CHK_S3
				
				; --- Stage 1->2: medium boil at frame 680 ---
				ld	de,940
				or	a
				sbc	hl,de
				jp	c,SCENE_05_ZOOM		; < 680: just zoom
				ld	a,2
				ld	(boil_shift),a
				ld	a,5
				ld	(boil_speed_x),a
				ld	a,4
				ld	(amplitudex+1),a
				ld	a,2
				ld	(SCENE_LOCAL_FLAG),a
				
				ld	a,$44			; VÖRÖS
				ld	(IRQ_PALETTE1+1),a
				ld	a,$14			; SÁRGA
				ld	(IRQ_PALETTE2+1),a
				ld	a,$54			; SÖTÉT SÁRGA
				ld	(IRQ_PALETTE3+1),a
				
				jp	SCENE_05_ZOOM
				
	SCENE_05_CHK_S3:	cp	3
				jp	nc,SCENE_05_ZOOM
				
				; --- Stage 2->3: intense boil+zoom at frame 1430 ---
				ld	de,1430
				or	a
				sbc	hl,de
				jp	c,SCENE_05_ZOOM		; < 1020: just zoom
				ld	a,1
				ld	(boil_shift),a
				;ld	a,10			; 5
				;ld	(boil_speed_x),a
				;ld	a,6			; 4
				;ld	(boil_speed_y),a
				ld	a,4
				ld	(amplitudey+1),a
				ld	a,2
				ld	(zoom_osc_speed_x),a
				ld	(zoom_osc_speed),a
				ld	a,3
				ld	(SCENE_LOCAL_FLAG),a
				
				ld	a,$55			; FEHÉR
				ld	(IRQ_PALETTE1+1),a
				ld	a,$44			; VÖRÖS
				ld	(IRQ_PALETTE2+1),a
				ld	a,$54			; SÁRGA
				ld	(IRQ_PALETTE3+1),a
				
	SCENE_05_ZOOM:						; --- Sinusoidal zoom animation: base_zoom = sin[phase]*14 + 280 ---
				; Range: ~280 (zoomed in) to ~1944 (zoomed out)
				ld	a,(zoom_mod_phase)
				inc	a
				ld	(zoom_mod_phase),a
				ld	l,a
				ld	h,sin / 256		; raw sin[phase], range 0-126
				ld	a,(hl)
				ld	l,a
				ld	h,0			; HL = sin (x1)
				add	hl,hl			; HL = x2
				ld	b,h
				ld	c,l			; BC = x2
				add	hl,hl			; HL = x4
				ld	d,h
				ld	e,l			; DE = x4
				add	hl,hl			; HL = x8
				add	hl,de			; HL = x8+x4 = x12
				add	hl,bc			; HL = x12+x2 = x14
				add	hl,bc			; HL = x12+x2 = x14
				add	hl,bc
				add	hl,bc
				ld	de,INIT_BASE_ZOOM
				add	hl,de			; HL = sin*14 + INIT_BASE_ZOOM
				ld	(base_zoom),hl
				
				ld	a,(camy)
				inc	a
				ld	(camy),a
				ld	a,(camx)
				inc	a
				inc	a
				ld	(camx),a
				
	SCENE_05_RENDER:	call	Calculate		; calculate and render plasma
				ld	a,(shift)
				inc	a
				and	$3
				ld	(shift),a
				call	Plasma
				
				call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_05
				or	a
				sbc	hl,de
				ret	c
				ld	a,6
				call	SCENE_SET
				call	SET_JUKEBOX_PALETTE
				ld	a,1			; Graphics 4 for jukebox redraw
				ld	(DRAW_AREA_GR_MODE+1),a
				halt
				;halt
				call	DRAW_JUKEBOX		; redraw jukebox
				ret
				
	SCENE_06:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_06
				or	a
				sbc	hl,de
				ret	c
				ld	a,7
				call	SCENE_SET
				ret
				
	SCENE_07:		ld	a,(SCENE_LOCAL_FLAG)
				or	a
				jp	nz,SCENE_07_WAIT
				call	MUSIC_NEXT
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
	SCENE_07_WAIT:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_07
				or	a
				sbc	hl,de
				ret	c
				ld	a,8
				call	SCENE_SET
				call	CLEAR_JUKEBOX
				call	SET_ROTOZOOM_PALETTE
				ld	a,2			; Graphics 16 for rotozoom draw area
				ld	(DRAW_AREA_GR_MODE+1),a
				halt
				ret
				
	SCENE_08:		call	GET_SCENE_ELAPSED	; HL = elapsed frames in SCENE_08
				ld	a,(SCENE_LOCAL_FLAG)
				cp	1
				jp	nc,SCENE_08_REVERSE
				ld	de,940			; 940 frames: keep current forward rotation
				or	a
				sbc	hl,de
				jp	c,SCENE_08_FORWARD
				ld	a,$ff			; reverse rotation, speed = 1
				ld	(rtz_angle_speed),a
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
				ld	a,$14			; DARK YELLOW
				ld	(IRQ_PALETTE2+1),a
				
				jp	SCENE_08_REVERSE
	SCENE_08_FORWARD:	ld	a,2			; forward rotation, speed = 2
				ld	(rtz_angle_speed),a
	SCENE_08_REVERSE:	call	RTZ_Calculate
				ld	a,(shift)
				inc	a
				and	$03
				ld	(shift),a
				call	Plasma
				call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_08
				or	a
				sbc	hl,de
				ret	c
				ld	a,9
				call	SCENE_SET
				call	SET_JUKEBOX_PALETTE
				ld	a,1			; Graphics 4 from this point onward
				ld	(DRAW_AREA_GR_MODE+1),a
				halt
				call	DRAW_JUKEBOX
				ret
				
	SCENE_09:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_09
				or	a
				sbc	hl,de
				ret	c
				ld	a,10
				call	SCENE_SET
				ret
				
	SCENE_10:		ld	a,(SCENE_LOCAL_FLAG)
				or	a
				jp	nz,SCENE_10_WAIT
				call	MUSIC_NEXT
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
	SCENE_10_WAIT:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_10
				or	a
				sbc	hl,de
				ret	c
				ld	a,11
				call	SCENE_SET
				call	CLEAR_JUKEBOX
				call	SET_TUNEL_PALETTE
				halt
				ret
				
	SCENE_11:		call	GET_SCENE_ELAPSED	; HL = elapsed frames in SCENE_11
				ld	a,(SCENE_LOCAL_FLAG)
				cp	2
				jp	nc,SCENE_11_RENDER	; FLAG >= 2: all phases done
				cp	1
				jp	nz,.s11_phase0		; FLAG == 0: first phase check
				; --- FLAG == 1: wait TUNEL_CENTER_HOLD_FRAMES + 390 then speedup ---
				ld	de,TUNEL_CENTER_HOLD_FRAMES+390
				or	a
				sbc	hl,de
				jp	c,SCENE_11_RENDER
				ld	a,$3C
				ld	(TUNEL_SPEEDUP),a	; self-modify: enable speedup
				ld	a,$04			; DARK RED
				ld	(IRQ_PALETTE1+1),a
				ld	a,2
				ld	(SCENE_LOCAL_FLAG),a
				jp	SCENE_11_RENDER
	.s11_phase0:						; --- FLAG == 0: wait TUNEL_CENTER_HOLD_FRAMES then set center phases ---
				ld	de,TUNEL_CENTER_HOLD_FRAMES
				or	a
				sbc	hl,de
				jp	c,SCENE_11_RENDER
				ld	a,TUNEL_CENTER_X_START_PHASE
				ld	(tunel_center_phase_x),a
				ld	a,TUNEL_CENTER_Y_START_PHASE
				ld	(tunel_center_phase_y),a
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
	SCENE_11_RENDER:					; --- select texture based on elapsed frames ---
				call	GET_SCENE_ELAPSED	; HL = elapsed frames
				ld	de,TUNEL_TEX_SWITCH_FRAME
				or	a
				sbc	hl,de
				jp	nc,.tunel_main_tex	; elapsed >= 340: use main TUNEL_TEX
				ld	a,TUNEL_TEX2/256
				jp	.tunel_tex_set
	.tunel_main_tex:	
				ld	a,$14			; DARK YELLOW
				ld	(IRQ_PALETTE2+1),a
				ld	a,TUNEL_TEX/256
				
	.tunel_tex_set:		ld	(TUNEL_COL_TEXPAGE+1),a	; patch texture page
				call	TUNEL_Calculate
				call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_11
				or	a
				sbc	hl,de
				ret	c
				ld	a,12
				call	SCENE_SET
				call	SET_JUKEBOX_PALETTE
				halt
				call	DRAW_JUKEBOX
				ret
				
	SCENE_12:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_12
				or	a
				sbc	hl,de
				ret	c
				ld	a,13
				call	SCENE_SET
				ret
				
	SCENE_13:		ld	a,(SCENE_LOCAL_FLAG)
				or	a
				jp	nz,SCENE_13_WAIT
				call	MUSIC_NEXT
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
	SCENE_13_WAIT:		call	GET_SCENE_ELAPSED
				ld	de,SCENE_DUR_13
				or	a
				sbc	hl,de
				ret	c
				ld	a,14
				call	SCENE_SET
				call	CLEAR_JUKEBOX
				ret
				
	SCENE_14:		ld	a,(SCENE_LOCAL_FLAG)
				or	a
				jp	nz,SCENE_14_RENDER
				call	SET_TEX4K_PALETTE
				ld	a,2
				ld	(TEX4K_STRIDE+1),a	; reset stride to 2 on scene init
				ld	a,$CB			; restore srl a opcode byte 1
				ld	(TEX4K_U_SRL),a
				ld	a,$3F			; restore srl a opcode byte 2
				ld	(TEX4K_U_SRL+1),a
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
	SCENE_14_RENDER:	call	GET_SCENE_ELAPSED	; HL = elapsed frames
				push	hl			; save for scene-end check
				ld	a,(SCENE_LOCAL_FLAG)
				cp	2
				jp	z,.scene14_render	; FLAG=2: zoom already active
				ld	de,640
				or	a
				sbc	hl,de
				jp	c,.scene14_render	; < 640 frames: no zoom yet
				ld	a,1
				ld	(TEX4K_STRIDE+1),a	; stride=1 (2x zoom)
				xor	a			; NOP opcode = $00
				ld	(TEX4K_U_SRL),a		; patch srl a -> nop byte 1
				ld	(TEX4K_U_SRL+1),a	; patch srl a -> nop byte 2
				ld	a,2
				ld	(SCENE_LOCAL_FLAG),a	; zoom switch done, skip next frames
	.scene14_render:	call	Tex4K_Calculate
				pop	hl			; restore elapsed
				ld	de,SCENE_DUR_14
				or	a
				sbc	hl,de
				ret	c
				ld	a,15
				call	SCENE_SET
				ret
				
	SCENE_15:		ld	a,(SCENE_LOCAL_FLAG)
				or	a
				jp	nz,SCENE_15_WAIT
				call	SET_TUNEL_PALETTE
				ld	a,$90			; U0, U1, VID, U3 - VID accessible at $8000
				out	($02),a
				ld	hl,PIC_GREETINGS_ZX7	; source: compressed picture data
				ld	de,$8000		; dest: video RAM
				call	ZX7_DECOMPRESS
				call	RENDER_GREETINGS
				ld	a,1
				ld	(SCENE_LOCAL_FLAG),a
	SCENE_15_WAIT:		call	GET_SCENE_ELAPSED	; HL = elapsed frames
				ld	a,(SCENE_LOCAL_FLAG)
				cp	4
				jp	z,SCENE_15_END_CHECK	; FLAG=4: idle, wait for scene end
				cp	3
				jp	z,SCENE_15_FLAG3	; FLAG=3: wait for 1200 frames
				cp	2
				jp	z,SCENE_15_FLAG2	; FLAG=2: wait for 800 frames
				; FLAG=1: wait for 400 frames
				ld	de,600
				push	hl
				or	a
				sbc	hl,de
				pop	hl
				jp	c,SCENE_15_END_CHECK
				call	SCENE_15_PH_A
				ld	a,2
				ld	(SCENE_LOCAL_FLAG),a
				ret
	SCENE_15_FLAG2:		ld	de,2000
				push	hl
				or	a
				sbc	hl,de
				pop	hl
				jp	c,SCENE_15_END_CHECK
				call	SCENE_15_PH_B
				ld	a,3
				ld	(SCENE_LOCAL_FLAG),a
				ret
	SCENE_15_FLAG3:		ld	de,1400
				push	hl
				or	a
				sbc	hl,de
				pop	hl
				jp	c,SCENE_15_END_CHECK
				call	SCENE_15_PH_C
				ld	a,4
				ld	(SCENE_LOCAL_FLAG),a
				ret
	SCENE_15_END_CHECK:	ld	de,SCENE_DUR_15
				or	a
				sbc	hl,de
				ret	c
				ld	a,3
				call	SCENE_SET
				ret
				
	SCENE_SET:		ld	(SCENE_ID),a
				cp	5			; scene 5 = no border
				jp	z,SCENE_SET_NO_BORDER
				cp	8			; scene 8 = no border
				jp	z,SCENE_SET_NO_BORDER
				cp	11			; scene 11 = no border
				jp	z,SCENE_SET_NO_BORDER
				cp	14			; scene 14 = no border
				jp	z,SCENE_SET_NO_BORDER
				call	BORDER_GATE_ENABLE
				jp	SCENE_SET_CONTINUE
	SCENE_SET_NO_BORDER:	call	BORDER_GATE_DISABLE
	SCENE_SET_CONTINUE:	ld	hl,(DEMO_FRAME_CNT)
				ld	(SCENE_START_FRAME),hl
				xor	a
				ld	(SCENE_LOCAL_FLAG),a
				ret
				
	BORDER_GATE_ENABLE:	xor	a
				ld	(BORDER_RENDER_GATE),a
				ld	(BORDER_RENDER_GATE+1),a
				ld	(BORDER_RENDER_GATE+2),a
				ret
				
	BORDER_GATE_DISABLE:	ld	a,$c3			; JP opcode
				ld	(BORDER_RENDER_GATE),a
				ld	hl,BORDER_SKIP
				ld	(BORDER_RENDER_GATE+1),hl
				ret
				
	GET_SCENE_ELAPSED:	ld	hl,(DEMO_FRAME_CNT)
				ld	de,(SCENE_START_FRAME)
				or	a
				sbc	hl,de
				ret
				
	MUSIC_NEXT:		ld	a,(MSC_INDEX)
				inc	a
				cp	NUM_OF_MUSIC
				jp	c,MUSIC_NEXT_SAVE
				xor	a
	MUSIC_NEXT_SAVE:	ld	(MSC_INDEX),a
				call	LOAD_MUSIC
				ret
				
				
				
	SCENE06_EFFECT_PLACEHOLDER:	
				ret
				
;----------------------------------------------------------------------------------------------------------------------------------------
; DRAW AND CLEAR JUKEBOX AREA
;----------------------------------------------------------------------------------------------------------------------------------------				
	DRAW_JUKEBOX:		
				ld	HL,PIC_MAIN_ZX7		; HL-be a tömörített kezdőképernyő memóriacíme                                                                
				ld	DE,$8000		; DE-be a célmemória címe
				call	ZX7_DECOMPRESS		; Kép kitömörítése
				ret
				
	CLEAR_JUKEBOX:		
				ld	a,$90			; lapozási kód: U0, U1, VID, U3;
				out	($02),a			; Belapozás				
				ld	hl,$8000		; from video ram
				ld	bc,$2D00
	clr_loop:		xor	a
				ld	(hl),a
				inc	hl
				dec	bc
				ld	a,b
				or	c
				jp	nz,clr_loop
				ret
				
	CLEARFAF:		ld	hl,$8000		; from video ram
				ld	de,$B980 - 3200
				ld	bc,640
				ldir
				ld	de,$B980
				ld	bc,640
				ldir
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
; PLASMA EFFECT
;--------------------------------------------------------------------------------------------------------------------------------------
	SET_PLASMA_PALETTE:	
				ld	a,$45			; LILA
				ld	(IRQ_PALETTE1+1),a
				ld	a,$41			; KÉK
				ld	(IRQ_PALETTE2+1),a
				ld	a,$55			; FEHÉR
				ld	(IRQ_PALETTE3+1),a
				ret
				
	SET_JUKEBOX_PALETTE:	
				ld	a,$05			; SÖTÉT LILA
				ld	(IRQ_PALETTE1+1),a
				ld	a,$01			; SÖTÉT KÉK
				ld	(IRQ_PALETTE2+1),a
				ld	a,$55			; FEHÉR
				ld	(IRQ_PALETTE3+1),a
				ret
				
	SET_ROTOZOOM_PALETTE:	
				ld	a,$11			; DARK CYAN
				ld	(IRQ_PALETTE1+1),a
				ld	a,$15			; GREY
				ld	(IRQ_PALETTE2+1),a
				ld	a,$55			; WHITE
				ld	(IRQ_PALETTE3+1),a
				ret
				
	SET_TUNEL_PALETTE:	
				ld	a,$41			; BLUE
				ld	(IRQ_PALETTE1+1),a
				ld	a,$11			; DARK CYAN
				ld	(IRQ_PALETTE2+1),a
				ld	a,$55			; WHITE
				ld	(IRQ_PALETTE3+1),a
				ret
				
	SET_TEX4K_PALETTE:	
				ld	a,$14			; DARK YELLOW
				ld	(IRQ_PALETTE2+1),a
				ld	a,$04			; DARK RED
				ld	(IRQ_PALETTE1+1),a
				ld	a,$55			; WHITE
				ld	(IRQ_PALETTE3+1),a
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
; TUNEL EFFECT
; Precomputed angle_table[32x32] and dist_table[32x32] stored as binary blobs.
; A 32x21 visible window moves sinusoidally inside the 32x32 source field.
; For the first TUNEL_CENTER_HOLD_FRAMES frames, the center stays fixed.
; Per frame: rot_phase+=2, scroll_phase++ (animation)
; Per pixel: color = tunel_tex[ high(angle[x,y]+rot) | low(dist[x,y]+scroll) ]
; Memory: tunel_dist_row ($FC00) = dist row (current), tunel_angle_row ($FD00) = angle row (current)
; tunel_tex[] at TUNEL_TEX (page $24, page-aligned)
;--------------------------------------------------------------------------------------------------------------------------------------
	TUNEL_Calculate:	
				; --- Advance animation phases ---
				ld	a,(tunel_rot_phase)
				add	a,2
				ld	(tunel_rot_phase),a
				
				ld	a,(tunel_scroll_phase)
				inc	a
	TUNEL_SPEEDUP:		nop				; self-modify to $3c
				ld	(tunel_scroll_phase),a
				ld	(TUNEL_ADD_SCR+1),a	; self-modify: add a, scroll_phase
				
				ld	a,(tunel_twist_phase)
				add	a,3
				ld	(tunel_twist_phase),a
				
				ld	a,(SCENE_LOCAL_FLAG)
				or	a
				jp	z,.tunel_center_hold
				
				ld	a,(tunel_center_phase_x)
				inc	a
				ld	(tunel_center_phase_x),a
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)			; 0..126
				srl	a
				srl	a			; 0..31
				ld	(TUNEL_ADD_X+1),a	; self-modify: X source offset
				
				ld	a,(tunel_center_phase_y)
				inc	a
				ld	(tunel_center_phase_y),a
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)			; 0..126
				srl	a
				srl	a
				srl	a			; 0..15
				cp	12
				jp	c,.tunel_src_y_ok
				sub	4			; fold to 0..11, enough for a 21-row window in 32 rows
	.tunel_src_y_ok		ld	l,a
				ld	h,0
				add	hl,hl
				add	hl,hl
				add	hl,hl
				add	hl,hl
				add	hl,hl			; HL = source_y_offset * 32
				ld	b,h
				ld	c,l
				jp	.tunel_src_ready
	.tunel_center_hold	xor	a
				ld	(TUNEL_ADD_X+1),a	; fixed centered source X during intro hold
				ld	bc,TUNEL_CENTER_Y_HOLD_OFFSET
	.tunel_src_ready	
				
				; --- Compute dst (same as Plasma/RTZ: shift-based scanline offset) ---
				ld	a,(shift)
				inc	a
				and	$03
				ld	(shift),a
				ld	h,a
				ld	l,0
				srl	h
				rr	l
				ex	de,hl
				ld	hl,$81C0
				add	hl,de
				ld	(dst),hl
				
				; --- Render all 21 rows from the current 32x32 source window ---
				ld	h,b
				ld	l,c
				ld	de,TUNEL_ANGLE_TABLE
				add	hl,de			; HL -> angle table source row
				push	hl
				ld	h,b
				ld	l,c
				ld	de,TUNEL_DIST_TABLE
				add	hl,de
				ex	de,hl			; DE -> dist table source row
				pop	hl			; HL -> angle table source row
				ld	a,0
				ld	(tunel_row),a
				
	TUNEL_ROW_LOOP:		
				; Copy angle row (HL) to tunel_angle_row ($FD00) - 32 bytes
				push	de			; save dist ptr on stack
				ld	de,tunel_angle_row
				ld	bc,32
				ldir				; HL = angle_ptr+32 (next angle row)
				; HL = next angle row ptr
				; stack top: dist ptr for this row
				
				; Copy dist row to tunel_dist_row ($FC00) - 32 bytes
				pop	de			; DE = dist ptr for this row
				push	hl			; save next angle row ptr on stack
				ld	h,d			; HL = dist row ptr
				ld	l,e
				ld	de,tunel_dist_row
				ld	bc,32
				ldir				; HL = dist_ptr+32 (next dist row)
				ld	d,h			; DE = next dist row ptr
				ld	e,l
				pop	hl			; HL = next angle row ptr
				
				ld	a,(tunel_row)
				add	a,a
				add	a,a
				add	a,a			; A = row * 8
				ld	b,a
				ld	a,(tunel_twist_phase)
				add	a,b			; A = twist_phase + row*8
				ld	b,a
				ld	a,(tunel_rot_phase)
				add	a,b			; A = rot_phase + row_twist
				ld	(TUNEL_ADD_ANG+1),a	; self-modify: angle offset for this row
				
				; Render one row of 32 pixels (each pixel = 2 bytes in GFX16)
				; (HL, DE saved; TUNEL_ADD_ANG/SCR already patched)
				push	hl			; save next angle row ptr
				push	de			; save next dist row ptr
				call	Tunel_Render_Row
				pop	de			; restore next dist row ptr
				pop	hl			; restore next angle row ptr
				
				; Advance dst by 2 scanlines (2*128 = 256 = inc H twice)
				ld	hl,(dst)
				inc	h
				inc	h
				ld	(dst),hl
				
				ld	a,(tunel_row)
				inc	a
				ld	(tunel_row),a
				cp	21
				jp	nz,TUNEL_ROW_LOOP
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
; Tunel_Render_Row - renders 1 row of 32 pixels using 2D tunnel indexing
; tunel_angle_row (tunel_angle_row/256): angle[0..31] for this row
; tunel_dist_row  (tunel_dist_row/256):  dist[0..31] for this row
; dst = target video address
; Pixel formula: color = tunel_tex[ high(angle[col]+rot_phase+row_twist) | low(dist[col]+scroll_phase) ]
;--------------------------------------------------------------------------------------------------------------------------------------
	Tunel_Render_Row:	
				ld	de,(dst)		; DE = video destination
				ld	c,0			; C = column index (0..31)
				
	Tunel_Col_Loop:		ld	a,c
	TUNEL_ADD_X:		add	a,0			; A += x source offset (self-modifying immediate)
				and	$1F			; wrap in 32 columns
				ld	l,a			; L = shifted source column
				ld	h,tunel_angle_row/256	; H = angle page ($FD)
				ld	a,(hl)			; A = angle[col]
	TUNEL_ADD_ANG:		add	a,0			; A += rot_phase + row_twist (self-modifying immediate)
				and	$F0			; keep angle high nibble
				ld	b,a			; B = angle texture coordinate
				ld	h,tunel_dist_row/256	; H = dist page ($FC)
				ld	a,(hl)			; A = dist[col]
	TUNEL_ADD_SCR:		add	a,0			; A += scroll_phase (self-modifying immediate)
				and	$0F			; keep dist low nibble
				or	b			; combine angle/dist into 16x16 texture index
				ld	l,a			; L = texture index
	TUNEL_COL_TEXPAGE:	ld	h,TUNEL_TEX/256		; self-modify: H = active texture page (TUNEL_TEX or TUNEL_TEX2)
				ld	a,(hl)			; A = tunnel_tex[index]
				ld	(de),a
				inc	de
				inc	de
				inc	c			; advance column counter
				ld	a,c
				cp	32
				jp	nz,Tunel_Col_Loop
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
; ROTOZOOM EFFECT
; Uses same Plasma renderer (sinx/siny tables + data[]).
; sinx[col] = cos(angle)*scale*col + pan_x  (raw phase, no sin transform)
; siny[row] = sin(angle)*scale*row + pan_y  (raw phase)
; color = data[sinx[col] + siny[row]] = 1D rotated-and-zoomed texture
;--------------------------------------------------------------------------------------------------------------------------------------
	RTZ_Calculate:		
				; --- Zoom scale from sine oscillator ---
				ld	a,(rtz_zoom_phase)
				inc	a
				ld	(rtz_zoom_phase),a
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)			; sin[phase], 0..126
				srl	a			; divide by 2: range 0..63
				add	a,3			; range 3..66 (min zoom preserved, wider swing)
				ld	(rtz_zoom_scale),a
				
				; --- cos(angle) * scale -> rtz_dx_word ---
				ld	a,(rtz_angle)
				add	a,64			; cos = sin[angle+64]
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)			; sin[angle+64] = cos(angle), 0..126
				sub	63			; center: -63..+63 (signed)
				ld	e,a			; E = cos_a (low byte)
				rla				; sign bit to carry
				sbc	a,a			; A = $00 or $FF (sign extension)
				ld	d,a			; DE = sign-extended cos_a (-63..+63)
				ld	a,(rtz_zoom_scale)
				ld	b,a			; B = loop count (3..18)
				ld	hl,0
	RTZ_COS_MUL:		add	hl,de
				djnz	RTZ_COS_MUL		; HL = cos_a * scale = dx_word
				ld	(rtz_dx_word),hl
				
				; --- sin(angle) * scale -> rtz_dy_word ---
				ld	a,(rtz_angle)
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)			; sin(angle), 0..126
				sub	63			; center: -63..+63 (signed)
				ld	e,a
				rla
				sbc	a,a
				ld	d,a			; DE = sign-extended sin_a
				ld	a,(rtz_zoom_scale)
				ld	b,a
				ld	hl,0
	RTZ_SIN_MUL:		add	hl,de
				djnz	RTZ_SIN_MUL		; HL = sin_a * scale = dy_word
				ld	(rtz_dy_word),hl
				
				; --- Fill siny[0..20] with dy_word accumulation ---
				ld	h,$01			; H = siny page ($0100)
				ld	a,(rtz_pan_y)
				ld	ixh,a
				ld	ixl,0			; IX = pan_y<<8 (start accumulator)
				ld	de,(rtz_dy_word)
				ld	l,0			; L = row index (0..20)
				ld	b,21
	RTZ_SINY_LOOP:		ld	a,ixh
				ld	(hl),a
				inc	l
				add	ix,de
				djnz	RTZ_SINY_LOOP
				
				; --- Fill sinx[0..63] with dx_word accumulation ---
				ld	h,$02			; H = sinx page ($0200)
				ld	a,(rtz_pan_x)
				ld	ixh,a
				ld	ixl,0			; IX = pan_x<<8 (start accumulator)
				ld	de,(rtz_dx_word)
				ld	l,0			; L = col index (0..63)
				ld	b,64
	RTZ_SINX_LOOP:		ld	a,ixh
				ld	(hl),a
				inc	l
				add	ix,de
				djnz	RTZ_SINX_LOOP
				
				; --- Advance rotation angle ---
				ld	a,(rtz_angle)
				ld	hl,rtz_angle_speed
				add	a,(hl)
				ld	(rtz_angle),a
				
				; --- Advance pan (fly-through texture movement) ---
				ld	a,(rtz_pan_x)
				inc	a
				ld	(rtz_pan_x),a
				ld	a,(rtz_pan_y)
				inc	a
				ld	(rtz_pan_y),a
				
				; --- Compute dst (same formula as Calculate) ---
				ld	a,(shift)
				ld	h,a
				ld	l,0
				srl	h
				rr	l
				ex	de,hl
				ld	hl,$81C0
				add	hl,de
				ld	(dst),hl
				ret
				
	Calculate:		
				ld	a,(zoom_phase)
				ld	hl,zoom_osc_speed
				add	a,(hl)
				ld	(zoom_phase),a
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)
				sub	128
				
				ld	l,a
				rla
				sbc	a,a
				ld	h,a
				
	amplitudey		ld	b,2
	.m_loop_y_opt		
				add	hl,hl
				dec	b
				jp	nz,.m_loop_y_opt
				ld	de,(base_zoom)
				add	hl,de
				ld	(zoom_word_y),hl
				
				ld	a,(zoom_phase_x)
				ld	hl,zoom_osc_speed_x
				add	a,(hl)
				ld	(zoom_phase_x),a
				add	a,64
				
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)
				sub	128
				
				ld	l,a
				rla
				sbc	a,a
				ld	h,a
				
	amplitudex:		ld	b,2
	.m_loop_x_opt		
				add	hl,hl
				dec	b
				jp	nz,.m_loop_x_opt
				ld	de,(base_zoom)
				add	hl,de
				ld	(zoom_word_x),hl
				
				ld	a,(boil_phase_y)
				ld	hl,boil_speed_y
				add	a,(hl)
				ld	(boil_phase_y),a
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)
				sub	128
				
				ld	b,a
				ld	a,(boil_shift)
				and	a
				jp	z,.store_boil_y
				ld	c,a
				ld	a,b
	.shift_y_opt		
				sra	a
				dec	c
				jp	nz,.shift_y_opt
	.store_boil_y		
				ld	(y_offset_temp),a
				
				ld	a,(boil_phase_x)
				ld	hl,boil_speed_x
				add	a,(hl)
				ld	(boil_phase_x),a
				add	a,32
				
				ld	l,a
				ld	h,sin / 256
				ld	a,(hl)
				sub	128
				
				ld	b,a
				ld	a,(boil_shift)
				and	a
				jp	z,.store_boil_x
				ld	c,a
				ld	a,b
	.shift_x_opt		
				sra	a
				dec	c
				jp	nz,.shift_x_opt
	.store_boil_x		
				ld	(x_offset_temp),a
				
				ld	bc,siny
				exx
				
				ld	de,(zoom_word_y)
				ld	a,(camy)
				ld	hl,y_offset_temp
				add	a,(hl)
				ld	ixh,a
				ld	ixl,0
				
				ld	h,sin / 256
				ld	b,21
				
	.yloop_fixed		
				ld	a,ixh
				ld	l,a
				ld	a,(hl)
				exx
				ld	(bc),a
				inc	bc
				exx
				add	ix,de
				dec	b
				jp	nz,.yloop_fixed
				
				ld	bc,sinx
				exx
				
				ld	de,(zoom_word_x)
				ld	a,(camx)
				ld	hl,x_offset_temp
				add	a,(hl)
				ld	ixh,a
				ld	ixl,0
				
				ld	h,sin / 256
				ld	b,64
				
	.xloop_fixed		
				ld	a,ixh
				ld	l,a
				ld	a,(hl)
				exx
				ld	(bc),a
				inc	bc
				exx
				add	ix,de
				dec	b
				jp	nz,.xloop_fixed
				
				ld	a,(shift)
				ld	h,a
				ld	l,0
				srl	h
				rr	l
				
				ex	de,hl
				ld	hl,$81C0
				add	hl,de
				ld	(dst),hl
				ret
				
	Plasma:			
				ld	a,0
				ld	(y),a
				
	Plasma_Line_Loop:	
				ld	a,(y)
				ld	e,a
				ld	d,0
				ld	hl,siny
				add	hl,de
				ld	a,(hl)
				ld	iyl,a
				
				ld	de,(dst)
				ld	bc,sinx
				ld	hl,data
				
				ld	a,(bc)
				inc	c
				inc	c
				add	a,iyl
				ld	l,a
				ld	a,(hl)
				ld	(de),a
				inc	de
				inc	de
				
				ld	a,(bc)
				inc	c
				inc	c
				add	a,iyl
				ld	l,a
				ld	a,(hl)
				ld	(de),a
				inc	de
				inc	de
				
				ld	a,(bc)
				inc	c
				inc	c
				add	a,iyl
				ld	l,a
				ld	a,(hl)
				ld	(de),a
				inc	de
				inc	de
				
				ld	a,(bc)
				inc	c
				inc	c
				add	a,iyl
				ld	l,a
				ld	a,(hl)
				ld	(de),a
				inc	de
