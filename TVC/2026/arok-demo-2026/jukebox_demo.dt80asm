;--------------------------------------------------------------------------------------------------------------------------------------
; TEXTURE FLYTHROUGH EFFECT (SCENE 14)
; 8KB GFX4 texture at TEX4K ($5E00-$7DFF): 128 byte-cols x 64 rows (512x64 pixels).
; 2 rows share one 256-byte page: H = TEX4K_BASE + row/2,  L = (row&1)*128 + col
; Camera pans sinusoidally:
;   scroll_u = sin[tex4k_wave_phase] >> 1   (0..63, U-axis) stride=2 so max L = 62+63=125 < 128, no seam
;   scroll_v = sin[tex4k_v_tick] >> 1       (0..63, V-axis)
; Render: 21 rows x 32 cols, fixed dst = $81C0 (no shift trick)
;--------------------------------------------------------------------------------------------------------------------------------------
	Tex4K_Calculate:	
				; --- sinusoidal U scroll: phase advances 2/frame ---
				ld	a,(tex4k_wave_phase)
				add	a,2
				ld	(tex4k_wave_phase),a
				ld	l,a
				ld	h,sin/256
				ld	a,(hl)			; sin 0..126
	TEX4K_U_SRL:		srl	a			; >> 1 = 0..63: self-modifying, patched to NOP NOP on zoom
				ld	(tex4k_scroll_u),a	; U = 0..63
				
				; --- sinusoidal V scroll: phase advances 1/frame ---
				ld	a,(tex4k_v_tick)
				inc	a
				ld	(tex4k_v_tick),a
				ld	l,a
				ld	h,sin/256
				ld	a,(hl)			; sin 0..126
				srl	a			; 0..63 (fits 64-row texture)
				ld	(tex4k_scroll_v),a
				
				; --- compute dst: same shift trick as tunnel/plasma ---
				; cycles through 4 scanline offsets (0, $80, $100, $180) from $81C0
				; each rendered byte appears on 4 different scanlines = tall chunky pixels
				ld	a,(shift)
				inc	a
				and	$03
				ld	(shift),a
				ld	h,a
				ld	l,0
				srl	h
				rr	l			; HL = shift*128: 0, $80, $100, $180
				ex	de,hl
				ld	hl,$81C0
				add	hl,de
				ld	(dst),hl
				
				; --- render 21 rows ---
				xor	a
				ld	(tex4k_row),a
	Tex4K_Row_Loop:		
				; effective_tex_row = (scroll_v + render_row) & $3F
				ld	a,(tex4k_scroll_v)
				ld	b,a
				ld	a,(tex4k_row)
				add	a,b
				and	$3F			; 64-row wrap
				
				; H = TEX4K_BASE + effective_row/2
				ld	b,a			; save effective_row
				srl	a			; A = row/2, carry = row&1
				add	a,TEX4K_BASE
				ld	(TEX4K_ROW_PAGE+1),a	; self-modify H
				
				; L base offset: (row&1)*128 = 0 or $80
				ld	a,b
				and	1			; 0 or 1
				rrca				; 0 or $80
				ld	(TEX4K_ROW_L_BASE+1),a	; self-modify OR mask for L
				
				; pan_u is the same for every column in this row (start position in accumulator loop)
				ld	a,(tex4k_scroll_u)
				ld	(TEX4K_START+1),a	; self-modify: accumulator start = scroll_u
				
				call	Tex4K_Render_Row
				
				; advance dst by 2 scanlines (+$200)
				ld	hl,(dst)
				inc	h
				inc	h
				ld	(dst),hl
				
				ld	a,(tex4k_row)
				inc	a
				ld	(tex4k_row),a
				cp	21
				jp	nz,Tex4K_Row_Loop
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
; Tex4K_Render_Row - renders 1 row of 32 pixels from the 8KB texture
; Texture: 128 bytes/row x 64 rows. 2 rows per 256-byte page.
; TEX4K_ROW_PAGE+1:   H = TEX4K_BASE + effective_row/2  (self-modifying)
; TEX4K_ROW_L_BASE+1: L base = 0 or $80 (row parity, self-modifying)
; TEX4K_PAN_U+1:      pan_u + wave offset, pre-masked to 0..127 (self-modifying)
; Accumulator-based: C starts at scroll_u, advances by TEX4K_STRIDE each column.
; stride=2 (default scroll), stride=4/8 (zoomed out), stride=1 (zoomed in/close-up).
; and $7F ensures L stays 0..127, no seam possible within 32 cols.
;--------------------------------------------------------------------------------------------------------------------------------------
	Tex4K_Render_Row:	
				ld	de,(dst)
	TEX4K_START:		ld	c,0			; self-modify: start = tex4k_scroll_u
				ld	b,32			; 32 columns
	Tex4K_Col_Loop:		ld	a,c
				and	$7F			; wrap to 0..127
	TEX4K_ROW_L_BASE:	or	$00			; row parity offset: 0 or $80 (self-modifying)
				ld	l,a
	TEX4K_ROW_PAGE:		ld	h,TEX4K_BASE		; texture row page (self-modifying immediate)
				ld	a,(hl)
				ld	(de),a
				inc	de
				inc	de			; skip alternate byte (chunky pixels)
				ld	a,c
	TEX4K_STRIDE:		add	a,2			; self-modify: stride 1=close, 2=normal, 4/8=far
				ld	c,a
				djnz	Tex4K_Col_Loop
				ret
				
	INIT_BASE_ZOOM		equ	400
				
	val:			db	0
	dst:			dw	0
	x:			db	0
	y:			db	0
	camy			db	0
	camx			db	0
	shift:			db	0
				
	boil_shift		db	3			;original: 2
	boil_phase_y		db	0
	boil_speed_y		db	1			;original: 1
	boil_phase_x		db	0
	boil_speed_x		db	2			;original: 2
				
	base_zoom		dw	INIT_BASE_ZOOM
	zoom_word_y		dw	0
	zoom_word_x		dw	0
	zoom_osc_speed		db	1
	zoom_phase		db	0
	zoom_osc_speed_x	db	1
	zoom_phase_x		db	0
	zoom_mod_phase		db	212			; Phase at which sin[212]*14+180=278 ~= INIT_BASE_ZOOM (no jump on scene start)
	x_offset_temp		db	0
	y_offset_temp		db	0
				
; --- Rotozoom variables ---
	rtz_angle		db	0
	rtz_angle_speed		db	2			; rotation speed (full rotation in ~128 frames)
	rtz_zoom_phase		db	212			; zoom oscillator start phase (no jump on scene start)
	rtz_zoom_scale		db	4			; current zoom scale multiplier (3..18)
	rtz_pan_x		db	0			; texture pan X (fly-through)
	rtz_pan_y		db	0			; texture pan Y
	rtz_dx_word		dw	0			; U-step per column (cos*scale, 16-bit fixed point)
	rtz_dy_word		dw	0			; V-step per row (sin*scale, 16-bit fixed point)
				
; --- Tunnel variables ---
	TUNEL_CENTER_HOLD_FRAMES	equ	510		; 600 frames: static center intro
	TUNEL_CENTER_X_START_PHASE	equ	$C5		; centered X start for smooth release
	TUNEL_CENTER_Y_START_PHASE	equ	$8F		; centered Y start for smooth release
	TUNEL_CENTER_Y_HOLD_OFFSET	equ	$00A0		; centered 21-row window inside 32 rows
	TUNEL_TEX_SWITCH_FRAME	equ	260			; frames 0..359: TUNEL_TEX2, 360+: TUNEL_TEX
				
	tunel_rot_phase		db	0			; rotation phase (angle offset)
	tunel_scroll_phase	db	0			; scroll phase (dist offset, fly-in)
	tunel_twist_phase	db	0			; helical twist phase
	tunel_center_phase_x	db	0			; horizontal source window phase
	tunel_center_phase_y	db	64			; vertical source window phase (quadrature)
	tunel_row		db	0			; current row index (loop counter)
				
; --- Tex4K variables ---
	TEX4K_BASE		equ	TEX4K / 256		; texture base page ($5F00-$7EFF, 8KB, 64 rows)
	tex4k_scroll_u		db	0			; U scroll 0..63 (sin-based, stride=2 = no seam)
	tex4k_scroll_v		db	0			; V scroll 0..63 (64-row texture)
	tex4k_v_tick		db	0			; V phase counter (sin index)
	tex4k_wave_phase	db	0			; U phase counter (sin index)
	tex4k_row		db	0			; current render row index (loop counter)
	tunel_dist_row		equ	$0100			; U3 top: dist row buffer (32 bytes, page-aligned) DO NOT CHANGE $0100
	tunel_angle_row		equ	$0200			; U3 top: angle row buffer (32 bytes, page-aligned)  DO NOT CHNAGE  $0200
				
	siny			equ	$0100
	sinx			equ	$0200
				
;--------------------------------------------------------------------------------------------------------------------------------------                 				                                  
	COUNT_DOWN_WHITE:	
				ld	a,$ff			; entry point with white border
				out	(0),a
				
				nop				; timing
				nop
				nop
				nop
				
				ld	b,LINE_HEIGHT
				
	COUNT_DOWN:		ld	a,b
				ld	(downcounter+1),a
	downcounter:		ld	a,1
				dec	a
				ld	(downcounter+1),a
				jp	nz,downcounter
				ret
				
	COLOR_BORDER:		
				ld	hl,VOL_TO_BORDER_MAP
				ld	d,0
				ld	e,a
				add	hl,de
				ld	a,(hl)
				out	($0),a
				ret
				
	VOL_TO_BORDER_MAP	db	0, 0, 2, 2, 8, 8, 10, 10, 32, 32, 34, 34, 40, 40, 42, 42
				
;--------------------------------------------------------------------------------------------------------------------------------------                 				                                  
; HORIZONTAL SYNC EFFECT
;--------------------------------------------------------------------------------------------------------------------------------------                 				                                  
				
	sine_phase:		dw	$0000
; Adjust sine_speed to change the frequency of the movement
; $0100 = 1 table step per frame
; $0180 = 1.5 table steps per frame
; $00C0 = 0.75 table steps per frame
	sine_speed:		dw	$0600
	Horizontal_Sync_CRTC:	db	$46
				
	CRTC_HORIZONTAL_EFFECT:	
; Update 16-bit phase accumulator
				ld	hl,(sine_phase)
				ld	de,(sine_speed)
				add	hl,de
				ld	(sine_phase),hl
				
; Get high byte of phase for table index
				ld	a,h
; Mask to $3F (63) for the 64-byte table
				and	$3F
				ld	e,a
				ld	d,$00
				ld	hl,sine_table
				add	hl,de
				ld	a,(hl)
				
; Add base CRTC value
				add	a,$46
				ld	(Horizontal_Sync_CRTC),a
				call	SetCRTCHorizontalSync
				ret
				
	SetCRTCHorizontalSync:	
				ld	a,$02
				out	($70),a
				ld	a,(Horizontal_Sync_CRTC)
				out	($71),a
				ret
				
; 64-byte sine table (Amplitude: 0 to $0C)
	sine_table:		
				db	$06, $07, $07, $08, $08, $09, $09, $0A
				db	$0A, $0B, $0B, $0B, $0C, $0C, $0C, $0C
				db	$0C, $0C, $0C, $0C, $0B, $0B, $0B, $0A
				db	$0A, $09, $09, $08, $08, $07, $07, $06
				db	$06, $05, $05, $04, $04, $03, $03, $02
				db	$02, $01, $01, $01, $00, $00, $00, $00
				db	$00, $00, $00, $00, $01, $01, $01, $02
				db	$02, $03, $03, $04, $04, $05, $05, $06
				
;--------------------------------------------------------------------------------------------------------------------------------------                 				                                  				
	LOAD_MUSIC:		
				xor	a
				ld	(MUSIC_ENABLE_FLAG),a
				halt				; wait for disabling music by interrupt based on the flag
				halt
				ld	A,$B0			; lapozási kód: U0, U1, U2, U3
				out	($02),a			; Belapozás
				
				ld	a,(MSC_INDEX)		; get ZX7 file by index
				cp	0
				jp	z,MSC01
				cp	1
				jp	z,MSC02
				cp	2
				jp	z,MSC03
				cp	3
				jp	z,MSC04
				cp	4
				jp	z,MSC05
	MSC06:			ld	hl,TEXT06
				ld	(MSC_NAME_PTR+1),hl
				ld	HL,MUSIC_06_ZX7
				jp	DO_LOAD
	MSC05:			ld	hl,TEXT05
				ld	(MSC_NAME_PTR+1),hl
				ld	HL,MUSIC_05_ZX7
				jp	DO_LOAD
	MSC04:			ld	hl,TEXT04
				ld	(MSC_NAME_PTR+1),hl
				ld	HL,MUSIC_04_ZX7
				jp	DO_LOAD
	MSC01:			ld	hl,TEXT01
				ld	(MSC_NAME_PTR+1),hl
				ld	HL,MUSIC_01_ZX7
				jp	DO_LOAD
	MSC02:			ld	hl,TEXT02
				ld	(MSC_NAME_PTR+1),hl
				ld	HL,MUSIC_02_ZX7
				jp	DO_LOAD
	MSC03:			ld	hl,TEXT03
				ld	(MSC_NAME_PTR+1),hl
				ld	HL,MUSIC_03_ZX7
				
				
	DO_LOAD:		ld	DE,SONG_DATA
				call	ZX7_DECOMPRESS
				call	INIT_PLAYER
				
; MUSIC NAME
				ld	A,$50			; lapozási kód: U0, U1, U2, SYS
				out	($02),a			; Belapozás
				
				ld	a,3			; set ink to palette 3
				ld	(2893),a
				ld	bc,$0116		; B = oszlop(1-32): 1, C = sor(1-24): 22
				rst	$30
				db	$23
				
				ld	bc,32
	MSC_NAME_PTR:		ld	de,TEXT01
				rst	$30
				db	$22
				
				ld	A,$90			; lapozási kód: U0, U1, VID, U3
				out	($02),a			; Belapozás
				
				ld	a,1
				ld	(MUSIC_ENABLE_FLAG),a
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------                 				                                  				
	END_OF_APP:		di
				ld	a,(IT_HANDLER_1)
				ld	(0038H),a		; RESTORE IT HANDLER
				ld	(IT_HANDLER_1),A
				ld	HL,(IT_HANDLER_2)
				ld	(0039H),HL
				ei
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------                 				                                  				
; GREETINGS TEXT
;--------------------------------------------------------------------------------------------------------------------------------------                 				                                  				
	HALT_ON_TOP:		halt
				ld	a,(IT_IDX)		; wait for non music IT (20ms)
				or	a
				jp	nz,HALT_ON_TOP
				ret
				
	RENDER_GREETINGS:	
				ld	A,$90			; lapozási kód: U0, U1, VID, U3
				out	($02),a			; Belapozás
				
				ld	ix,GREETING_PTRS	; IX = pointer table
				ld	b,5
				ld	hl,$0114		; col=1, row=20
				
	char_loop:		call	HALT_ON_TOP
				push	bc
				push	hl
				ld	b,h			; B = col
				ld	c,l			; C = row
				call	RST30DB3		; compute VRAM_POSITION from BC
				ld	e,(ix+0)		; DE = text pointer from table
				ld	d,(ix+1)
				call	RST30DB2		; write text (stops at db 0 terminator)
				pop	hl
				inc	l			; next row
				inc	ix
				inc	ix			; advance pointer table (2 bytes per entry)
				pop	bc
				djnz	char_loop
				
				ld	A,$B0			; lapozási kód: U0, U1, U2, U3
				out	($02),a			; Belapozás
				call	INIT_MUSICBY		; decompress TEXT
				ld	A,$90			; lapozási kód: U0, U1, VID, U3
				out	($02),a			; Belapozás
				ret
; ===========================================================================
; INIT PLAYER
; ===========================================================================
	INIT_PLAYER:		
				call	ResetSAA
				
; -- 1. Setup Base Pointers --
				ld	hl,SONG_DATA
				ld	(VAR_MUSIC_BASE),hl
				
; Get Pattern List Pointer (Offset 9)
				ld	de,9
				add	hl,de
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
				ld	hl,(VAR_MUSIC_BASE)
				add	hl,de
				ld	(VAR_PATS_PTR),hl
				
; Get Position Data Pointer (Offset 11)
				ld	hl,(VAR_MUSIC_BASE)
				ld	de,11
				add	hl,de
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
				ld	hl,(VAR_MUSIC_BASE)
				add	hl,de
				ld	(VAR_POS_PTR),hl
				
; -- 2. Initialize Variables --
				ld	a,1
				ld	(VAR_POS_ROWS_LEFT),a
				ld	(VAR_CUR_TICK),a
				
; Clear Channels
				ld	hl,CH_DATA
				ld	b,6 * CH_STRUCT_SIZE
				xor	a
	FillChannelMem:		
				ld	(hl),a
				inc	hl
				djnz	FillChannelMem
				
				ld	ix,CH_DATA
				ld	de,CH_STRUCT_SIZE
				ld	b,6
	InitVols:		
				ld	(ix+O_PAT_VOL_L),0	; Default L attenuation = 0
				ld	(ix+O_PAT_VOL_R),0	; Default R attenuation = 0
				add	ix,de
				djnz	InitVols
				
				ret
				
; ===========================================================================
; PlayFrame
; ===========================================================================
	PlayFrame:		
				ld	a,(VAR_CUR_TICK)
				dec	a
				ld	(VAR_CUR_TICK),a
				jr	nz,UpdateEffects
				
; --- New Row Logic ---
				ld	hl,VAR_POS_ROWS_LEFT
				dec	(hl)
				jr	nz,SamePosition
				
				call	UpdatePosition
				
	SamePosition:		
				ld	a,(VAR_GLOBAL_SPEED)
				ld	(VAR_CUR_TICK),a
				
				call	ProcessRow
				
	UpdateEffects:		
				call	ProcessEffects
				call	UpdateSAA_Registers
				
				ret
				
; ===========================================================================
; UpdatePosition
; ===========================================================================
	UpdatePosition:		
				ld	hl,(VAR_POS_PTR)
				
; Read Length (Byte 0)
				ld	a,(hl)
				or	a
				jr	z,HandlePosLoop
				
				ld	(VAR_POS_ROWS_LEFT),a
				inc	hl
				
; Read Speed (Byte 1)
				ld	a,(hl)
				ld	(VAR_GLOBAL_SPEED),a
				inc	hl
				
				call	ReloadPatterns
				
; Advance Position Pointer by 14 bytes (2 header + 6*2 channel data)
				ld	hl,(VAR_POS_PTR)
				ld	de,14
				add	hl,de
				ld	(VAR_POS_PTR),hl
				ret
				
	HandlePosLoop:		
				inc	hl
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
				
				ld	a,d
				or	e
				jr	z,StopMusic
				
				ld	hl,(VAR_MUSIC_BASE)
				add	hl,de
				ld	(VAR_POS_PTR),hl
				jp	UpdatePosition
				
	StopMusic:		
				ld	a,64
				ld	(VAR_POS_ROWS_LEFT),a
				ret
				
; ===========================================================================
; ReloadPatterns
; ===========================================================================
	ReloadPatterns:		
				ld	ix,CH_DATA
				ld	b,6
				
	PatLoop:		
				push	hl
				
				ld	a,(hl)			; Pattern Number (1-based; 0 = no pattern)
				inc	hl
				ld	c,(hl)			; Transpose (signed byte)
				
				or	a			; Check for 0 = no pattern
				jr	z,EmptyPat		; If 0, skip to EmptyPat
				
				ld	l,a
				ld	h,0
				add	hl,hl			; x2 (entry is a WORD)
				ld	de,(VAR_PATS_PTR)
				add	hl,de			; HL = address of pattern pointer
				
				ld	e,(hl)
				inc	hl
				ld	d,(hl)			; DE = offset of pattern data
				
				ld	a,d
				or	e
				jr	z,EmptyPat
				
				ld	hl,(VAR_MUSIC_BASE)
				add	hl,de			; HL = absolute address
				jr	SavePatPtr
				
	EmptyPat:		
				ld	hl,0
				
	SavePatPtr:		
				ld	(ix+O_PTR_L),l
				ld	(ix+O_PTR_H),h
				ld	(ix+O_WAIT),0
				ld	(ix+O_POS_TRANSPOSE),c
				
				pop	hl
				inc	hl
				inc	hl
				
				ld	de,CH_STRUCT_SIZE
				add	ix,de
				djnz	PatLoop
				ret
				
; ===========================================================================
; ProcessRow
; ===========================================================================
	ProcessRow:		
				ld	ix,CH_DATA
				ld	b,6
				
	RowLoop:		
				push	bc
				
				ld	a,(ix+O_WAIT)
				or	a
				jr	z,FetchNext
				dec	(ix+O_WAIT)
				jp	NextRowCh
				
	FetchNext:		
				ld	l,(ix+O_PTR_L)
				ld	h,(ix+O_PTR_H)
				ld	a,h
				or	l
				jp	z,NextRowCh
				
				ld	a,(hl)
				inc	hl
				
				bit	7,a
				jr	z,HandleNote
				
; --- RLE / End ---
				and	$7F
				cp	127
				jr	z,PatternEnd
				
				ld	(ix+O_WAIT),a		; Wait counter saved as-is
				ld	(ix+O_PTR_L),l
				ld	(ix+O_PTR_H),h
				jp	NextRowCh
				
	PatternEnd:		
				ld	(ix+O_PTR_L),0
				ld	(ix+O_PTR_H),0
				jp	NextRowCh
				
	HandleNote:		
				or	a
				jr	z,HandleFlags
				
				cp	$7f			; 127 = Release
				jr	z,HandleRelease
				
				cp	97			; 97 = Tie (Sustain)
				jr	z,HandleFlags		; Ignore, do not rewind pointers
				
				cp	98			; Invalid notes
				jr	nc,HandleFlags
				
				push	af			; Save new note
				ld	a,(ix+O_NOTE)
				ld	(VAR_TEMP_NOTE),a	; Save old note for glissando
				pop	af			; Restore new note
				ld	(ix+O_NOTE),a
				ld	(ix+O_NOTE_TRIG),1	; Set trigger for envelope
				ld	(ix+O_RELEASED),0	; Clear release flag
				ld	(ix+O_CMD_SHIFT_L),0
				ld	(ix+O_CMD_SHIFT_H),0
				ld	(ix+O_CMD_PHASE),0
				ld	e,(ix+O_SAMP_BASE_L)
				ld	d,(ix+O_SAMP_BASE_H)
				ld	(ix+O_SAMP_PTR_L),e
				ld	(ix+O_SAMP_PTR_H),d
				
				ld	e,(ix+O_ORN_BASE_L)
				ld	d,(ix+O_ORN_BASE_H)
				ld	(ix+O_ORN_PTR_L),e
				ld	(ix+O_ORN_PTR_H),d
				
				jr	HandleFlags
				
	HandleRelease:		
				ld	a,(ix+O_RELEASABLE)
				or	a
				jr	z,HardRelease		; Not releasable: hard stop
				ld	a,(ix+O_RELEASED)
				or	a
				jr	nz,HardRelease		; Already released: hard stop
				; Soft release: switch to release section of sample
				ld	(ix+O_RELEASED),1
				jp	HandleFlags
	HardRelease:		
				xor	a
				ld	(ix+O_NOTE),a
				ld	(ix+O_SAMP_PTR_L),a	; Null ptr: ProcessSample silences channel
				ld	(ix+O_SAMP_PTR_H),a
				
	HandleFlags:		
				ld	b,0
				ld	a,(hl)
				inc	hl
				ld	c,a
				
; Sample
				and	$1F
				jr	z,CheckN
				ld	(ix+O_SAMP_NUM),a
				ld	(ix+O_NOTE_TRIG),1	; Trigger envelope on instrument change
				call	LoadSamplePtr
				
	CheckN:			
				bit	5,c			; Bit 5: If 1, skip reading Cmd+Orn byte
				jr	nz,SkipCmdOrn
				
; Read Byte 3 (Cmd + Orn)
				ld	a,(hl)
				inc	hl
				ld	d,a
				
; Ornament
				and	$0F
				jr	z,CheckCmd
				
				ld	(ix+O_ORN_NUM),a
				call	LoadOrnPtr
				
	CheckCmd:		
				ld	a,d
				and	$F0
				jr	z,ClearCmd
				rrca
				rrca
				rrca
				rrca
				ld	b,a			; Save new command to B
				ld	(ix+O_CMD),a
				cp	$03
				call	z,GlissandoInit
				jr	CheckP
				
	SkipCmdOrn:						; N-flag set: Cmd+Orn byte omitted, previous command state preserved.
				jr	CheckP
				
	ClearCmd:		
				ld	(ix+O_CMD),0
				
	CheckP:			
				bit	6,c			; Bit 6: If 1, clear Ornament (orn_release)
				jr	z,CheckV
				xor	a
				ld	(ix+O_ORN_NUM),a
				ld	(ix+O_ORN_OFFSET),a
				call	LoadOrnPtr		; Reset orn pointer to orn[0] (clear stale ptr, JS: pp.orn=ornaments[0])
; If active command is ornament-specific (cmd=6 or cmd=7), clear it too.
; These commands directly manipulate the ornament; keeping them active after
; orn_release would cause them to run on ornaments[0] (empty ornament).
				ld	a,(ix+O_CMD)
				cp	$06
				jr	z,ClearOrnCmd
				cp	$07
				jr	nz,CheckV
	ClearOrnCmd:		
				xor	a
				ld	(ix+O_CMD),a
				ld	(ix+O_CMD_DAT),a
				
	CheckV:			
				bit	7,c			; Bit 7: If 1, read Volume byte
				jr	z,CheckCmdData
				
; Read Volume Byte
				ld	a,(hl)
				inc	hl
				ld	e,a
				and	$0F
				xor	$0F
				ld	(ix+O_PAT_VOL_L),a
				ld	a,e
				rrca
				rrca
				rrca
				rrca
				and	$0F
				xor	$0F
				ld	(ix+O_PAT_VOL_R),a
				
	CheckCmdData:		
; ONLY read command data if a NEW command was declared in this row (B > 0)
				ld	a,b
				or	a
				jr	z,SaveRowPtr
				
				cp	$0B			; Break command takes 16-bit data
				jr	z,CmdWord
				
; Read 8-bit command data
				ld	a,(hl)
				inc	hl
				ld	(ix+O_CMD_DAT),a
				jr	SaveRowPtr
				
	CmdWord:		
; Read 16-bit command data
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
				inc	hl
				ld	(ix+O_CMD_DAT16),e
				ld	(ix+O_CMD_DAT16_H),d
				
	SaveRowPtr:		
				ld	(ix+O_PTR_L),l
				ld	(ix+O_PTR_H),h
				
	NextRowCh:		
				ld	de,CH_STRUCT_SIZE
				add	ix,de
				pop	bc
				dec	b
				jp	nz,RowLoop
				ret
				
; ===========================================================================
; Helper: Load Sample Pointer
; ===========================================================================
	LoadSamplePtr:		
				push	hl
				push	bc
				push	de
				
				ld	hl,(VAR_MUSIC_BASE)
				ld	bc,5
				add	hl,bc
				ld	e,(hl)
				inc	hl
				ld	d,(hl)			; DE = Sample List offset
				
				ld	hl,(VAR_MUSIC_BASE)
				add	hl,de			; HL = absolute Sample List address
				
				ld	a,(ix+O_SAMP_NUM)
				; Pointer list already contains sample[0] as the empty sample entry.
				
				ld	e,a
				ld	d,0
				add	hl,de
				add	hl,de			; HL += SAMP_NUM * 2
				
				ld	e,(hl)
				inc	hl
				ld	d,(hl)			; DE = sample data offset
				
; Empty sample check: offset $0000 means no data
				ld	a,d
				or	e
				jr	z,SmpEmpty		; Zero offset: no sample data
				
				ld	hl,(VAR_MUSIC_BASE)
				add	hl,de			; HL = absolute sample data address
				
; Check for releasable sample marker ($FF only; $80 = end-of-sample ctrl byte)
				ld	(ix+O_RELEASABLE),0	; Default: not releasable
				ld	a,(hl)
				cp	$FF
				jr	nz,NoSmpRel
				ld	(ix+O_RELEASABLE),1	; Releasable sample detected
				inc	hl			; Skip $FF marker
	NoSmpRel:		
				jr	SmpSave
				
	SmpEmpty:		
				ld	(ix+O_RELEASABLE),0	; Empty sample: not releasable
				ld	hl,0			; Set pointer explicitly to 0
				
	SmpSave:		
				ld	(ix+O_SAMP_PTR_L),l
				ld	(ix+O_SAMP_PTR_H),h
				ld	(ix+O_SAMP_BASE_L),l
				ld	(ix+O_SAMP_BASE_H),h
				ld	(ix+O_RELEASED),0	; Clear released flag on sample load
				
				pop	de
				pop	bc
				pop	hl
				ret
				
; ===========================================================================
; Helper: Load Ornament Pointer
; ===========================================================================
	LoadOrnPtr:		
				push	hl
				push	bc
				push	de
				
				ld	hl,(VAR_MUSIC_BASE)
				ld	bc,7
				add	hl,bc
				ld	e,(hl)
				inc	hl
				ld	d,(hl)			; DE = Ornament List offset
				
				ld	hl,(VAR_MUSIC_BASE)
				add	hl,de			; HL = absolute Ornament List address
				
				ld	a,(ix+O_ORN_NUM)
				; Pointer list already contains ornament[0] as the empty ornament entry.
				
				
				ld	e,a
				ld	d,0
				add	hl,de
				add	hl,de			; HL += ORN_NUM * 2
				
				ld	e,(hl)
				inc	hl
				ld	d,(hl)			; DE = ornament data offset
				
; Empty ornament check: offset $0000 means no data
				ld	a,d
				or	e
				jr	z,OrnEmpty		; Zero offset: no ornament data
				
				ld	hl,(VAR_MUSIC_BASE)
				add	hl,de			; HL = absolute ornament data address
				jr	OrnSave
				
	OrnEmpty:		
				ld	hl,0			; Set pointer explicitly to 0
				
	OrnSave:		
				ld	(ix+O_ORN_PTR_L),l
				ld	(ix+O_ORN_PTR_H),h
				ld	(ix+O_ORN_BASE_L),l
				ld	(ix+O_ORN_BASE_H),h
				
				pop	de
				pop	bc
				pop	hl
				ret
				
; ===========================================================================
; ProcessEffects
; ===========================================================================
	ProcessEffects:		
				xor	a
				ld	(VAR_SAA_NOISE_FREQ),a
				ld	ix,CH_DATA
				ld	de,5 * CH_STRUCT_SIZE
				add	ix,de
				ld	b,6
				ld	c,5
	FxLoop:			
				ld	a,c
				ld	(VAR_CH_IDX),a
				
				push	bc
				
				ld	a,(ix+O_CMD)
				or	a
				call	nz,RunCommand
				
				call	ProcessSample
				call	ProcessOrnament
				
				ld	de,$FFDB		; -CH_STRUCT_SIZE
				add	ix,de
				pop	bc
				dec	c
				djnz	FxLoop
				ret
				
; ===========================================================================
; Run Command
; ===========================================================================
	RunCommand:		
				cp	$01			; Portamento Up
				jp	z,CmdPortamento
				cp	$02			; Portamento Down
				jp	z,CmdPortamento
				cp	$03			; Glissando
				jp	z,CmdGlissando
				cp	$08			; Delay Sample
				jp	z,CmdDelaySample
				cp	$0F
				jr	z,CmdSpeed
				cp	$0B
				jr	z,CmdBreak
				cp	$0E			; Check Envelope command
				jr	z,CmdEnv
				cp	$06			; Delay Ornament
				jr	z,CmdDelayOrn
				cp	$07			; Set Ornament Offset
				jp	z,CmdOrnOffset
				ret
				
	CmdSpeed:		
				ld	a,(ix+O_CMD_DAT)
				; No masking: full byte stored (supports swing speed >= $20)
				ld	(VAR_GLOBAL_SPEED),a
				ld	(ix+O_CMD),0		; Speed cmd is one-shot (JS: pp.cmd=0 after speed change)
				ret
				
	CmdBreak:		
				ld	a,(VAR_GLOBAL_SPEED)
				ld	e,a
				ld	a,(VAR_CUR_TICK)
				cp	e
				ret	nz			; Execute break only on first tick of the row
				
				ld	l,(ix+O_PTR_L)
				ld	h,(ix+O_PTR_H)
				ld	e,(ix+O_CMD_DAT16)
				ld	d,(ix+O_CMD_DAT16_H)
				add	hl,de
				ld	(ix+O_PTR_L),l
				ld	(ix+O_PTR_H),h
				ld	(ix+O_CMD),0
				ret
				
	CmdEnv:			
; Execute only on the first tick of the row.
				ld	a,(VAR_GLOBAL_SPEED)
				ld	e,a
				ld	a,(VAR_CUR_TICK)
				cp	e
				ret	nz			; Not first tick: skip (do not touch hardware)
				
				ld	(ix+O_CMD),0		; One-shot command: clear immediately after execution
				
				ld	a,(ix+O_CMD_DAT)
				ld	e,a
				bit	4,a
				jr	nz,KeepBaseTone
				ld	(ix+O_PAT_VOL_L),15	; E0Y: mute base tone amplitude
				ld	(ix+O_PAT_VOL_R),15
	KeepBaseTone:		
				and	$F0
				cp	$D0			; STMF 'D' = Disable envelope
				jr	z,DisableEnv
				
; STMF->SAA1099 EG register encoding.
; JS reference: val = ((cmdValue & 0x0E) << 1) | (cmdValue & 0x81); val ^= 0x82
; E = full cmdValue byte (both nibbles matter: upper nibble bit3 = E1y keep-amplitude)
				ld	a,e
				and	$0E			; A = cmdValue & 0x0E
				add	a,a			; A = (cmdValue & 0x0E) << 1
				ld	d,a			; D = high part
				ld	a,e
				and	$81			; A = cmdValue & 0x81 (bit7=ENVEXT, bit0=false-stereo)
				or	d			; A = ((cmdValue & 0x0E) << 1) | (cmdValue & 0x81)
				xor	$82			; A ^= 0x82  -> sets ENABL(bit3) and ENVEXT correctly
				jr	SetEnv
				
	DisableEnv:		
				xor	a			; 0 = Reset envelope generator
				
	SetEnv:			
				ld	e,a
				ld	a,(VAR_CH_IDX)
				cp	3
				jr	nc,EnvGen1
				
; Channels 0, 1, 2 use EG0 ($18)
				ld	a,e
				ld	(VAR_EG0_SHAPE),a	; Save EG0 shape
				ld	a,$18
				call	WriteSAA_Reg
				ret
				
	EnvGen1:		
; Channels 3, 4, 5 use EG1 ($19)
				ld	a,e
				ld	(VAR_EG1_SHAPE),a	; Save EG1 shape
				ld	a,$19
				call	WriteSAA_Reg
				ret
				
; ===========================================================================
; CmdDelayOrn: cmd $06 - Delay Ornament by N ticks
; Each tick: suppress ornament (handled by ProcessOrnament check), count down.
; When counter reaches 0: reset orn ptr to base, clear command.
; ===========================================================================
	CmdDelayOrn:		
				dec	(ix+O_CMD_DAT)		; Decrement delay counter
				ret	nz			; Still counting: keep cmd active (ProcessOrnament suppressed)
; Delay expired: reset ornament pointer to base and clear command
				ld	l,(ix+O_ORN_BASE_L)
				ld	h,(ix+O_ORN_BASE_H)
				ld	(ix+O_ORN_PTR_L),l
				ld	(ix+O_ORN_PTR_H),h
				ld	(ix+O_CMD),0
				ret
				
; ===========================================================================
; CmdDelaySample: cmd $08 - Delay Sample by N ticks
; While active, sample and ornament processing are suppressed. When the counter
; reaches 0, sample restarts from base and normal playback resumes.
; ===========================================================================
	CmdDelaySample:		
				ld	a,(ix+O_SAMP_NUM)
				or	a
				jr	z,CmdDelaySampleDone
				ld	a,(ix+O_CMD_DAT)
				or	a
				jr	z,CmdDelaySampleDone
				ld	b,a
				ld	a,(VAR_GLOBAL_SPEED)
				cp	b
				jr	z,CmdDelaySampleDone	; Ignore delays >= current row speed
				jr	c,CmdDelaySampleDone
				dec	(ix+O_CMD_DAT)
				ret	nz
				ld	l,(ix+O_SAMP_BASE_L)
				ld	h,(ix+O_SAMP_BASE_H)
				ld	(ix+O_SAMP_PTR_L),l
				ld	(ix+O_SAMP_PTR_H),h
				ld	l,(ix+O_ORN_BASE_L)
				ld	h,(ix+O_ORN_BASE_H)
				ld	(ix+O_ORN_PTR_L),l
				ld	(ix+O_ORN_PTR_H),h
				ld	(ix+O_NOTE_TRIG),1
	CmdDelaySampleDone:	
				ld	(ix+O_CMD),0
				ret
				
; ===========================================================================
; Uses: AF, BC, DE, HL
; ===========================================================================
	GlissandoInit:		
				; Step 1: save target note, restore base note
				ld	a,(ix+O_NOTE)		; A = target note (just set by HandleNote)
				ld	(ix+O_GLISS_NOTE),a	; Store target note
				ld	a,(VAR_TEMP_NOTE)	; A = old note (base, where we slide FROM)
				ld	(ix+O_NOTE),a		; Revert O_NOTE to base note
				or	a
				ret	z			; Old note = 0? No active glide, abort
				; Step 2: compute freq_word for base note
				dec	a			; 0-based index
				call	GetFreqWordFromNote
				ld	c,e			; C = base freq_byte
				ld	b,d			; B = base octave
				; Step 3: compute freq_word for target note
				ld	a,(ix+O_GLISS_NOTE)
				or	a
				ret	z			; Target = 0? Abort
				dec	a
				call	GetFreqWordFromNote
				; Step 4: delta = target_word - base_word (signed 16-bit)
				ld	h,d
				ld	l,e			; HL = target word
				ld	d,b
				ld	e,c			; DE = base word
				or	a			; Clear carry
				sbc	hl,de			; HL = target_word - base_word (signed delta)
				; Step 5: store delta and reset command shift
				ld	(ix+O_GLISS_TGT_L),l
				ld	(ix+O_GLISS_TGT_H),h
				ld	(ix+O_CMD_SHIFT_L),0
				ld	(ix+O_CMD_SHIFT_H),0
				ld	(ix+O_CMD_PHASE),0
				ret
				
; ===========================================================================
; CmdPortamento: cmd $01 (Up) / cmd $02 (Down) - Portamento
; paramH = (cmdDat >> 4): period in ticks between each shift step
; paramL = (cmdDat & $0F): shift magnitude per step (frequency units)
; O_CMD_PHASE: countdown (0 = reload from paramH)
; O_CMD_SHIFT_L/H: accumulated 16-bit signed frequency shift
; Shift accumulates indefinitely (no stop condition).
; ===========================================================================
	CmdPortamento:		
				ld	a,(ix+O_CMD_PHASE)
				or	a
				jp	nz,PortPhaseActive
				ld	a,(ix+O_CMD_DAT)
				and	$F0
				rrca
				rrca
				rrca
				rrca				; A = paramH
				or	a
				ret	z			; paramH = 0: infinite period, never fires
				ld	(ix+O_CMD_PHASE),a
	PortPhaseActive:	
				dec	(ix+O_CMD_PHASE)
				ret	nz			; Still counting: nothing to do
				ld	a,(ix+O_CMD_DAT)
				and	$0F			; A = paramL
				ld	b,a
				ld	a,(ix+O_CMD)
				cp	$01
				jp	z,PortUp
				ld	a,(ix+O_CMD_SHIFT_L)
				sub	b
				ld	(ix+O_CMD_SHIFT_L),a
				jp	nc,PortDownDone
				dec	(ix+O_CMD_SHIFT_H)
	PortDownDone:		
				ret
	PortUp:			
				ld	a,(ix+O_CMD_SHIFT_L)
				add	a,b
				ld	(ix+O_CMD_SHIFT_L),a
				ret	nc
				inc	(ix+O_CMD_SHIFT_H)
				ret
				
; ===========================================================================
; CmdGlissando: cmd $03 - Glissando to given note
; paramH = (cmdDat >> 4): period in ticks between each shift step
; paramL = (cmdDat & $0F): shift magnitude per step
; O_GLISS_NOTE: target note (1-96, stored by GlissandoInit)
; O_GLISS_TGT_L/H: signed 16-bit target delta (target_freq_word - base_freq_word)
; O_CMD_SHIFT_L/H: current accumulated signed 16-bit shift
; O_CMD_PHASE: countdown
; When shift reaches or passes the target delta: snap to target note, clear cmd.
; ===========================================================================
	CmdGlissando:		
				ld	a,(ix+O_GLISS_NOTE)
				or	a
				ret	z
				ld	a,(ix+O_CMD_PHASE)
				or	a
				jp	nz,GlissPhaseActive
				ld	a,(ix+O_CMD_DAT)
				and	$F0
				rrca
				rrca
				rrca
				rrca				; A = paramH
				or	a
				ret	z			; paramH = 0: never fires
				ld	(ix+O_CMD_PHASE),a
	GlissPhaseActive:	
				dec	(ix+O_CMD_PHASE)
				ret	nz
				ld	a,(ix+O_GLISS_TGT_H)
				bit	7,a
				jp	nz,GlissDown
	GlissUp:		
				ld	a,(ix+O_CMD_DAT)
				and	$0F
				ld	b,a
				ld	a,(ix+O_CMD_SHIFT_L)
				add	a,b
				ld	(ix+O_CMD_SHIFT_L),a
				jp	nc,GlissUpCheckSnap
				inc	(ix+O_CMD_SHIFT_H)
	GlissUpCheckSnap:	
				ld	l,(ix+O_CMD_SHIFT_L)
				ld	h,(ix+O_CMD_SHIFT_H)
				ld	e,(ix+O_GLISS_TGT_L)
				ld	d,(ix+O_GLISS_TGT_H)
				or	a
				sbc	hl,de
				ret	c			; shift < target, keep sliding
				jp	GlissSnap
	GlissDown:		
				ld	a,(ix+O_CMD_DAT)
				and	$0F
				ld	b,a
				ld	a,(ix+O_CMD_SHIFT_L)
				sub	b
				ld	(ix+O_CMD_SHIFT_L),a
				jp	nc,GlissDownCheckSnap
				dec	(ix+O_CMD_SHIFT_H)
	GlissDownCheckSnap:	
				ld	l,(ix+O_CMD_SHIFT_L)
				ld	h,(ix+O_CMD_SHIFT_H)
				ld	e,(ix+O_GLISS_TGT_L)
				ld	d,(ix+O_GLISS_TGT_H)
				or	a
				sbc	hl,de
				jp	z,GlissSnap
				jp	pe,GlissDownOvf
				jp	m,GlissSnap
				ret
	GlissDownOvf:		
				jp	p,GlissSnap
				ret
	GlissSnap:		
				ld	a,(ix+O_GLISS_NOTE)
				ld	(ix+O_NOTE),a
				ld	(ix+O_CMD_SHIFT_L),0
				ld	(ix+O_CMD_SHIFT_H),0
				ld	(ix+O_GLISS_NOTE),0
				ld	(ix+O_GLISS_TGT_L),0
				ld	(ix+O_GLISS_TGT_H),0
				ld	(ix+O_CMD),0
				ret
				
; ===========================================================================
; CmdOrnOffset: cmd $07 - Set Ornament cursor to given position (one-shot)
; ===========================================================================
	CmdOrnOffset:		
				ld	a,(ix+O_CMD_DAT)
				or	a
				jr	z,CmdOrnOffDone		; cmd_dat=0: no jump (JS: cmdValue must be > 0)
				ld	l,(ix+O_ORN_BASE_L)
				ld	h,(ix+O_ORN_BASE_H)
				ld	e,a
				ld	d,0
				add	hl,de			; HL = orn_base + cmd_dat (new cursor position)
				ld	(ix+O_ORN_PTR_L),l
				ld	(ix+O_ORN_PTR_H),h
	CmdOrnOffDone:		
				ld	(ix+O_CMD),0		; One-shot: clear command
				ret
				
; ===========================================================================
; Volume Mixer
; D = pattern volume (0-15), E = sample volume (0-15)
; FADE_ATT_PATCH+1 is self-modified by fadeout routine in SCENE_15_PH_C
; Output: A = clamp(clamp(E - FadeAtt) - D, 0)
; ===========================================================================
	MixVolume:		
				ld	a,e			; A = sample volume
	FADE_ATT_PATCH:		sub	$00			; self-mod: fadeout attenuation (opcode: D6 xx)
				jp	c,MixVolume_clamp	; if E < FadeAtt, clamp to 0
				sub	d			; subtract pattern attenuation
				ret	nc			; return if still >= 0
	MixVolume_clamp:	xor	a			; clamp to 0
				ret
				
; ===========================================================================
; ProcessSample
; ===========================================================================
	ProcessSample:		
				ld	a,(ix+O_SAMP_NUM)
				or	a
				ret	z
				ld	a,(ix+O_CMD)
				cp	$08
				jr	nz,CheckSamplePtr
				xor	a			; Delay sample keeps channel silent until trigger time
				ld	(ix+O_VOL_L),a
				ld	(ix+O_VOL_R),a
				ld	(ix+O_FLAGS),a
				ret
	CheckSamplePtr:		
				
				ld	l,(ix+O_SAMP_PTR_L)
				ld	h,(ix+O_SAMP_PTR_H)
				ld	a,h
				or	l
				jr	nz,ReadSample		; Non-zero pointer: read sample data
				
				xor	a			; Empty pointer: silence channel
				ld	(ix+O_VOL_L),a
				ld	(ix+O_VOL_R),a
				ld	(ix+O_FLAGS),a
				ret
				
	ReadSample:		
; Read Byte 1
				ld	a,(hl)
				inc	hl
				
; Check control byte
				bit	7,a
				jp	nz,ProcessControlByte
				
				ld	b,a
				
; Mix Left Volume
				and	$0F
				ld	e,a
				ld	d,(ix+O_PAT_VOL_L)
				call	MixVolume
				ld	(ix+O_VOL_L),a
				
; Initialize flags to 0
				ld	a,0
				
; Check if noise is enabled (STMF: 1 = Enabled)
				bit	6,b
				jr	z,SkipNoiseFlag		; If 0, skip enabling
				set	1,a			; If 1, set Noise flag
	SkipNoiseFlag:		
				ld	(ix+O_FLAGS),a
				
; Skip noise freq update if disabled
				bit	1,a
				jr	z,ReadByte2
				
; Update Noise Frequency
				ld	a,b
				and	$30
				rrca
				rrca
				rrca
				rrca
				ld	e,a
				
				ld	a,(VAR_CH_IDX)
				cp	3
				jr	nc,HandleGen2
				
				ld	a,(VAR_SAA_NOISE_FREQ)
				and	$FC
				or	e
				ld	(VAR_SAA_NOISE_FREQ),a
				jr	ReadByte2
				
	HandleGen2:		
				ld	a,e
				add	a,a
				add	a,a
				add	a,a
				add	a,a
				ld	e,a
				ld	a,(VAR_SAA_NOISE_FREQ)
				and	$CF
				or	e
				ld	(VAR_SAA_NOISE_FREQ),a
				
	ReadByte2:		
; Read Byte 2
				ld	a,(hl)
				inc	hl
				ld	b,a
				
; Mix Right Volume
				and	$0F
				ld	e,a
				ld	d,(ix+O_PAT_VOL_R)
				call	MixVolume
				ld	(ix+O_VOL_R),a
				
; Check if tone is enabled (STMF: 1 = Enabled)
				bit	7,b
				jr	z,SkipToneFlag		; If 0, skip enabling
				ld	a,(ix+O_FLAGS)
				or	1			; Set Tone flag safely via register ops
				ld	(ix+O_FLAGS),a
	SkipToneFlag:		
				
; Calculate Octave Offset
				ld	a,b
				and	$70
				rrca
				rrca
				rrca
				rrca
				bit	2,a
				jr	z,PositiveOctave
				or	$F8
	PositiveOctave:		
				ld	(ix+O_FREQ_OFFSET_H),a
				
; Read Byte 3 (Frequency Fine-tune)
				ld	a,(hl)
				inc	hl
				ld	(ix+O_FREQ_OFFSET_L),a
				
; CRITICAL: Update pointer after inner loop!
				ld	(ix+O_SAMP_PTR_L),l
				ld	(ix+O_SAMP_PTR_H),h
				ret
				
	ProcessControlByte:	
				cp	$80
				jr	z,SavePointer
; Check if in release phase: released sample skips loop-back, continues into release section
; NOTE: Must use ld b,a / ld a,b (NOT push/pop af) to preserve the Z flag from 'or a'.
; pop af would restore old flags from cp $80, making jp nz always branch (loop-back dead code).
				ld	b,a			; Save ctrl byte (ld does not affect flags)
				ld	a,(ix+O_RELEASED)
				or	a			; Z=0 if released, Z=1 if not released
				ld	a,b			; Restore ctrl byte (ld does not affect Z flag)
				jp	nz,ReadSample		; Released: continue forward past loop ctrl byte
; Control Loop (normal: not in release)
				and	$7F
				ld	e,a
				ld	a,128
				sub	e			; A = 128 - N
				ld	l,a
				ld	h,0			; HL = 128 - N
				ld	e,l
				ld	d,h			; DE = 128 - N
				add	hl,hl			; HL = (128 - N) * 2
				add	hl,de			; HL = (128 - N) * 3
				ld	e,l
				ld	d,h			; DE = jump back offset
				
				ld	l,(ix+O_SAMP_PTR_L)
				ld	h,(ix+O_SAMP_PTR_H)
				sub	a			; Clear carry (A=0, C=0)
				sbc	hl,de			; HL = new position
; Save new position
				ld	(ix+O_SAMP_PTR_L),l
				ld	(ix+O_SAMP_PTR_H),h
				jp	ReadSample
				
	SavePointer:		
; End-of-sample ($80): stop sample playback.
; JS player marks the channel as no longer playing once the sample reaches its
; end, so keeping the pointer on $80 would incorrectly sustain the last frame.
				xor	a
				ld	(ix+O_SAMP_PTR_L),a
				ld	(ix+O_SAMP_PTR_H),a
				ld	(ix+O_VOL_L),a
				ld	(ix+O_VOL_R),a
				ld	(ix+O_FLAGS),a
				ret
				
; ===========================================================================
; UpdateSAA_Registers
; ===========================================================================
	UpdateSAA_Registers:	
				xor	a
				ld	(VAR_SAA_OCTAVES),a
				ld	(VAR_SAA_OCTAVES+1),a
				ld	(VAR_SAA_OCTAVES+2),a
				ld	(VAR_SAA_FREQ_EN),a
				ld	(VAR_SAA_NOISE_EN),a
				
				ld	ix,CH_DATA
				ld	de,5 * CH_STRUCT_SIZE
				add	ix,de
				ld	b,6
				ld	c,5
				
	RegLoop:		
				push	bc
				ld	a,c
				ld	(VAR_CH_IDX),a
				ld	l,(ix+O_SAMP_PTR_L)
				ld	h,(ix+O_SAMP_PTR_H)
				ld	a,h
				or	l
				jp	z,SilentChannel
				
				ld	a,(ix+O_NOTE)
				or	a
				jr	z,HandleDecay
				
    ; --- NEW NOTE TRIGGER ---
				dec	a
				ld	l,a
				ld	h,0
				
				ld	a,(ix+O_POS_TRANSPOSE)
				ld	e,a			; E = low byte
				add	a,a
				sbc	a,a
				ld	d,a			; D = sign extension
				add	hl,de
				
				ld	a,l
				ld	(ix+O_ACT_NOTE),a	; SAVE BASE NOTE (Note + Transpose ONLY)
				jr	ApplyOrnament
				
	HandleDecay:		
				ld	a,(ix+O_ACT_NOTE)	; Load base note
				ld	l,a
				ld	h,0
				
	ApplyOrnament:		
    ; --- ADD ORNAMENT DYNAMICALLY EVERY TICK ---
				ld	a,(ix+O_ORN_OFFSET)
				ld	e,a			; E = low byte
				add	a,a
				sbc	a,a
				ld	d,a			; D = sign extension
				add	hl,de
				
    ; Clamp 0 to 95
				bit	7,h
				jr	z,NoteNotNeg
				ld	hl,0
				jr	NoteClamp
	NoteNotNeg:		
				ld	a,h
				or	a
				jr	nz,NoteOver
				ld	a,l
				cp	96
				jr	c,NoteClamp
	NoteOver:		
				ld	hl,95
	NoteClamp:		
				ld	e,l			; E = Final note for table lookup
				
	GetFreq:		
				ld	a,e
				call	GetFreqWordFromNote
				
; --- Channel Bit Mask (CRITICAL FOR SOUND) ---
				ld	a,c
				ld	h,1
				or	a
				jr	z,MaskDone
	MaskLoop:		
				sla	h
				dec	a
				jr	nz,MaskLoop
	MaskDone:		
				ld	a,(ix+O_FLAGS)
				bit	0,a
				jr	z,NoToneBit
				
				ld	a,(VAR_SAA_FREQ_EN)
				or	h
				ld	(VAR_SAA_FREQ_EN),a
				
	NoToneBit:		
				ld	a,(ix+O_FLAGS)
				bit	1,a
				jr	z,NoNoiseBit
				
				ld	a,(VAR_SAA_NOISE_EN)
				or	h
				ld	(VAR_SAA_NOISE_EN),a
				
	NoNoiseBit:		
				
; --- ENVELOPE RETRIGGER ---
				ld	a,(ix+O_CMD)
				cp	$08
				jr	z,EnvRetrigDone		; Delay sample keeps trigger pending until start
				ld	a,(ix+O_NOTE_TRIG)
				or	a
				jr	z,EnvRetrigDone
				ld	(ix+O_NOTE_TRIG),0	; Clear trigger flag
				
				ld	a,c
				cp	3
				jr	nc,RetrigEG1
				
				ld	a,(VAR_EG0_SHAPE)
				or	a
				jr	z,EnvRetrigDone		; Do not trigger if EG is disabled
				ld	l,e			; Preserve frequency and octave across EG write
				ld	e,a
				ld	a,$18
				call	WriteSAA_Reg
				ld	e,l			; Restore frequency and octave
				jr	EnvRetrigDone
				
	RetrigEG1:		
				ld	a,(VAR_EG1_SHAPE)
				or	a
				jr	z,EnvRetrigDone		; Do not trigger if EG is disabled
				ld	l,e			; Preserve frequency and octave across EG write
				ld	e,a
				ld	a,$19
				call	WriteSAA_Reg
				ld	e,l			; Restore frequency and octave
				
	EnvRetrigDone:		
				
	; --- Apply 11-bit combined pitch shift ---
				ld	a,e			; A = Base frequency
				add	a,(ix+O_FREQ_OFFSET_L)	; Add low byte shift
				ld	e,a			; E = New frequency
				
				ld	a,d			; A = Base octave
				adc	a,(ix+O_FREQ_OFFSET_H)	; Add high byte shift (sign extended) + carry
				ld	d,a
				ld	a,e
				add	a,(ix+O_CMD_SHIFT_L)
				ld	e,a
				ld	a,d
				adc	a,(ix+O_CMD_SHIFT_H)
				and	$07			; Wrap octave to 0-7
				
	OctOk:			
				ld	d,a			; D = final valid octave
				
	SilentWrite:		
	FreqDone:		
; --- Write Frequency ($08-$0D for channels 0-5) ---
				ld	a,c
				add	a,8
				call	WriteSAA_Reg
				
; --- Write Volume ($00-$05 for channels 0-5) ---
; Stereo: pack right vol into upper nibble, left vol into lower nibble (RRRRLLLL)
				ld	a,(ix+O_VOL_R)
				add	a,a
				add	a,a
				add	a,a
				add	a,a			; A = VolR << 4
				or	(ix+O_VOL_L)		; A = (VolR << 4) | VolL
				ld	e,a
				
				ld	a,c			; A = channel index
				call	WriteSAA_Reg
				
; --- Save Octave to VAR_SAA_OCTAVES ---
				push	hl
				ld	a,c
				srl	a
				ld	hl,VAR_SAA_OCTAVES
				add	a,l
				ld	l,a
				jr	nc,NoCarryOct
				inc	h
	NoCarryOct:		
				ld	a,c
				and	1
				jr	nz,UpperNibble
				ld	a,(hl)
				and	$F0
				or	d
				ld	(hl),a
				jr	OctSaveDone
				
	SilentChannel:		
				xor	a
				ld	(ix+O_VOL_L),a
				ld	(ix+O_VOL_R),a
				ld	(ix+O_FLAGS),a
				ld	e,a
				ld	d,a
				jp	SilentWrite
				
; ===========================================================================
; Input: A = zero-based note index (0-95)
; Output: E = frequency byte, D = octave
; Uses: AF, B, DE, HL
; Looks up the 12-note low-byte table and derives octave in code.
; B wraps into the next octave, B-8 is clamped to the highest valid value.
; ===========================================================================
	GetFreqWordFromNote:	
				ld	b,0			; B = octave base
	FreqOctaveLoop:		
				cp	12
				jp	c,FreqClassReady
				sub	12
				inc	b
				jp	FreqOctaveLoop
	FreqClassReady:		
				ld	e,a
				ld	d,0
				ld	hl,FREQ_TABLE
				add	hl,de
				ld	e,(hl)			; E = class frequency byte
				ld	d,b			; D = octave base
				ld	a,e
				cp	$05			; B note wraps into next octave
				ret	nz
				inc	d
				ld	a,d
				cp	8
				ret	c
				ld	e,$F3			; Clamp B-8 to the highest valid table value
				ld	d,7
				ret
	UpperNibble:		
				ld	a,d
				add	a,a
				add	a,a
				add	a,a
				add	a,a
				ld	b,a
				ld	a,(hl)
				and	$0F
				or	b
				ld	(hl),a
	OctSaveDone:		
				pop	hl
				
	NextCh:			
				ld	de,$FFDB		; -CH_STRUCT_SIZE
				add	ix,de
				pop	bc
				dec	c
				dec	b
				jp	nz,RegLoop
				
; --- Global Flush: write octave, freq-enable, noise-enable, noise-freq ---
				ld	hl,VAR_SAA_OCTAVES
				ld	a,$10
				ld	e,(hl)
				call	WriteSAA_Reg
				inc	hl
				ld	a,$11
				ld	e,(hl)
				call	WriteSAA_Reg
				inc	hl
				ld	a,$12
				ld	e,(hl)
				call	WriteSAA_Reg
				
				ld	a,(VAR_SAA_FREQ_EN)
				ld	e,a
				ld	a,$14
				call	WriteSAA_Reg
				
				ld	a,(VAR_SAA_NOISE_EN)
				ld	e,a
				ld	a,$15
				call	WriteSAA_Reg
				
				ld	a,(VAR_SAA_NOISE_FREQ)
				ld	e,a
				ld	a,$16
				call	WriteSAA_Reg
				ret
				
; ===========================================================================
; ProcessOrnament
; ===========================================================================
	ProcessOrnament:	
				ld	a,(ix+O_ORN_NUM)
				or	a
				jr	z,NoOrn
				
; --- Cmd $06/$08: suppress ornament output during countdown ---
				ld	a,(ix+O_CMD)
				cp	$06
				jr	z,NoOrn
				cp	$08
				jr	z,NoOrn
				
				ld	l,(ix+O_ORN_PTR_L)
				ld	h,(ix+O_ORN_PTR_H)
				
; Check for zero (unresolved or empty) ornament pointer
				ld	a,h
				or	l
				jr	z,NoOrn
				
	ReadOrn:		
				ld	a,(hl)
				inc	hl
				
				bit	7,a			; bit7=1 means ornament controller
				jr	nz,HandleOrnCtrl
				
				bit	6,a			; 7-bit signed to 8-bit signed extension
				jr	z,SaveOrnData
				or	$80
	SaveOrnData:		
				ld	(ix+O_ORN_OFFSET),a
				
	SaveOrnPtr:		
				ld	(ix+O_ORN_PTR_L),l
				ld	(ix+O_ORN_PTR_H),h
				ret
				
	HandleOrnCtrl:		
				and	$7F
				jr	z,OrnEnd		; $80 = end of ornament
				
; Loop controller: back = (128 - ctrlValue)
; Note: HL is reloaded from O_ORN_PTR (points to ctrl byte), so no +1 needed
				ld	e,a
				ld	a,128
				sub	e
				ld	e,a
				ld	d,0
				
				ld	l,(ix+O_ORN_PTR_L)
				ld	h,(ix+O_ORN_PTR_H)
				sub	a			; Clear carry (A=0, C=0)
				sbc	hl,de
				
	SaveOrnLoopPtr:		
				ld	(ix+O_ORN_PTR_L),l
				ld	(ix+O_ORN_PTR_H),h
				jr	ReadOrn
				
	OrnEnd:			
				dec	hl			; Keep pointer on end controller ($80)
				ld	(ix+O_ORN_PTR_L),l
				ld	(ix+O_ORN_PTR_H),h
				ret
				
	NoOrn:			
				ld	(ix+O_ORN_OFFSET),0
				ret
				
; ===========================================================================
; WriteSAA_Reg: A = register, E = data
; ===========================================================================
	WriteSAA_Reg:		
				out	(SAA_ADDR_PORT),a
				ld	a,e
				out	(SAA_DATA_PORT),a
				ret
				
; ===========================================================================
; ResetSAA
; ===========================================================================
	ResetSAA:		
				ld	a,$1C
				out	(SAA_ADDR_PORT),a
				ld	a,$02
				out	(SAA_DATA_PORT),a
				
				ld	d,0
	ClearSAA:		
				ld	a,d
				out	(SAA_ADDR_PORT),a
				xor	a
				out	(SAA_DATA_PORT),a
				inc	d
				ld	a,d
				cp	32
				jr	nz,ClearSAA
				
				ld	a,$1C
				out	(SAA_ADDR_PORT),a
				ld	a,$01
				out	(SAA_DATA_PORT),a
				ret
				
; ===========================================================================
; Frequency Table Low Bytes (C-x to B-x)
; Octave is derived in code, B advances to the next octave.
; ===========================================================================
	FREQ_TABLE:		
				db	$21, $3C, $55, $6D, $84, $99, $AD, $C0, $D2, $E3, $F3, $05; C-x to B-x
				
;--------------------------------------------------------------------------------------------------------------------------------------   
; ZX7_DECOMPRESS - HL: Compressed data, DE: Target address
				
	ZX7_DECOMPRESS						;di    ; disable interrupts               
	DZX7STANDARD		ld	A,$80
	COPYBYTELOOPEV		ldi				; copy literal byte
	MAINLOOPEV		add	A,A			; check next bit
				jr	Z,LOADBITS1		; no more bits left?
				jr	C,LENSIZESTARTOD	; next bit indicates either literal or sequence
				
	COPYBYTELOOPOD		ldi				; copy literal byte
	MAINLOOPOD		add	A,A			; check next bit
				jr	NC,COPYBYTELOOPEV	; next bit indicates either literal or sequence
				
	               ; determine number of bits used for length (Elias gamma coding)
	LENSIZESTARTEV		push	DE
				ld	BC,1
				ld	D,B
	LENSIZELOOPEV		inc	D
				add	A,A			; check next bit
				jr	Z,LOADBITS2EV		; no more bits left?
				jr	NC,LENSIZELOOPEV
				jr	LENVALUESTARTEV
				
	               ; determine number of bits used for length (Elias gamma coding)
	LENSIZESTARTOD		push	DE
				ld	BC,1
				ld	D,B
	LENSIZELOOPOD		inc	D
				add	A,A			; check next bit
				jr	Z,LOADBITS2OD		; no more bits left?
				jr	NC,LENSIZELOOPOD
				jr	LENVALUESTARTOD
				
	               ; determine length
	LENVALUELOOPEV		add	A,A			; check next bit
				jr	Z,LOADBITS3EV		; no more bits left?
				rl	C
				rl	B
				jr	C,EXITEV		; check end marker
	LENVALUESTARTEV		dec	D
				jr	NZ,LENVALUELOOPEV
				inc	BC			; adjust length
				
				   ; determine offset                           
	OFFSETSTARTOD		ld	E,(HL)			; load offset flag (1 bit) + offset value (7 bits)
				inc	HL
				sll	E			; opcode for undocumented instruction "SLL E" aka "SLS E"
				jr	NC,OFFSETENDOD		; if offset flag is set,load 4 extra bits
				add	A,A			; check next bit
				rl	D			; insert first bit into D
				add	A,A			; check next bit
				jr	Z,LOADBITS4		; no more bits left?
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				jr	Z,LOADBITS5		; no more bits left?
				ccf
				jr	C,OFFSETENDOD
	OFFSETINCOD		inc	D			; equivalent to adding 128 to DE
	OFFSETENDOD		rr	E			; insert inverted fourth bit into E
				
	               ; copy previous sequence
				ex	(SP),HL			; store source,restore destination
				push	HL			; store destination
				sbc	HL,DE			; HL = destination - offset - 1
				pop	DE			; DE = destination
				ldir
				pop	HL			; restore source address (compressed data)
				jr	MAINLOOPOD
				
	LOADBITS1		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jr	C,LENSIZESTARTOD	; next bit indicates either literal or sequence
				jr	COPYBYTELOOPOD
				
	LOADBITS2EV		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jr	NC,LENSIZELOOPEV
				jr	LENVALUESTARTEV
				
	LOADBITS2OD		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jr	NC,LENSIZELOOPOD
				jr	LENVALUESTARTOD
				
	LOADBITS3EV		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	C
				rl	B
				jp	NC,LENVALUESTARTEV	; check end marker
	EXITEV			pop	DE
				ret
				
	LOADBITS4		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jr	C,OFFSETENDOD
				jr	OFFSETINCOD
				
	LOADBITS5		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				ccf
				jr	C,OFFSETENDOD
				jr	OFFSETINCOD
				
	               ; determine length
	LENVALUELOOPOD		add	A,A			; check next bit
				jr	Z,LOADBITS3OD		; no more bits left?
				rl	C
				rl	B
				jr	C,EXITOD		; check end marker
	LENVALUESTARTOD		dec	D
				jr	NZ,LENVALUELOOPOD
				inc	BC			; adjust length                              
				
	               ; determine offset
	OFFSETSTARTEV		ld	E,(HL)			; load offset flag (1 bit) + offset value (7 bits)
				inc	HL
				sll	E			; opcode for undocumented instruction "SLL E" aka "SLS E"
				jr	NC,OFFSETENDEV		; if offset flag is set,load 4 extra bits
				add	A,A			; check next bit
				jr	Z,LOADBITS6		; no more bits left?
				rl	D			; insert first bit into D
				add	A,A			; check next bit
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				jr	Z,LOADBITS7		; no more bits left?
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jr	C,OFFSETENDEV
	OFFSETINCEV		inc	D			; equivalent to adding 128 to DE
	OFFSETENDEV		rr	E			; insert inverted fourth bit into E
				
	               ; copy previous sequence
				ex	(SP),HL			; store source,restore destination
				push	HL			; store destination
				sbc	HL,DE			; HL = destination - offset - 1
				pop	DE			; DE = destination
				ldir
				pop	HL			; restore source address (compressed data)
				jp	MAINLOOPEV
				
	LOADBITS3OD		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	C
				rl	B
				jr	NC,LENVALUESTARTOD	; check end marker
	EXITOD			pop	DE
				ret
				
	LOADBITS6		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	D			; insert first bit into D
				add	A,A			; check next bit
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jr	C,OFFSETENDEV
				jr	OFFSETINCEV
				
	LOADBITS7		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jr	C,OFFSETENDEV
				jr	OFFSETINCEV
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------   
; CRTC routines
;--------------------------------------------------------------------------------------------------------------------------------------   								
	CRTC_ENABLE		ld	A,1			; CRTC enable screen
				out	(112),A
				ld	A,64
				out	(113),A
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------   
; ASSETS
;--------------------------------------------------------------------------------------------------------------------------------------   
	TEXT_1:			db	19, "           SAA 1099"
	TEXT_0:			db	22, "         STMF PLAYING:"
	TEXT00:			db	27, "     (C) 2026 by Fast&Force"
				
	TEXT01:			db	"            Lyra-III           É"
	TEXT02:			db	"Á   Orava-II-Chipmunks-d.r.    É"
	TEXT03:			db	"Á   Beat-to-the-pulp-RetroKo   É"
	TEXT04:			db	"Á   Arcane-Zone-Part-2-ZX-AA   É"
	TEXT05:			db	"Á     Celebrate-Demo-music     É"
	TEXT06:			db	"Á       High-Color-2018         "
				
	GREETING_TEXT1		db	"Vass Sándor  Multichip Soundcard",0
	GREETING_TEXT2		db	"  Grósz Attila WinTVC emulator",0
	GREETING_TEXT3		db	"    Kiss Károly Image to TVC",0
	GREETING_TEXT4		db	"Geco, Doberdo Brothers, BerySoft",0
	GREETING_TEXT5		db	" AnyStone, Murphy, Orosz Olivér",0
				
	GREETING_PTRS		dw	GREETING_TEXT1
				dw	GREETING_TEXT2
				dw	GREETING_TEXT3
				dw	GREETING_TEXT4
				dw	GREETING_TEXT5
				
				
	PIC_MAIN_ZX7:		incbin	"pic-main.zx7"
	PIC_GREETINGS_ZX7:	incbin	"greetings_4c.bin.zx7"
				
;******************************************************************
; Draw characters
; precondition: VID page is at $8000 
;******************************************************************
	SCREEN_WIDTH		equ	64			; képernyő szélessége bájtokban			
	END_OF_TEXT		equ	255			; ez a kód jelzi a szöveg végét
	CHAR_SET_IMAGE_WIDTH	equ	192			; karakterkészlet image szélessége bájtokban
	CHAR_SET_IMAGE_HEIGHT	equ	10			; karakterkészlet image magassága pixelekben			
				
	CHAR_HEIGHT		db	0
	VRAM_POSITION		dw	$8000
				
	INIT_CHARSET		
				ld	A,$B0			; lapozási kód: U0, U1, U2, U3
				out	($02),a			; Belapozás
				ld	hl,CHAR_SET_SRC		; SOURCE: U2
				ld	de,CHAR_SET		; DESTINATION: U3
				call	ZX7_DECOMPRESS
				ret
				
				
	RST30DB3		dec	b			; can be called replacing rst $30 with db $3
				sla	b			; x2 for 4 color mode
				dec	c			; see TVC ROM manual page 176
				ld	a,c
				add	a,a
				add	a,a
				add	a,c
				add	a,a
				ld	h,a
				xor	a
				srl	h
				rra
				scf
				rr	h
				rra
				or	b
				ld	l,a			; HL = $8000 + (sor * 10) * 64 + oszlop
				ld	(VRAM_POSITION),hl
				ret
				
	RST30DB2		ld	(WRITE_TEXT+1),de	; can be called replacing rst $30 with db $2
				ld	de,(VRAM_POSITION)
				
				;{ ---------- WRITE_TEXT
				; from TVC lemezújság tech demo - (c) Bertók Zsolt, BerySoft - 2023
                              	; szöveg kiírása saját karakterkészlettel
                              	; paraméterek: 	DE -> képernyő (VRAM) pozíció; 
				; 		(WRITE_TEXT+1) <- a szöveg címe
				; hasznája AF, BC, DE, HL
	WRITE_TEXT		ld	A,(0)			; A = a szöveg karaktere
				or	A			; A == 0?
				ret	z			; Ha A = 0, akkor ez a sor vége, visszatérünk a hívóhoz
				cp	END_OF_TEXT		; A = END_OF_TEXT?
				ret	z			; Ha A = END_OF_TEXT, akkor ez a szöveg vége, visszatérünk a hívóhoz
				ld	HL,CHAR_SET		; HL -> CHAR_SET image
				;{ karakter típusának elemzése
				cp	32			; a karakter alacsonyabb kódú, mint a szóköz?
				jp	c,WRITE_TEXT_SKIP_CHAR	; ha igen, akkor nem írjuk ki
				cp	58			; kisebb, mint a 9 utáni karakter?
				jr	c,WRITE_TEXT_SPACE_TO_9	; ha igen, akkor szóköztől és 9 közötti karakter
				cp	"["			; Z vagy kisebb karakter
				jr	c,WRITE_TEXT_A_Z	; ha igen, akkor kiírjuk
				cp	123			; kisebb, mint a "z" utáni karakter?
				jr	c,WRITE_TEXT_SMALL_A_Z	; ha igen, akkor kiírjuk
				cp	144			; 144 az "á" betű kódja
				jr	nc,WT_SMALL_ACCENTED_A_Z; ha A >= 144, akkor ugrás a kis ékezetes betűk kiírására
				;}
                              	;{ nagy ékezetes karakterek - Á,É,Í,Ó,Ö,Ő,Ú,Ü,Ű				
				cp	137			; 137 az "Ű" betű utáni karakter kódja
				jr	nc,WRITE_TEXT_SKIP_CHAR	; ha A >= 137, akkor nem írjuk ki a karaktert
				ld	BC,(16+10+26+26)*2	; a SPACE-"/","0"-"9","A"-"Z","a"-"z" karaktereket átlépjük
				add	HL,BC			; HL az "Á" betű képdarabjára mutat			
				push	af
				ld	a,CHAR_SET_IMAGE_HEIGHT-2; ennyi pixel magas egy karakter (nagy ékezetes betűknél az utolsó 2 sor üres)
				ld	(CHAR_HEIGHT),a
				pop	af
				sub	128			; a kiírandó karakter kódjából kivonjuk az "Á" betű kódját
				jr	Z,WRITE_TEXT_CHAR	; ha nulla a végeredmény, akkor ez egy "Á" betű, mivel éppen arra mutat HL, ugrás a kiírására
				jr	WT_SET_CHAR_ADDR	; ha nem, akkor kiszámoljuk az aktuális ékezetes karakter kezdő címét a CHARSET-ben     
				;}
				;{ kis ékezetes karakterek - á,é,í,ó,ö,ő,ú,ü,ű
	WT_SMALL_ACCENTED_A_Z	cp	153			; 153 az "ű" betű utáni karakter kódja
				jp	nc,WRITE_TEXT_SKIP_CHAR	; ha A >= 153, akkor nem írjuk ki a karaktert
				ld	BC,(16+10+26+26+9)*2	; a SPACE-'/","0"-"9","A"-"Z","a"-"z","Á"-"Ű" karaktereket átlépjük
				add	HL,BC			; HL az "á" betű képdarabjára mutat
				push	af
				ld	a,CHAR_SET_IMAGE_HEIGHT-2; ennyi pixel magas egy karakter (kis ékezetes betűknél az utolsó 2 sor üres)
				ld	(CHAR_HEIGHT),a
				pop	af
				sub	144			; a kiírandó karakter kódjából kivonjuk az "á" betű kódját
				jr	Z,WRITE_TEXT_CHAR	; ha nulla a végeredmény, akkor ez egy "á" betű, mivel éppen arra mutat HL, ugrás a kiírására
				jr	WT_SET_CHAR_ADDR	; ha nem, akkor kiszámoljuk az aktuális ékezetes karakter kezdő címét a CHARSET-ben
				;}
				;{ SPACE-"/" + "0"-"9"
	WRITE_TEXT_SPACE_TO_9	push	af
				ld	a,CHAR_SET_IMAGE_HEIGHT-1; ennyi pixel magas egy karakter (szóköztől a nagy "9"-ig az utolsó 1 sor üres)
				ld	(CHAR_HEIGHT),a
				pop	af
				sub	32			; a kiírandó karakter kódjából kivonjuk a szóköz kódját
				jr	Z,WRITE_TEXT_CHAR	; ha nulla a végeredmény, akkor ez egy "a", mivel éppen arra mutat HL, ugrás a kiírására
				jr	WT_SET_CHAR_ADDR	; ha nem nulla, akkor ugrás a karakter kezdőcímének kiszámolására
				;}				
				;{ A-Z-ig karakterek
	WRITE_TEXT_A_Z		cp	"A"			; "A" betűnél kisebb kód?
				jr	c,WRITE_TEXT_SKIP_CHAR	; ha igen, akkor nem írjuk ki a karaktert
				ld	BC,(16+10)*2		; a SPACE-'/","0"-"9" karaktereket átlépjük
				add	HL,BC			; HL az "á" betű képdarabjára mutat
				push	af
				ld	a,CHAR_SET_IMAGE_HEIGHT-1; ennyi pixel magas egy karakter (az utolsó 1 sor üres)
				ld	(CHAR_HEIGHT),a
				pop	af
				sub	"A"			; a kiírandó karakter kódjából kivonjuk az "A" betű kódját
				jr	Z,WRITE_TEXT_CHAR	; ha nulla a végeredmény, akkor ez egy "A" betű, mivel éppen arra mutat HL, ugrás a kiírására
				jr	WT_SET_CHAR_ADDR	; ha nem nulla, akkor ugrás a karakter kezdőcímének kiszámolására
				;}
				;{ kis a-z karakterek
	WRITE_TEXT_SMALL_A_Z	ld	BC,(16+10+26)*2		; a SPACE-"/","0"-"9","A"-"Z" karaktereket átlépjük
				add	HL,BC			; HL -> "a"
				push	af
				ld	a,CHAR_SET_IMAGE_HEIGHT	; ennyi pixel magas egy karakter (p, q, y teljesen leér a 10. sorig)
				ld	(CHAR_HEIGHT),a
				pop	af
				sub	"a"			; a kiírandó karakter kódjából kivonjuk az "a" kódját
				jr	Z,WRITE_TEXT_CHAR	; ha nulla a végeredmény, akkor ez egy "a", mivel éppen arra mutat HL, ugrás a kiírására				
				;}
				;{ a karakter kezdőcímének kiszámolása a karakterkészlet image-ben
	WT_SET_CHAR_ADDR	add	A,A			; A = A * 2 -> 1 karakter 2 byte
				ld	C,A
				ld	B,0			; BC = A * 2
				add	HL,BC			; HL a karakter első sorának első byte-jára mutat a karakterkészlet image-ben
				;}
                              	;{ egy karakter kiírása (DE: képernyő (VRAM) pozíció; HL: karakter image cím; C: karakter magasság pixelben)
	WRITE_TEXT_CHAR		push	DE			; karakter képernyő (VIDEORAM) pozíciójának elrakása a STACK-re                              
				ld	A,(CHAR_HEIGHT)		; ennyi pixel magas egy karakter
	WRITE_TEXT_CHAR_LOOP	ld	BC,CHAR_SET_IMAGE_WIDTH	; ennyi byte széles a karakterkészletett tartalmazó image
				ldi
				ldi
				add	HL,BC			; HL -> következő sor a karakterkészletben
				ex	DE,HL
				ld	BC,SCREEN_WIDTH-2	; következő sorig ennyit kell lépni a képernyőn (a -2 a kirakott karakter egy sora)
				add	HL,BC
				res	6,H			; Ha a 6. bit 1, akkor 48K fölé ért a címzés, ezért azt töröljük, így mindig 32K-48K között lesz HL értéke
				;set	7,H			; Beállítjuk a 7. bitet, hogy HL értéke ne kerülhessen 32K alá a csökkentés következtében, így nem megy a VIDEORAM alá a címzés
				ex	DE,HL			; DE: a következő sorra mutat a képernyőn
				dec	A			; kirakandó sorok csökkentése
				jr	NZ,WRITE_TEXT_CHAR_LOOP	; ha nem nulla, akkor ugrás a folytatásra                              
				pop	DE			; a most kirakott karakter képernyő (VRAM) pozíciójának előszedése a STACK-ről
				;}
                              	;{ a szöveg következő karakterére lépés
	WRITE_TEXT_NEXT_CHAR	inc	DE			; egy karakternyi (2 byte)
				inc	DE			; hely átlépése a képernyőn
	WRITE_TEXT_SKIP_CHAR	ld	hl,(WRITE_TEXT+1)	; 16-bit text pointer advance (handles page boundary)
				inc	hl
				ld	(WRITE_TEXT+1),hl
				jp	WRITE_TEXT		; ugrás a kiírás elejére
				;}
				ret
                              	;} end of WRITE_TEXT
				
;-------------------------------------------------------------------------				
				org	$6000
	TEX4K			ds	8192
				
	TEXTURE_ZX7:		incbin	"texture8k.bin.zx7"
				
;--------------------------------------------------------------------------------------------------------------------------------------   
; SET CHARACTER
;--------------------------------------------------------------------------------------------------------------------------------------   
	SET_CHARACTER:		call	INIT_CHARSET
				call	INIT_TEXTURE
				ld	hl,CHARDEF1
				ld	de,$0740
				ld	bc,20			; 2x10 = two characters (Á and É) are redefined
				ldir
				ret
	CHARDEF1:		db	8,24,56,127,255,255,127,56,24,8
	CHARDEF2:		db	16,24,28,254,255,255,254,28,24,16
				
	CRTC_DISABLE		ld	A,1			; CRTC disable screen
				out	(112),A
				ld	A,0
				out	(113),A
				ret
;-------------------------------------------------------------------------				
	INIT_TEXTURE:		
				ld	HL,TEXTURE_ZX7		; HL-be a tömörített kezdőképernyő memóriacíme                                                                
				ld	DE,TEX4K		; DE-be a célmemória címe
				call	ZX7_DECOMPRESS		; Kép kitömörítése
				ret
;-------------------------------------------------------------------------				
				
	CHAR_SET		equ	$F0FF
				
	; CHAR_SET - 768x10 pixels; 384x10 byte; 96 karakter x 10 sor; 1 karakter: 2 byte x 10 pixel
	CHAR_SET_SRC		incbin	"charset.bin.zx7"
				
;-------------------------------------------------------------------------				
	MUSIC_BY_TEXT		equ	$0100
	MUSIC_BY_ZX7		incbin	"musicby.txt.zx7"
	INIT_MUSICBY:		
				ld	HL,MUSIC_BY_ZX7		; HL-be a tömörített kezdőképernyő memóriacíme                                                                
				ld	DE,MUSIC_BY_TEXT	; DE-be a célmemória címe
				call	ZX7_DECOMPRESS		; kitömörítés
				ret
;-------------------------------------------------------------------------
				
	FEATURES_TEXT		equ	$0100
	FEATURES_ZX7		incbin	"features_with0.bin.zx7"
	INIT_FEATURES:		
				ld	HL,FEATURES_ZX7		; HL-be a tömörített kezdőképernyő memóriacíme                                                                
				ld	DE,FEATURES_TEXT	; DE-be a célmemória címe
				call	ZX7_DECOMPRESS		; kitömörítés
				ret
				
;-------------------------------------------------------------------------							
	NUM_OF_MUSIC		equ	6
;--------------------------------------------------------------------------
				
	MUSIC_01_ZX7:		incbin	"Lyra III.bin.zx7"
	MUSIC_02_ZX7:		incbin	"Orava II Chipmunks deadly revenge.bin.zx7"
	MUSIC_03_ZX7:		incbin	"Beat-to-the-pulp-RetroKomp-Load-Error-2015-1-.bin.zx7"
	MUSIC_04_ZX7:		incbin	"Arcane-Zone-Part-2-ZX-AAA-Demo-Compo-2013-2-.bin.zx7"
	MUSIC_05_ZX7:		incbin	"Celebrate-Demo-music.bin.zx7"
	MUSIC_06_ZX7:		incbin	"High-Color-2018.bin.zx7"
				
;--------------------------------------------------------------------------				
	PIC_TVC40_ZX7		incbin	"pic_tvc40_faf.bin.zx7"
				
				nop
				
				