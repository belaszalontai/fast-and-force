
// Két konstans, de nem basic, hanem ezeket az tvc_xbas fordító beilleszti a hivatkozások helyére, így könnyebb módosítani
§picy=640
§picx=320
§main_music_records=2880
	
// Az xbas2cas.exe program ide be fog rakni egy 1. sort ami a szimbólumtáblát állítja be
// A tvc_xbas.exe fordító pedig ezért mindig 2-estől kezdi a basic sorok számozását

// 2126-ra cimzes a 160-as karakterre, a 159-est hasznalni tilos, innentől a $c a karakterek képeire mutat, másra ne használd!
// A nevet se változtasd meg, mert a fejléc így pontsan oda mutat ahova kell!
	tphi=peek(5927):tplo=peek(5926)
	poke5926,128-8:poke5927,8:dimc$*252
	poke5927,tphi:poke5926,tplo
//  A 153-as karaktert feltöltjük 255-el, elég gyakran használjuk és a tool is így van beállítva
	randomize:a=255:setcharacter153,a,a,a,a,a,a,a,a,a,a	

//////////////////////////////
// Innen kezdődik a program 
//////////////////////////////
	gosub §crtc_smooth_off
	highscore=0
	graphics4
	setpalette0,85,21,65:setborder0:setink1
	printAT1,3,"D I M E N S I O N    L O O P"	
	printAT2,6,"(C) 2025 by Fast&Force"	
	setink3
	printAT4,5,"100% PURE BASIC PROGRAM"
	printAT5,9,"NO ASSEMBLY CODE"
	printAT6,9,"NO SYSTEM CALLS"
	printAT7,2,"2 CHANNEL CONVERTED SID MUSIC"
	printAT8,4,"HORIZONTAL HARDWARE SCROLL"
	setink1
	printAT11,3,"MAKE THE BASIC GREAT AGAIN !"
	setink2
	printAT14,1,"_____ VIDEOTON TV COMPUTER _____"
	printAT15,1,"______ Z80 CPU (3,125MHz) ______"
	printAT16,1,"_________ 32K/64K RAM __________"
	printAT17,1,"__________ 6845 CRTC ___________"
	printAT18,1,"_ 1 channel HW sound generator _"
	printAT19,1,"____ 512x240pixel  2 colors ____"
	printAT20,1,"____ 256x240pixel  4 colors ____"
	printAT21,1,"____ 128x240pixel 16 colors ____"
	setink1
	printAT24,11,"PLEASE WAIT!";	
	gosub §crtc_on
	gosub §initdata
	
	// Főképernyő
	graphics4
	gosub §crtc_off
	setpalette0,21,1,65

	// Meghívjuk a kép kirajzolását
	gosub §drawpic

	setink3
	printAT7,3,"TŰRAKÉTÁDDAL FÉNYSEBESSÉGGEL"
	printAT8,3,"SZELED ÁT A GALAXIST, DE EGY"
	printAT9,5,"DIMENZIÓ HUROKBA KERÜLTÉL"
	printAT10,3,"ÉS HA NEM VIGYÁZOL, A SAJÁT"
	printAT11,5,"ŰRHAJÓDBA FOGSZ ÜTKÖZNI!"
	printAT12,1,"KERÜLD EL A CSILLAGOKAT, AMELYEK"
	printAT13,2,"BÁRHOL FELBUKKANHATNAK ELŐTTED."
	printAT14,1,"MINDEN ÜTKÖZÉS VÉGZETES DIMENZIÓ"
	printAT15,7,"ÖSSZEOMLÁSHOZ VEZET."
	printAT16,2,"SZABADULJ KI A TÉR FOGSÁGÁBÓL!"
	setink1
	printAT17,8,"IRÁNYÍTÁS: FEL, LE"
	setink1
	printAT21,6,"NYOMJ MEG EGY GOMBOT.."
	gosub §crtc_on
	gosub §fastmusic
§begin:	
	// RESET TIME counter High byte
	poke2846,0
	graphics16
	SETDELAY10:SETRATE1
	s=0:t=0:R=49152:B=1:SS=8004:SC=0
	
	// Prepare the dimension
	setink21:setstyle12:plot500+rnd(100),100+rnd(300);500+rnd(100),600+rnd(300)
		
	time_s=peek(2845)+peek(2846)*256
	
§gamemainloop:	
	SOUND PITCH 545+2*SC+(S AND3)*30,VOLUME1
	
	// Handling keyboard
	K$=INKEY$&" "
	IF ORD(K$)=5 then SS=(SS-64)and16383
	IF ORD(K$)=24 then SS=(SS+64)and16383
	IF ORD(K$)=32 then SS=SS and16383

	// Collision detection
	IF PEEK(R+SS+2)<>0 then goto §gameover

	// Alter hardware scroll
	s=s+1:IF S=256 then S=0:T=T+1
	out112,12:out113,T:out112,13:out113,s	
	
	// Alter stars
	b=b+1:IF B=65 then B=1
	pokeR+SS,255:pokeR+SS+1,255:pokeR+SS-2,0:SS=SS+1
	pokeR+h(b),0:h(b)=(h(b)+rnd(65))and16383:pokeR+h(b),rnd(255)or192
	
	// detect WIN
	SC=SC+1:if SC=1000 then goto §finish
	
	GOTO §gamemainloop
§finish:
	soundvolume0
	gosub §crtc_off
	goto §gon
§gameover:
	gosub §crtc_smooth_off_snd
§gon:
	out112,12:out113,0:out112,13:out113,0
	SOUNDVOLUME0
	GRAPHICS4
	setpalette0,21,1,65
	gosub §drawpic
	time_e=peek(2845)+peek(2846)*256
	if SC>highscore then highscore=SC
	if sc<1000 then goto §gon1
	setink1
	printAT15,2," __ _  _ ___       _,    _   " 
	printAT16,2,"/__|_)|_| | | ||  |_||  / \\|/" 
	setink3
	printAT17,2,"\\_|| \\| | | |_||__| ||__\\_/|\\"
§gon1:	
	setink2:printAT9,12,"TIME:",int((time_e-time_s)*20/1000)
	setink2:printAT10,11,"SCORE:",SC
	setink3:printAT11,6,"HIGH SCORE:",highscore
	setink1:printAT12,3,"MAXIMUM SCORE:",1000
	printAT21,7,"NYOMJ MEG EGY GOMBOT.."
	IF INKEY$ <> "" THEN goto§!
	gosub §crtc_on
	gosub §ssimusic
	goto §begin

	// MAIN music player with optimized fast code but large data
	// music: https://deepsid.chordian.net/?file=/GAMES/A-F/Asteroid_War.sid
	// Asteroids - Simon Moon - 1987 Kalisti Enterprises
§fastmusic:
	V=14:FOR I=1 TO §main_music_records STEP2:SOUND;PITCH SND(I),VOLUME14
	V=V-0.0523:IF V<4 THEN V=14
	IF INKEY$ <> "" THEN soundvolume0: return
	SOUND PITCH SND(I+1),VOLUMEINT(V),DURATION2
	NEXT:GOTO §fastmusic
	
	// HIGH SCORE music player with slow code but compressed data
	// music: https://deepsid.chordian.net/?file=/MUSICIANS/T/Taylor_Andy/Super_Space_Invaders.sid
	// Super Space Invaders - Andy Taylor - 1991 Domark
§ssimusic:
	restore §ssi_music_records
	FOR J=1 TO 16:READ MUS$:FOR I=1 TO 191 STEP2
	SOUND PITCH SND2(ORD(MUS$(I))-47),VOLUME10
	IF INKEY$ <> "" THEN soundvolume0: return
	SOUND PITCH SND2(ORD(MUS$(I+1))-47),VOLUME10
	NEXT:NEXT:GOTO §ssimusic

// Inicializáljuk az adatokat
§initdata:
	// clear non visible screen area
	fora=64512to65535:pokea,0:next
	// init random array
	dimh(64):fora=1to64:h(a)=rnd(16384):next
	// init main title music data
	DIM SND(§main_music_records):FOR A=1 TO 2880:READ SND(A):NEXT
	// init ssi music
	DIM SND2(78),MUS$*192
	restore §ssi_music_map
	FOR A=1 TO 78:READ SND2(A):NEXT
	return	
	
