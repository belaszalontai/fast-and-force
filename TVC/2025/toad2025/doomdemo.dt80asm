	FRQDEC0B		equ	114			; decrease freq const by 176
	FRQDEC0C		equ	115			; decrease freq const by 192
	FRQDEC0D		equ	116			; decrease freq const by 208
	FRQDEC0E		equ	117			; decrease freq const by 224
	FRQDEC0F		equ	118			; decrease freq const by 240
				
	ADSR00			equ	119			; volume ADSR 0 
