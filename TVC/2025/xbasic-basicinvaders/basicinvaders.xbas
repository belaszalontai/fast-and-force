
// Konstans, de nem basic, hanem ezeket az tvc_xbas fordító beilleszti a hivatkozások helyére, így könnyebb módosítani
§ROCKET_INIT_POS=54019

// Az xbas2cas.exe program ide be fog rakni egy 1. sort ami a szimbólumtáblát állítja be
// A tvc_xbas.exe fordító pedig ezért mindig 2-estől kezdi a basic sorok számozását

// 2126-ra cimzes a 160-as karakterre, a 159-est hasznalni tilos, innentől a $c a karakterek képeire mutat, másra ne használd!
// A nevet se változtasd meg, mert a fejléc így pontsan oda mutat ahova kell!
	tphi=peek(5927):tplo=peek(5926)
	poke5926,128-8:poke5927,8:dimc$*252
	poke5927,tphi:poke5926,tplo
// A 153-as karaktert feltöltjük 255-el, elég gyakran használjuk és a tool is így van beállítva
	randomize:a=255:setcharacter153,a,a,a,a,a,a,a,a,a,a	

//////////////////////////////
// Innen kezdődik a program 
//////////////////////////////
	// define spaceship
	setcharacter192,24,24,24,24,60,60,102,102,231,129
	// define alien
	setcharacter193,31,127,127,255,204,204,255,127,127,31
	setcharacter194,255,255,255,255,195,195,255,255,255,255
	setcharacter195,248,254,254,255,51,51,255,254,254,248
	//goto §game_begin

// TVC 40 screen
	i$=inkey$
	gosub §crtc_off
	graphics4
	setpalette0,85,21,17:setborder0:setink1
	gosub §drawpic40	
	setink1
	printAT10,2,"A 40 ÉVES VIDEOTON TV-COMPUTER"
	setink3
	printAT12,11,"TISZTELETÉRE"
	setink2
	printAT14,3,"FESZEGESSÜK A BASIC HATÁRAIT"
	setink1
	printAT19,3,"IN HONOR OF THE 40-YEAR-OLD"
	setink3
	printAT21,6,"VIDEOTON TV-COMPUTER"
	setink2
	printAT23,2,"LET'S PUSH THE LIMITS OF BASIC"
	gosub §crtc_on
	gosub §initdata_music
	gosub §normalmusicplayer40
 	
// main screen
	i$=inkey$
	gosub §crtc_off
	graphics4
	setpalette0,85,21,17:setborder0:setink1
	gosub §drawpic	
	setink3
	printAT6,5,"100% PURE BASIC PROGRAM"
	printAT7,9,"NO ASSEMBLY CODE"
	printAT8,9,"NO SYSTEM CALLS"
	printAT9,2,"2 CHANNEL CONVERTED SID MUSIC"
	printAT10,1,"MULTI DIRECTION HARDWARE SCROLL"
	setink1
	printAT13,3,"MAKE THE BASIC GREAT AGAIN!"
	setink2
	printAT16,6,"(C) 2025 by Fast&Force"
	printAT17,1,"original SID music by AndyTaylor"
	printAT18,6,"original game by TAITO"
	printAT19,4,"development is powered by"
	printAT20,7,"XBasic (BadCode64)"
	printAT21,5,"SIDDumpTvc (Fast&Force)"
	printAT22,5,"SIDDumpTvcGUI (KKS2003)"
	setink1
	printAT24,11,"PLEASE WAIT!";	
	gosub §crtc_on
	gosub §irq_off
	gosub §initdata
	gosub §irq_on
	setpalette0,85,20,17
	setink3
	printAT24,9,"PRESS ANY KEY..";
	gameover=0
	highscore=0
	score=0
	gosub §musicplayer
		
§game_begin:	
	score=0
	gosub §crtc_off
	gosub §irq_off
	graphics4
	setpalette0,85,68,17
	A=49152+4096-60

	// draw aliens
	x=20
	for i=1to5: x=x+144
		y=498:sz=1:gosub §draw_alien1
		y=368:gosub §draw_alien2
		y=248:gosub §draw_alien2
		y=128:sz=3:gosub §draw_alien3
	next i
	
	// setup initial HW scroll
	cp=1736
	out112,12:out113,int(cp/256):out112,13:out113,cp and 255
	gosub §crtc_on
	gosub §irq_on
	setrate1:setdelay1
	
	// init variables
	sxp=472  
	syp=628
	ofset=0
	setink 1
	move_count=1
	ms=14 
	dir=1
	i=1
	rp=§ROCKET_INIT_POS
	isr=0
	rio=0
	
§game_loop:
	mc=mc+1
	if (mc<ms) then goto §game_next1
	mc=1
	if dir=2 then if(cp=1729)or(cp=1601)or(cp=1473)or(cp=1345)or(cp=1217) then gosub §minigame
	// process alien movements
	SOUNDPITCH110,VOLUME1,DURATION2
	// Hide ship
	setink0:plot sxp+ofset+32, syp:print#0," "
	// Hide rocket
	poke rp,0  
	// Alter hardware scroll + ship position + missile position
	if dir=1 then rp=rp-1:sxp=sxp-16:cp=cp-1:i=i+1:if i=16 then i=1:dir=2:goto §game_next0
	if dir=2 then rp=rp+1:sxp=sxp+16:cp=cp+1:i=i+1:if i=16 then i=1:dir=3
	if dir=3 then rp=rp-128:rio=rio-512:syp=syp+32:cp=cp-128:dir=1:ms=ms-2:if cp<400 then goto §gameover
§game_next0:	
	out112,12:out113,int(cp/256):out112,13:out113,cp and 255

§game_next1:
	// draw the ship
	setink0:plot sxp+ofset, syp:setink1:print#0," \tc0 "
	// draw rocket
	if (isr=1) then goto §game_rocket:else goto §dumy_rocket
§game_next2:	
	K$=INKEY$&"."
	IF ORD(K$)=4 then if ofset<452 then ofset=ofset+16
	IF ORD(K$)=19 then if ofset>-188 then ofset=ofset-16
	IF ORD(K$)<>32 then goto §game_loop

§rocket_launch:	
	if isr=0 then roa=576:for ex=14to0step-2:soundpitch3000+ex*50,volume ex:next ex:isr=1:rp=§ROCKET_INIT_POS+sxp/16+ofset/16+rio
	goto §game_loop
	
§game_rocket:
	if rp<49216 then goto §gr_next
	if peek(rp-64)<>0 then goto §explosion
§gr_next:
	poke rp,0:rp=rp-256-roa: if rp<49152 then rp=rp+16384
	if roa>0 then roa=roa-64
	if (rp>§ROCKET_INIT_POS+rio) and (rp<58000+rio) then isr=0: goto §game_next2
	poke rp,96
	goto §game_next2

// dummy code for time balancing
§dumy_rocket:
	if rp<49216 then goto §dummy_next
	if peek(rp-0) <> 0 then goto §game_next2
§dummy_next:
	poke 49152,0:rp=rp-0: if rp<49152 then rp=rp+0
	if (rp>§ROCKET_INIT_POS+rio) and (rp<57000+rio) then isrd=0: goto §game_next2
	poke 49152,0
	goto §game_next2

§explosion:
	oset=rp-49152:yk=int(oset/64):xk=oset-(yk*64):yk=980-yk*4:xk=xk*16-32
	if yk>959 then yk=980-yk
	setink2:plot xk,yk:print#0,"\t7f\t7f\t7f"
	setink2:plot xk,yk+40:print#0,"\t7f\t7f\t7f"
 	for ex=15to0step -0.7:soundpitch rnd(3000),volume ex:next ex
	setink0:plot xk,yk:print#0,"\t7f\t7f\t7f"
	setink0:plot xk,yk+40:print#0,"\t7f\t7f\t7f"
	isr=0
	// count score
	if rp>62006 then score=score+10:else if rp>58038 then score=score+20:else score=score+30
	goto §game_next2
	
§gameover:
	setrate100:setdelay100
	if score>highscore then highscore=score
	
	// final effects
	setborder4
	forj=15to0step-2 :fori=2300to3900step50:soundpitchi,volumej:nexti,j
	setpalette4,4,4,4
	for ex=15to0step -0.1:soundpitch rnd(3000),volume ex:next ex
	gosub §fokepernyo
	gameover=1
	i$=inkey$
	setrate3:setdelay30
	gosub §musicplayer	
	goto §game_begin

/////////////////////////////////////////////////////////////////////////////////////////////////
// minijáték 1
// amikor középen van a CRTC jön egy űrhajó balról
// űrhajót meg kell rajzolni 3 karakter + 1-1 space
// gyorsan mozog, ki kell lőni
// alatta alert zene, de a lövés és a robbanás hangja megmarad
§minigame:
	isr=0
	alert_freq=2300
	alien_pos=28
	poke rp,0
§minigame_loop:
	// draw the alien
	printAT1,alien_pos,"\tc1\tc2\tc3 ";
	alien_pos=alien_pos-1:if alien_pos=1 then printAT1,alien_pos,"    ";:return
	soundpitch alert_freq:alert_freq=alert_freq+400:if alert_freq=3900then alert_freq=2300
	// draw the ship
	setink0:plot sxp+ofset, syp:setink1:print#0," \tc0 "
	// draw rocket
	if (isr=1) then goto §mini_game_rocket:else goto §mini_dumy_rocket
§mini_game_next2:	
	K$=INKEY$&"."
	IF ORD(K$)=4 then if ofset<452 then ofset=ofset+16
	IF ORD(K$)=19 then if ofset>-188 then ofset=ofset-16
	IF ORD(K$)=32 then goto §mini_rocket_launch
	goto §minigame_loop

§mini_rocket_launch:	
	roa=512
	if isr=0 then for ex=14to0step-2:soundpitch3000+ex*50,volume ex:next ex:isr=1:rp=§ROCKET_INIT_POS+sxp/16+ofset/16+rio
	goto §minigame_loop
	
§mini_game_rocket:
	if rp<49216 then goto §mini_gr_next
	if peek(rp-64)<>0 then goto §mini_explosion
§mini_gr_next:
	poke rp,0:rp=rp-256-roa: if rp<49152 then isr=0: goto §mini_game_next2
	if roa>0 then roa=roa-64
	poke rp,96
	goto §mini_game_next2

// dummy code for time balancing
§mini_dumy_rocket:
	if rp<49216 then goto §mini_dummy_next1
§mini_dummy_next1:
	if peek(rp-0)<>0 then goto §mini_dummy_next2
§mini_dummy_next2:
	poke 49152,0:rp=rp-0+0: if rp<49152 then rp=rp+0: goto §mini_game_next2
	if roa>0 then roa=roa-0
	poke 49152,0
	goto §mini_game_next2

§mini_explosion:
	oset=rp-49152:yk=int(oset/64):xk=oset-(yk*64):yk=980-yk*4:xk=xk*16-54
	if yk>959 then yk=958
	setink2:plot xk,yk:print#0,"\t7f\t7f\t7f"
 	for ex=15to0step -0.7:soundpitch rnd(3000),volume ex:next ex
	setink0:plot xk,yk:print#0,"\t7f\t7f\t7f"
	isr=0
	// count score
	score=score+500
	// remove alien ship from current position
	printAT1,alien_pos,"    ";
	return
/////////////////////////////////////////////////////////////////////////////////////////////////

	
// Inicializáljuk az adatokat
§initdata:
	// clear non visible screen area (last 1k of video memory)
	// important for hardware scroll
	fora=64512to65535:pokea,0:next
	// init random array
	dimh(64):fora=1to64:h(a)=rnd(16384):next
	return	
	
§initdata_music:
	// init ssi music
	DIM SND(78),MUS$*240
	restore §main_pitch_map
	FOR A=1 TO 78:READ SND(A):NEXT
	return

// Normal 2 channel music player (25HZ) for TVC 40
§normalmusicplayer40:
	RESTORE §main_music_records40
	FOR J=1 TO 10:READ MUS$
	FOR I=1 TO 200 STEP 2
		SOUND PITCH SND(ORD(MUS$(I+1))-47),VOLUME14
		SOUND PITCH SND(ORD(MUS$(I))-47),VOLUME6
	NEXT:NEXT:SOUNDVOLUME0:return
	
// Normal 2 channel music player (25HZ)
§musicplayer:
	K=124
§normalmusicplayer:
	RESTORE §main_music_records
	FOR J=1 TO 50:READ MUS$:FOR I=K TO 238
		SOUND PITCH SND(ORD(MUS$(I))-47),VOLUME14
		IF INKEY$ <> "" THEN SOUNDVOLUME0: goto §musiccontinue
	NEXT I:K=1:NEXT J:GOTO §normalmusicplayer
§musiccontinue:
	if gameover=1 then return
	gosub §fokepernyo
	if j=50 then j=1:else j=j+1
§continuedmusicplayer:
	FOR K=J TO 50:READ MUS$:FOR L=1 TO 238
		SOUND PITCH SND(ORD(MUS$(L))-47),VOLUME14
		IF INKEY$ <> "" THEN SOUNDVOLUME0: RETURN
	NEXT L:NEXT K:J=1:RESTORE §main_music_records:GOTO §continuedmusicplayer
	
	// Főképernyő
§fokepernyo:
	setpalette0,0,0,0:setborder0:graphics4
	gosub §crtc_off
	out112,12:out113,0:out112,13:out113,0
	setpalette0,85,20,17:setink2
	printAT1,1,"SCORE:                 HI-SCORE:"
	setink1
	printAT2,2,USING"%###":score
	printAT2,27,USING"%###":highscore
	setink2
	printAT3,15,"PLAY"
	printAT4,10,"BASIC INVADERS"
	setink1
	printAT7,6,"*SCORE ADVANCE TABLE*"
	printAT10,14,"=30 POINTS"
	printAT13,14,"=20 POINTS"
	setink3
	printAT16,14,"=10 POINTS"
	setink1
	printAT19,9,"\tc1\tc2\tc3  =?? POINTS"
	setink2
	printAT22,5,"KEYS:  LEFT-RIGHT-SPACE"
	setink3
	printAT24,9,"PRESS ANY KEY..";
	x=240:y=638:sz=1:gosub §draw_alien1
	x=240:y=508:sz=1:gosub §draw_alien2
	x=240:y=388:sz=3:gosub §draw_alien3
	gosub §crtc_on
	gosub §irq_on
	return

