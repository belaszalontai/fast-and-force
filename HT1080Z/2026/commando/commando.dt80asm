				org	17129
				
				genbinary
				
; full memory MAP
; $42E9 - Program + Main title picture zx7 compressed
; $6678 - $BFFF decompressed music (22919 byte)
; $C000 - $FFFF decompressed MAP (16384 byte)
				
	MAP_BUFFER		equ	$C000
; C000 - 22919 - 1
	MUS_BUFFER		equ	$6678
	LEVEL_SIZE		equ	256
; stack points to the BASIC AREA (16384 - 17128 = 744 byte)
	STACK_AREA		equ	$42e8
				
; SETUP IN GAME MUSIC PLAY BALANCE
; Tune this value to balance audio for bullet system
	BULLET_PAD_VAL		equ	140		;180
	EBULLET_PAD_VAL		equ	70		;120
	LOOP_PAD_VAL		equ	860		;950
	SCR_PAD_VAL		equ	280		;350
	MUSIC_COMP_VAL		equ	300		;350
				
	TITLE_PAD_VAL		equ	1150			; for title music player
				
	NUM_OF_MEDKITS		equ	3
	ENEMY_SHOOT_REPEAT_PER_FRAME	equ	10	;5
	NUMBER_OF_AREAS		equ	5
				
; -----------------------------------------------------------------------------
; MAIN INITIALIZATION SEQUENCE
; -----------------------------------------------------------------------------				
; setup stack
	start:			ld	sp,STACK_AREA
				
; INFO SCREEN
				call	$01c9			; CLS
				call	draw_info_screen
				call	play_interference
				call	wait_10_seconds
				call	fade_out		; full mute
				
; 1. Decompress main title picture ($3C00-$3FFF)
				ld	hl,MAIN_PIC_ZX7
				ld	de,$3C00
				call	ZX7_DECOMPRESS
				
; 2. Move music to the buffer ($C000)
				ld	hl,MUSIC_PT3_ZX7
				ld	de,MAP_BUFFER
; Calculate exact size between labels
				ld	bc,MAIN_PIC_ZX7 - MUSIC_PT3_ZX7
				ldir
				
; 3. Decompress music to final location ($6678)
; Source: temp area
				ld	hl,MAP_BUFFER
; Dest: $6678
				ld	de,MUS_BUFFER
				call	ZX7_DECOMPRESS
				call	music_init
				
; 4. $C000 is now free, load the level!
				ld	hl,MAP_LEVEL_01_ZX7
				ld	de,MAP_BUFFER
				call	ZX7_DECOMPRESS
				
; waits for 20ms programmed
	title_loop		call	WAITQ
				call	music_play
; read 7th row of keyboard map
				ld	a,($3840)
; check SPACE key
				bit	7,a
				jp	z,title_loop
				call	music_init
; animated CLS
				call	scroll_cls
				
; wait for space
				call	draw_copyright
; read 7th row of keyboard map
	copy_loop		ld	a,($3840)
; check SPACE key
				bit	7,a
				jp	z,copy_loop
				
; CLS
				call	$01c9
				
				call	music_init
				
				xor	a
; Initialize game at Level 1
				ld	(current_level),a
				
; Setup Map, HUD and Pointers
				call	load_level
				
; Draw the patched HUD
				call	draw_HUD
; Initialize player state before loop
				call	init_player
				call	draw_player
				
	game_loop:		
				call	read_keyboard
				
				ld	a,(scroll_requested)
				and	a
				jp	nz,do_scroll_frame
				
	no_scroll_frame:	
				ld	a,(enemy_tick)
				inc	a
				ld	(enemy_tick),a
				and	7
				jp	nz,.skip_e_move
				
				call	erase_enemies
				call	update_enemies_ai
	.skip_e_move:		
				
				call	update_bullets
				call	update_ebullets
				call	update_enemies
				
; Only redraw player if moved (anim_req > 0)
				ld	a,(anim_req)
				and	a
				jp	z,.skip_p_redraw
				
				call	check_medkit_pickup
; Erase from old position
				call	erase_old_player
; Draw at new position
				call	draw_player
	.skip_p_redraw:		
; Save current coordinates for next frame
				call	update_old_coords
				
				ld	a,(enemy_tick)
				and	7
				jp	nz,.skip_e_draw
				call	draw_enemies
	.skip_e_draw:		
; Use the main loop padding here to slow down idle frames
				call	waste_time_loop
				call	maybe_music_play
				jp	game_loop
				
	do_scroll_frame:	
				ld	a,(scroll_pos)
				inc	a
				ld	(scroll_pos),a
				
				xor	a
				ld	(scroll_requested),a
				
				call	erase_enemies
; Player MUST be erased before scroll down to prevent smearing
				call	erase_old_player
				
				call	update_bullets
				call	scroll_bullets
				
				call	update_ebullets
				call	scroll_ebullets
				call	scroll_enemies
				
				call	scroll_down
				call	check_enemy_spawns
				
	level_counter:		ld	hl,LEVEL_SIZE		; LEVEL STEP COUNTER 256 scroll step = one entire level
				dec	hl
				ld	(level_counter+1),hl
				ld	a,h
				or	l
				jp	z,NEXTLEVEL
				
				call	update_enemies
				
				call	check_medkit_pickup
				
; Redraw player in the clean, scrolled map
				call	draw_player
				call	draw_enemies
				call	update_old_coords
; Padding moved to end of frame so music timing stays consistent
				call	waste_time_scr
				call	maybe_music_play
				jp	game_loop
				
	NEXTLEVEL:		
				call	music_mute
				
; Advance to next level
				ld	a,(current_level)
				inc	a
; Did we finish all 4 levels?
				cp	NUMBER_OF_AREAS
				jp	z,victory_screen
				
				ld	(current_level),a
				
; Decompress new map, update HUD, reset counters
				call	load_level
				
; CLS
				call	$01c9
; Draw the new HUD
				call	draw_HUD
				
; Initialize player state for new level
				call	init_player
				call	draw_player
				jp	game_loop
				
	victory_screen:		
				call	$01c9			; CLS
				call	music_init
				
				ld	hl,VICTORY_TEXT1
				ld	de,$3c00 + 1*64 + 20
				call	print_string
				
				ld	hl,VICTORY_TEXT2
				ld	de,$3c00 + 3*64 + 21
				call	print_string
				
; Initialize 64 particles (3 bytes each: px, py, speed)
				ld	ix,$C000
				ld	b,64
	.vic_init_p:		
				call	get_random
				and	127
				ld	(ix+0),a		; px
				call	get_random
				and	31
				add	a,15
				ld	(ix+1),a		; py
				call	get_random
				and	3
				inc	a
				ld	(ix+2),a		; speed
				
				ld	de,3
				add	ix,de
				djnz	.vic_init_p
				
	.vic_init_rel:		
				call	WAITQ
				ld	a,($3840)
				bit	7,a
				jp	nz,.vic_init_rel
				
	.vic_loop:		
				call	WAITQ
				
				call	get_random
				cp	8
				call	c,trigger_explosion
				
; Clear screen below text (row 5 to 15)
				ld	hl,$3C00 + 5*64
				ld	de,$3C00 + 5*64 + 1
				ld	bc,11*64 - 1
				ld	(hl),32
				ldir
				
; Draw particles
				ld	ix,$C000
				ld	b,64
	.vic_p_loop:		
; Update PY
				ld	a,(ix+1)
				add	a,(ix+2)
				cp	48
				jp	c,.vic_p_ok
; Respawn
				call	get_random
				and	127
				ld	(ix+0),a
				ld	a,15
	.vic_p_ok:		
				ld	(ix+1),a
				
; Draw pixel
				ld	e,a			; PY
				ld	d,(ix+0)		; PX
				
				push	bc
				call	PlotPixel
				push	af
				call	get_vram_bc
				pop	af
				ld	c,a
				ld	a,(hl)
				cp	128
				jp	nc,.vic_or
				ld	a,128
	.vic_or:		
				or	c
				ld	(hl),a
				pop	bc
				
				ld	de,3
				add	ix,de
				djnz	.vic_p_loop
				
				ld	a,($3840)
				bit	7,a
				jp	z,.vic_loop
				
	.vic_release:		
				call	WAITQ
				ld	a,($3840)
				bit	7,a
				jp	nz,.vic_release
				
				call	music_mute
				jp	game_over
				
				
; -----------------------------------------------------------------------------
; PLAY INTERFERENCE TONE ON ALL 3 CHANNELS
; -----------------------------------------------------------------------------
	play_interference:	
				ld	hl,interference_data
				ld	b,14
				ld	c,0
	.ay_loop:		
				ld	a,c
				out	($1F),a
				ld	a,(hl)
				out	($1E),a
				inc	hl
				inc	c
				djnz	.ay_loop
				ret
				
; -----------------------------------------------------------------------------
; 5 SECOND DELAY LOOP (@ 1.747 MHz)
; -----------------------------------------------------------------------------
	wait_10_seconds:	
; 6 * 0.9s = ~5.4 seconds delay
				ld	b,12
	.wait_outer:		
				ld	hl,0
	.wait_inner:		
				dec	hl			; 6 T-states
				ld	a,h			; 4 T-states
				or	l			; 4 T-states
				jp	nz,.wait_inner		; 10 T-states
; Total inner loop: 24 T-states. 65536 * 24 = 1,572,864 T-states
				djnz	.wait_outer
				ret
				
; -----------------------------------------------------------------------------
; AY REGISTER DATA FOR INTERFERENCE TONES
; -----------------------------------------------------------------------------
	interference_data:	
				db	$3e, $0d		; Reg 0, 1: Chan A Period (~32,7 Hz)
				db	$9f, $06		; Reg 2, 3: Chan B Period (+1 octave)
				db	$98, $06		; Reg 4, 5: Chan C Period (++)
				db	0			; Reg 6: Noise Period (unused)
; 56 (binary $00111000) = Disable all Noise (bits 3,4,5 = 1), Enable all Tones (bits 0,1,2 = 0)
				db	56			; Reg 7: Mixer
				db	15			; Reg 8: Chan A Volume (0-15)
				db	15			; Reg 9: Chan B Volume (0-15)
				db	15			; Reg 10: Chan C Volume (0-15)
				db	0, 0, 0			; Reg 11, 12, 13: Envelope (unused)
				
; -----------------------------------------------------------------------------
; SCROLL ENEMY BULLETS
; -----------------------------------------------------------------------------
	scroll_ebullets:	
				ld	b,MAX_EBULLETS
				ld	c,0
	sreb_loop:		push	bc
				ld	hl,ebullet_active
				ld	b,0
				add	hl,bc
				ld	a,(hl)
				and	a
; Skip inactive
				jp	z,sreb_next
				
				ld	hl,ebullet_py
				add	hl,bc
				ld	a,(hl)
; Shift logic Y down by 3 pseudo-pixels (1 character)
				add	a,3
				ld	(hl),a
				
; Entered HUD area? (HUD starts at pseudo-Y 42)
				cp	42
; If < 42, all ok
				jp	c,sreb_next
				
				ld	hl,ebullet_active
				add	hl,bc
; Free up slot!
				ld	(hl),0
	sreb_next:		pop	bc
				inc	c
				djnz	sreb_loop
				ret
				
; -----------------------------------------------------------------------------
; LEVEL PROGRESSION SYSTEM
; -----------------------------------------------------------------------------
	current_level		db	0
	player_lives		db	3
	current_enemy_cnt	db	0
				
	level_data:		
; Format: Area(1), MenStr(2), EnemyStr(2), EnemyNum(1), LivesNum(1), Pad(1) = 8 bytes
; -----------------------------------------------------------------------------
				db	'1', '0', '2', '0', '6', 6, 2, 0
				db	'2', '0', '3', '0', '8', 8, 3, 0
				db	'3', '0', '4', '1', '0', 10, 4, 0
				db	'4', '0', '5', '1', '1', 11, 5, 0
				db	'5', '0', '6', '1', '2', 12, 6, 0
				
	load_level:		
				ld	hl,MAP_LEVEL_01_ZX7
				ld	de,MAP_BUFFER
				call	ZX7_DECOMPRESS
				
; Calculate pointer: HL = level_data + (current_level * 8)
				ld	a,(current_level)
				add	a,a			; *2
				add	a,a			; *4
				add	a,a			; *8
				ld	l,a
				ld	h,0
				ld	de,level_data
				add	hl,de			; HL points to current level data
				
; Patch HUD Strings & Load Level Stats
				ld	a,(hl)
				ld	(HUD_AREA),a		; Offset 0: Area char
				inc	hl
				
				ld	a,(hl)
				ld	(HUD_MEN),a		; Offset 1: Men Tens char
				inc	hl
				
				ld	a,(hl)
				ld	(HUD_MEN+1),a		; Offset 2: Men Units char
				inc	hl
				
				ld	a,(hl)
				ld	(HUD_ENEMY),a		; Offset 3: Enemy Tens char
				inc	hl
				
				ld	a,(hl)
				ld	(HUD_ENEMY+1),a		; Offset 4: Enemy Units char
				inc	hl
				
				ld	a,(hl)
				ld	(current_enemy_cnt),a	; Offset 5: Enemy numeric value
				inc	hl
				
				ld	a,(hl)
				ld	(player_lives),a	; Offset 6: Lives numeric value
				
; Setup Map Pointers and Level Counter
				ld	hl,MAP_BUFFER+256*64-1
				ld	(prev_char_ptr3+1),hl
				ld	hl,LEVEL_SIZE
				ld	(level_counter+1),hl
				
; Generate entities on the fresh map
				call	generate_enemies
				call	generate_medkits
				
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------				
	waste_time_loop:	
; Load base padding value
				ld	hl,LOOP_PAD_VAL
				
; --- Check Player Bullets ---
				ld	a,(bullet_active+0)
				ld	b,a
				ld	a,(bullet_active+1)
				or	b
				ld	b,a
				ld	a,(bullet_active+2)
				or	b
				ld	b,a
				ld	a,(bullet_active+3)
				or	b
				jp	z,wt_chk_ebullets
				
; Subtract player bullet padding
				ld	de,BULLET_PAD_VAL
; Clear carry
				and	a
				sbc	hl,de
; Prevent underflow
				jp	nc,wt_chk_ebullets
				ld	hl,0
				
	wt_chk_ebullets:	
; --- Check Enemy Bullets ---
				push	hl
				ld	hl,ebullet_active
; Check up to 8 max ebullets
				ld	b,MAX_EBULLETS
	wt_ceb_loop:		
				ld	a,(hl)
				and	a
				jp	nz,wt_eb_found
				inc	hl
				dec	b
				jp	nz,wt_ceb_loop
				
; No enemy bullets found
				pop	hl
				jp	wt_loop
				
	wt_eb_found:		
				pop	hl
; Subtract enemy bullet padding
				ld	de,EBULLET_PAD_VAL
; Clear carry
				and	a
				sbc	hl,de
; Prevent underflow
				jp	nc,wt_loop
				ld	hl,0
				
	wt_loop:		
				ld	a,h
				or	l
				ret	z
				dec	hl
				jp	wt_loop
				
	waste_time_scr:		
				ld	hl,SCR_PAD_VAL
	wt_loop_scr:		
				ld	a,h
				or	l
				ret	z
				dec	hl
				jp	wt_loop_scr
				
	WAITQ:			
				ld	hl,TITLE_PAD_VAL
	wt_loop_q:		dec	hl
				ld	a,h
				or	l
				jp	nz,wt_loop_q
				ret
				
	music_skip_count	db	0
				
	maybe_music_play:	
				ld	a,(music_skip_count)
				and	a
				jp	z,music_play
				dec	a
				ld	(music_skip_count),a
				
				ld	hl,MUSIC_COMP_VAL
	.mmp_delay:		
				ld	a,h
				or	l
				ret	z
				dec	hl
				jp	.mmp_delay
				
; -----------------------------------------------------------------------------
; PRINT NULL-TERMINATED STRING
; Input: HL = String address, DE = VRAM address
; -----------------------------------------------------------------------------
	print_string:		
				ld	a,(hl)
				and	a
				ret	z
				ld	(de),a
				inc	hl
				inc	de
				jp	print_string
				
; -----------------------------------------------------------------------------
; DRAW COPYRIGHT
; -----------------------------------------------------------------------------
	draw_copyright:		
				ld	hl,COPY_TEXT
				ld	de,$3c00 + 24
				call	print_string
				
				ld	hl,COPY_TEXT2
				ld	de,$3c00 + 3*64 + 20
				call	print_string
				
				ld	hl,COPY_TEXT3
				ld	de,$3c00 + 5*64 + 24
				call	print_string
				
				ld	hl,COPY_TEXT4
				ld	de,$3c00 + 8*64 + 23
				call	print_string
				
				ld	hl,COPY_TEXT5
				ld	de,$3c00 + 10*64 + 16
				call	print_string
				
				ld	hl,COPY_TEXT6
				ld	de,$3c00 + 13*64 + 21
				call	print_string
				
				ld	hl,COPY_TEXT7
				ld	de,$3c00 + 15*64 + 13
				call	print_string
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
	draw_HUD		ld	hl,HUD_TEXT
; last row
				ld	de,$3c00 + 1024 - 64
; one row
				ld	bc,50
				ldir
				
; "_" character
				ld	a,176
				ld	hl,$3c00 + 1023 - 64
				ld	b,64
	hud_fill		ld	(hl),a
				dec	hl
				djnz	hud_fill
				
				ld	a,131
				ld	hl,$3c00 + 63
				ld	b,64
	hud_fill_top		ld	(hl),a
				dec	hl
				djnz	hud_fill_top
				
				ret
				
	add_score_100:		
				ld	hl,HUD_TEXT+3		; 100-as helyiérték
				ld	b,4			; 4 számjegyen mehet a túlcsordulás (3, 2, 1, 0)
				jp	.add_loop
				
	add_score:		
; Tens digit
				ld	hl,HUD_TEXT+4		; 10-es helyiérték
; 5 digits to process for carry
				ld	b,5			; 5 számjegyen mehet a túlcsordulás (4, 3, 2, 1, 0)
	.add_loop:		
				inc	(hl)
				ld	a,(hl)
				cp	'9'+1
; If no overflow, jump to draw
				jp	c,.draw_score
				
; Overflow to 0
				ld	(hl),'0'
; Move to next higher digit
				dec	hl
				dec	b
				jp	nz,.add_loop
				
	.draw_score:		
; Update the score on the screen (last row, first 6 chars)
				ld	hl,HUD_TEXT
				ld	de,$3C00 + 1024 - 64
				ld	bc,6
				ldir
				ret
				
; -----------------------------------------------------------------------------
; DRAW HP BAR ON HUD
; -----------------------------------------------------------------------------
	draw_hp_bar:		
				ld	a,(player_hp)
				ld	hl,hp_chars
				add	a,l
				ld	l,a
				jp	nc,.hp_no_cy
				inc	h
	.hp_no_cy:		
				ld	a,(hl)
				ld	($3FFF),a		; A képernyő legutolsó karaktere (jobb alsó sarok)
				ret
				
; Pszeudo-grafika bitek alulról felfelé töltve (0-tól 6 HP-ig)
	hp_chars:		db	128, 144, 176, 180, 188, 189, 191
				
; -----------------------------------------------------------------------------
; DRAW HARDWARE INFO SCREEN
; -----------------------------------------------------------------------------
	draw_info_screen:	
				ld	hl,INFO_TEXT0
				ld	de,$3c00 + 3*64 + 28	; Row 3, Col 28
				call	print_string
				
				ld	hl,INFO_TEXT1
				ld	de,$3c00 + 5*64 + 23	; Row 5, Col 23
				call	print_string
				
				ld	hl,INFO_TEXT2
				ld	de,$3c00 + 7*64 + 12	; Row 7, Col 12
				call	print_string
				
				ld	hl,INFO_TEXT3
				ld	de,$3c00 + 9*64 + 20	; Row 9, Col 20
				call	print_string
				
				ld	hl,INFO_TEXT4
				ld	de,$3c00 + 11*64 + 25	; Row 11, Col 25
				call	print_string
				ret
				
;------------------------------------------------------------------------|-------------------------------------------------------------
	HUD_TEXT		db	"000000          AREA "
	HUD_AREA		db	"1        MEN "
	HUD_MEN			db	"05      ENEMY "
	HUD_ENEMY		db	"06"
	COPY_TEXT		db	"C O M M A N D O",0
	COPY_TEXT2		db	"WRITTEN BY RICHARD IKIN",0
	COPY_TEXT3		db	"AND RAY TREDOUX",0
	COPY_TEXT4		db	"HIGH SCORE-000000",0
	COPY_TEXT5		db	"PRESS SPACE TO START (AND FIRE)",0
	COPY_TEXT6		db	"(C) 1986 ELITE SYSTEMS",0
	COPY_TEXT7		db	"Ported to HT1080Z by FAST&FORCE @2026",0
	VICTORY_TEXT1		db	"CONGRATULATIONS SOLDIER!",0
	VICTORY_TEXT2		db	"MISSION ACCOMPLISHED!",0
	INFO_TEXT0		db	"HT-1080Z",0
	INFO_TEXT1		db	"Z80 CPU @ 1,747MHz",0
	INFO_TEXT2		db	"MONOCHROME 128x48 PIXEL PSEUDO GRAPHICS",0
	INFO_TEXT3		db	"AY-3-8910 SOUND CHIP :)",0
	INFO_TEXT4		db	"NO INTERRUPT :(",0
				
;--------------------------------------------------------------------------------------------------------------------------------------
; SCROLL
;--------------------------------------------------------------------------------------------------------------------------------------
; Starts at 0 and goes to 255
	scroll_pos		db	0
				
	scroll_down		ld	hl,$3C00 + 1023 - 3*64
				ld	de,$3C00 + 1023 - 2*64
				ld	bc,1024 - 4*64
				lddr
	prev_char_ptr3		ld	hl,0
				ld	bc,64
				lddr
				ld	(prev_char_ptr3+1),hl
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
	scroll_cls:		ld	a,48
				ld	(cls_row_cnt+1),a
				ld	a,6
				ld	(size_cnt+1),a
				
				ld	hl,1024 - 64
				ld	(scr_size+1),hl
				
				
; Pointer to character above
	row_loop		ld	hl,$3C00 + 1023 - 64
				ld	(prev_char_ptr+1),hl
; Current character pointer DESTINATION
				ld	de,$3C00 + 1023
	scr_size		ld	bc,1024 - 64
				
	scroll_down_loop:	
	prev_char_ptr:		ld	hl,0
				ld	a,(hl)
				dec	hl
				ld	(prev_char_ptr+1),hl
				ld	h,a
				
; top
				ld	a,(de)
; Clear bits 4-7
				and	$0f
; Save A register
				ld	l,a
; Get byte from above
				ld	a,h
; Keep only bits 4 and 5
				and	$30
; Rotate to bits 6 and 7
				rlca
				rlca
; Mix them together
				or	l
; Rotate into place
				rlca
				rlca
; Convert to ASCII
				or	$80
				ld	(de),a
				
				dec	de
				dec	bc
				ld	a,b
				or	c
				jp	nz,scroll_down_loop
				
; Scroll in empty space
				ld	b,64
; top
	last_line_loop:		ld	a,(de)
; Clear bits 4-7
				and	$0f
; Rotate into place
				rlca
				rlca
; Convert to ASCII
				or	$80
				ld	(de),a
				dec	de
				djnz	last_line_loop
				
	size_cnt		ld	a,4
				dec	a
				ld	(size_cnt+1),a
				jp	nz,cls_row_cnt
				ld	a,3
				ld	(size_cnt+1),a
				ld	hl,(scr_size+1)
				ld	bc,65536-64
				add	hl,bc
				ld	(scr_size+1),hl
				
	cls_row_cnt		ld	a,0
				dec	a
				ld	(cls_row_cnt+1),a
				jp	nz,row_loop
				
				ret
				
; -----------------------------------------------------------------------------
; ENEMY SYSTEM DATA STRUCTURES
; -----------------------------------------------------------------------------
	MAX_ENEMIES		equ	12
				
; Allocate 16 enemies 5-byte structure in one block (80 bytes)
; Layout: 0=State, 1=MapY, 2=MapX, 3=ScrX, 4=ScrY, 5=movement
				
	enemy_data		ds	MAX_ENEMIES * 6
				
; Random number seed
	prng_seed		db	$A5
				
	MAX_EBULLETS		equ	8
				
; 0 = Inactive, 1 = Active
	ebullet_active		ds	MAX_EBULLETS
; Pseudo X (0-127)
	ebullet_px		ds	MAX_EBULLETS
; Pseudo Y (0-47)
	ebullet_py		ds	MAX_EBULLETS
; Velocity X (Signed)
	ebullet_vx		ds	MAX_EBULLETS
; Velocity Y (Signed)
	ebullet_vy		ds	MAX_EBULLETS
				
; -----------------------------------------------------------------------------
; RANDOM NUMBER GENERATOR (8-bit LFSR)
; Output: A = Random number (0-255)
; -----------------------------------------------------------------------------
	get_random:		
				ld	a,(prng_seed)
				and	a
				jp	nz,rnd_lfsr
; Seed if 0
				ld	a,$A5
; Tap
	rnd_lfsr:		rra
				jp	nc,rnd_noxor
				xor	$B4
	rnd_noxor:		ld	(prng_seed),a
				ret
				
; -----------------------------------------------------------------------------
; GENERATE ENEMIES FOR CURRENT LEVEL
; Spreads enemies evenly across the 256-row map and places them near obstacles.
; -----------------------------------------------------------------------------
	generate_enemies:	
				ld	hl,enemy_data
; 6 bytes per structure!
				ld	b,MAX_ENEMIES * 6
				xor	a
	gen_clr_loop:		ld	(hl),a
				inc	hl
				djnz	gen_clr_loop
				
				ld	a,(current_enemy_cnt)
				and	a
				ret	z
				
; C = number of enemies
				ld	c,a
				
				ld	a,240
				ld	b,0
	gen_div_loop:		sub	c
				jp	c,gen_div_done
; B = step size
				inc	b
				jp	gen_div_loop
	gen_div_done:		
				
				ld	ix,enemy_data
; D = Starting MapY
				ld	d,15
				
	gen_loop:		
; State: Waiting
				ld	(ix+0),1
; Save MapY
				ld	(ix+1),d
				
; E = MapY for searching in MAP_BUFFER (Row entering screen is 256 - scroll_pos)
				ld	a,0
				sub	d
				ld	e,a
				
				push	bc
; SAVE D (Protect MapY)
				push	de
				call	find_spawn_x
; Save MapX
				ld	(ix+2),a
; RESTORE D
				pop	de
				pop	bc
				
; Calculate next MapY
				ld	a,d
				add	a,b
				ld	d,a
				
; ANOTHER PROTECTION
				push	de
; Fix: 6 bytes offset
				ld	de,6
				add	ix,de
; D IS SAFE AGAIN
				pop	de
				
				dec	c
				jp	nz,gen_loop
				
				xor	a
				ld	(scroll_pos),a
				ret
				
; -----------------------------------------------------------------------------
; GENERATE MEDKITS
; Places 5 medkits in MAP_BUFFER randomly
; -----------------------------------------------------------------------------
	generate_medkits:	
				ld	b,NUM_OF_MEDKITS
	.gen_mk_loop:		
				push	bc
	.rnd_y:			
				call	get_random
				cp	240
				jp	nc,.rnd_y
				cp	10
				jp	c,.rnd_y
				ld	e,a			; E = Y
	.rnd_x:			
				call	get_random
				and	63
				cp	59
				jp	nc,.rnd_x
				cp	2
				jp	c,.rnd_x
				ld	c,a			; C = X
				
; Calculate MAP_BUFFER pointer into HL
				ld	a,e
				rrca
				rrca
				ld	l,a
				and	$C0
				ld	l,a
				ld	a,e
				rrca
				rrca
				and	$3F
				add	a,$C0
				ld	h,a
				
				ld	a,l
				add	a,c
				ld	l,a
				
; Check if 3x3 space is empty and no enemy is there
				call	check_medkit_space
; Try again if invalid (Carry = 0)
				jp	nc,.rnd_y
				
; Draw 3x3 Medkit in MAP_BUFFER
				ld	(hl),156
				inc	hl
				ld	(hl),140
				inc	hl
				ld	(hl),172
				
				ld	de,62
				add	hl,de
				ld	(hl),149
				inc	hl
				ld	(hl),'+'
				inc	hl
				ld	(hl),170
				
				add	hl,de
				ld	(hl),141
				inc	hl
				ld	(hl),140
				inc	hl
				ld	(hl),142
				
				pop	bc
				djnz	.gen_mk_loop
				ret
				
; -----------------------------------------------------------------------------
; HELPER: CHECK IF MEDKIT SPACE IS VALID
; Input: HL = VRAM Addr, E = Map Y, C = Map X
; Output: Carry = 1 (Valid), Carry = 0 (Invalid)
; -----------------------------------------------------------------------------
	check_medkit_space:	
; 1. Check 3x3 background space in MAP_BUFFER
				push	hl
				ld	b,3
	.cms_bg_y:		
				push	bc
				ld	b,3
	.cms_bg_x:		
				ld	a,(hl)
				call	check_spawnable
				jp	nz,.cms_fail_pop
				inc	hl
				djnz	.cms_bg_x
				pop	bc
; Next row (+64 chars - 3 chars)
				ld	de,61
				add	hl,de
				djnz	.cms_bg_y
				pop	hl
				
; 2. Check overlap with enemies in enemy_data (AABB Collision)
				ld	ix,enemy_data
				ld	b,MAX_ENEMIES
	.cms_en_loop:		
				ld	a,(ix+0)
				and	a
				jp	z,.cms_en_next
				
; Check Y overlap: Medkit Y+3 > Enemy Y ?
				ld	a,e
				add	a,3
				cp	(ix+1)
				jp	c,.cms_en_next
				jp	z,.cms_en_next
				
; Enemy Y+2 > Medkit Y ?
				ld	a,(ix+1)
				add	a,2
				cp	e
				jp	c,.cms_en_next
				jp	z,.cms_en_next
				
; Check X overlap: Medkit X+3 > Enemy X ?
				ld	a,c
				add	a,3
				cp	(ix+2)
				jp	c,.cms_en_next
				jp	z,.cms_en_next
				
; Enemy X+2 > Medkit X ?
				ld	a,(ix+2)
				add	a,2
				cp	c
				jp	c,.cms_en_next
				jp	z,.cms_en_next
				
; Overlap found!
				jp	.cms_fail
				
	.cms_en_next:		
; 6 bytes per enemy structure
				ld	de,6
				add	ix,de
				djnz	.cms_en_loop
				
; Success: Valid location
				scf
				ret
				
	.cms_fail_pop:		
				pop	bc
				pop	hl
	.cms_fail:		
; Failure: Clear carry flag
				and	a
				ret
				
; -----------------------------------------------------------------------------
; CHECK ENEMY SPAWNS ON SCROLL
; Call this immediately after scroll_down in do_scroll_frame
; -----------------------------------------------------------------------------
	check_enemy_spawns:	
				ld	a,(scroll_pos)
; C = currently entering row number
				ld	c,a
				
				ld	ix,enemy_data
				ld	b,MAX_ENEMIES
	ces_spawn_scan:		
				ld	a,(ix+0)
; Waiting?
				cp	1
				jp	nz,ces_skip_enemy
				
; Map Y
				ld	a,(ix+1)
				cp	c
				jp	nz,ces_skip_enemy
				
; Activate!
				ld	(ix+0),2
; Scr Y = 1 (appears below top HUD)
				ld	(ix+4),1
				ld	a,(ix+2)
; Scr X = Map X
				ld	(ix+3),a
				
	ces_skip_enemy:		
; Fix: 6 bytes offset
				ld	de,6
				add	ix,de
				djnz	ces_spawn_scan
				ret
				
; -----------------------------------------------------------------------------
; ENEMY AI MOVEMENT AND ANIMATION
; -----------------------------------------------------------------------------
	enemy_tick		db	0
				
	update_enemies_ai:	
				ld	ix,enemy_data
				ld	d,MAX_ENEMIES
	.ea_loop:		
				ld	a,(ix+0)
				cp	2
				jp	z,.ea_active
				cp	3
				jp	z,.ea_dying
				jp	.ea_next
				
	.ea_dying:		
				ld	a,(ix+5)
				dec	a
				ld	(ix+5),a
				jp	nz,.ea_next
; Dead
				ld	(ix+0),0
				jp	.ea_next
				
	.ea_active:		
; Add randomness (25% chance to move randomly instead of tracking)
				ld	a,r
				cp	64
				jp	c,ueai.move_random
				
; Track player horizontally
				ld	a,(player_x)
				ld	c,a
				ld	a,(ix+3)
				cp	c
				jp	z,.ea_anim
				jp	c,ueai.move_right
				
	ueai.move_left:		
				dec	a
				jp	.check_col
				
	ueai.move_right:	
				inc	a
				jp	.check_col
				
	ueai.move_random:	
				ld	a,r
				bit	0,a
				ld	a,(ix+3)
				jp	z,ueai.move_right
				jp	ueai.move_left
				
	.check_col:		
; B = new X, C = current Y
				ld	b,a
				ld	c,(ix+4)
				
; Protect registers
				push	bc
				push	de
				push	ix
				
				call	get_vram_bc
; Top-Left
				ld	a,(hl)
				call	check_walkable
				jp	nz,.col_fail
; Top-Right
				inc	hl
				ld	a,(hl)
				call	check_walkable
				jp	nz,.col_fail
; Bottom-Left
				ld	de,63
				add	hl,de
				ld	a,(hl)
				call	check_walkable
				jp	nz,.col_fail
; Bottom-Right
				inc	hl
				ld	a,(hl)
				call	check_walkable
				
	.col_fail:		
; Restore registers
				pop	ix
				pop	de
				pop	bc
				
; If not walkable, skip movement
				jp	nz,.ea_anim
				
; Store new X
				ld	(ix+3),b
				
	.ea_anim:		
; Toggle animation frame in (ix+5)
				ld	a,(ix+5)
				xor	1
				ld	(ix+5),a
				
	.ea_next:		
; Fix: 6 bytes offset
				ld	b,0
				ld	c,6
				add	ix,bc
				
				dec	d
				jp	nz,.ea_loop
				ret
				
; -----------------------------------------------------------------------------
; ENEMY ENGINE - DRAWING & AI
; -----------------------------------------------------------------------------
	erase_enemies:		
				ld	ix,enemy_data
				ld	b,MAX_ENEMIES
	ere_loop:		
				ld	a,(ix+0)
; Active or Dying?
				cp	2
				jp	z,.ere_do
				cp	3
				jp	nz,ere_next
				
	.ere_do:		
; Protect B counter
				push	bc
; HL = VRAM Address
				call	get_enemy_addr
; Erase char
				ld	a,32
				ld	(hl),a
				inc	hl
				ld	(hl),a
				ld	de,63
				add	hl,de
				ld	(hl),a
				inc	hl
				ld	(hl),a
				pop	bc
				
	ere_next:		
; Fix: 6 bytes offset
				ld	de,6
				add	ix,de
				djnz	ere_loop
				ret
				
	draw_enemies:		
				ld	ix,enemy_data
				ld	b,MAX_ENEMIES
	dre_loop:		
				ld	a,(ix+0)
; Active or Dying?
				cp	2
				jp	z,.dre_active
				cp	3
				jp	z,.dre_dying
				jp	dre_next
				
	.dre_dying:		
				push	bc
				call	get_enemy_addr
				ld	a,(ix+5)
				cp	4
				jp	nc,.draw_exp1
				cp	2
				jp	nc,.draw_exp2
	.draw_exp3:		
; Small particles (dispersed)
				ld	(hl),136
				inc	hl
				ld	(hl),129
				ld	de,63
				add	hl,de
				ld	(hl),130
				inc	hl
				ld	(hl),144
				pop	bc
				jp	dre_next
				
	.draw_exp2:		
; Medium particles
				ld	(hl),138
				inc	hl
				ld	(hl),133
				ld	de,63
				add	hl,de
				ld	(hl),148
				inc	hl
				ld	(hl),160
				pop	bc
				jp	dre_next
				
	.draw_exp1:		
; Solid blocky explosion
				ld	(hl),191
				inc	hl
				ld	(hl),191
				ld	de,63
				add	hl,de
				ld	(hl),191
				inc	hl
				ld	(hl),191
				pop	bc
				jp	dre_next
				
	.dre_active:		
				push	bc
; HL = VRAM Address
				call	get_enemy_addr
				
; Check animation frame
				ld	a,(ix+5)
				and	a
				jp	nz,.dre_anim
				
; Normal Frame
				ld	(hl),187
				inc	hl
				ld	(hl),183
				ld	de,63
				add	hl,de
				ld	(hl),175
				inc	hl
				ld	(hl),173
				pop	bc
				jp	dre_next
				
	.dre_anim:		
; Animated Frame (Swapped legs)
				ld	(hl),187
				inc	hl
				ld	(hl),183
				ld	de,63
				add	hl,de
				ld	(hl),173
				inc	hl
				ld	(hl),175
				pop	bc
				
	dre_next:		
; Fix: 6 bytes offset
				ld	de,6
				add	ix,de
				dec	b
				jp	nz,dre_loop
				ret
				
	scroll_enemies:		
				ld	ix,enemy_data
				ld	b,MAX_ENEMIES
	sce_loop:		
				ld	a,(ix+0)
; Active or Dying?
				cp	2
				jp	z,.sce_do
				cp	3
				jp	nz,sce_next
				
	.sce_do:		
; Increment Y position
				inc	(ix+4)
				ld	a,(ix+4)
; Reached HUD?
				cp	13
				jp	c,sce_next
; Deactivate
				ld	(ix+0),0
	sce_next:		
; Fix: 6 bytes offset
				ld	de,6
				add	ix,de
				djnz	sce_loop
				ret
				
; -----------------------------------------------------------------------------
; UPDATE ENEMIES
; -----------------------------------------------------------------------------				
	ebullet_cooldown	db	0
				
	update_enemies:		
				ld	a,(ebullet_cooldown)
				and	a
				jp	z,.ue_start
				dec	a
				ld	(ebullet_cooldown),a
	.ue_start:		
				ld	ix,enemy_data
				ld	b,MAX_ENEMIES
	upe_loop:		ld	a,(ix+0)
; Active?
				cp	2
				jp	nz,upe_next
				
; Prevent bursting - check global cooldown
				ld	a,(ebullet_cooldown)
				and	a
				jp	nz,upe_next
				
				push	bc
				call	get_random
				pop	bc
; Double probability (~12% chance per frame now)
				cp	60
				jp	nc,upe_next
				
				push	bc
				push	ix
; SHOOT!
				call	spawn_ebullet
				pop	ix
				pop	bc
				
; Set cooldown to ~5 frames for higher density
				ld	a,ENEMY_SHOOT_REPEAT_PER_FRAME
				ld	(ebullet_cooldown),a
				
	upe_next:		
; Fix: 6 bytes offset
				ld	de,6
				add	ix,de
				djnz	upe_loop
				ret
				
	get_enemy_addr:		
; Input: IX = current enemy pointer
; Output: HL = VRAM address
; enemy_scr_y
				ld	a,(ix+3)
				ld	d,a
				ld	a,(ix+4)
				ld	e,a
				jp	get_screen_addr
				
; -----------------------------------------------------------------------------
; ENEMY BULLET SYSTEM & AIMING
; -----------------------------------------------------------------------------
	hl_temp:		
	l_temp:			db	0
	h_temp:			db	0
				
	init_ebullets:		
				ld	hl,ebullet_active
				ld	b,MAX_EBULLETS
				xor	a
	ieb_loop:		ld	(hl),a
				inc	hl
				djnz	ieb_loop
				ret
				
; -----------------------------------------------------------------------------
; SAFE ENEMY BULLET SPAWN
; -----------------------------------------------------------------------------
	spawn_ebullet:		
				ld	hl,ebullet_active
				ld	b,MAX_EBULLETS
				ld	c,0
	seb_fnd_loop:		ld	a,(hl)
				and	a
				jp	z,seb_fnd_ok
				inc	hl
				inc	c
				djnz	seb_fnd_loop
				ret
				
	seb_fnd_ok:		
				ld	(hl),1
				
; 1. Aiming (dx, dy)
				ld	a,(ix+3)
				add	a,a
				inc	a
; D = Enemy Center PX
				ld	d,a
				ld	a,(player_x)
				add	a,a
				inc	a
				sub	d
; D = dx
				ld	d,a
				
				ld	a,(ix+4)
				ld	e,a
				add	a,a
				add	a,e
				inc	a
; E = Enemy Center PY
				ld	e,a
				ld	a,(player_y)
				ld	h,a
				add	a,a
				add	a,h
				inc	a
				sub	e
; E = dy
				ld	e,a
				
; 2. SMART SPAWN POINT (H=PX, L=PY)
				ld	a,(ix+3)
				add	a,a
; H = Base PX (left edge)
				ld	h,a
				ld	a,(ix+4)
				ld	l,a
				add	a,a
				add	a,l
; L = Base PY (top)
				ld	l,a
				
; Determine direction based on dy
				ld	a,e
				bit	7,a
; Shoots up
				jp	nz,seb_dir_up
				cp	5
; Shoots down
				jp	nc,seb_dir_down
				
; SHOOT SIDEWAYS
	seb_dir_side:		
				inc	l
; PY = eye level
				inc	l
				ld	a,d
				bit	7,a
				jp	nz,seb_dir_left
; PX = right edge
	seb_dir_right:		ld	a,h
				add	a,4
				ld	h,a
				jp	seb_safe_store
; PX = left edge
	seb_dir_left:		dec	h
				jp	seb_safe_store
				
; PY = top half of enemy
	seb_dir_up:		ld	a,l
				add	a,1
				ld	l,a
				inc	h
; PX = center
				inc	h
				jp	seb_safe_store
				
; PY = bottom half of enemy
	seb_dir_down:		ld	a,l
				add	a,4
				ld	l,a
				inc	h
; PX = center
				inc	h
				
	seb_safe_store:		
; --- SAFETY CLIPPING ---
				ld	a,h
				cp	128
				jp	c,seb_x_ok
				ld	h,0
				bit	7,a
				jp	nz,seb_x_ok
				ld	h,127
	seb_x_ok:		ld	a,l
				cp	42
				jp	c,seb_y_ok
				ld	l,41
	seb_y_ok:		
; --- Store using h_temp/l_temp ---
				push	de
				ld	a,h
				ld	(h_temp),a
				ld	a,l
				ld	(l_temp),a
				
; e = index
				ld	e,c
				ld	d,0
				ld	hl,ebullet_px
				add	hl,de
				ld	a,(h_temp)
				ld	(hl),a
				
				ld	hl,ebullet_py
				add	hl,de
				ld	a,(l_temp)
				ld	(hl),a
				pop	de
				
; 3. Calculate Velocity (vx, vy)
				ld	a,d
				and	a
				jp	p,seb_pos_d
				neg
; H = abs(dx)
	seb_pos_d:		ld	h,a
				ld	a,e
				and	a
				jp	p,seb_pos_e
				neg
	seb_pos_e:		cp	h
				jp	nc,seb_max_ok
; A = max(abs_dx, abs_dy)
				ld	a,h
	seb_max_ok:		
; Save bullet index
				push	bc
; Shift counter
				ld	b,0
	seb_sh_loop:		cp	4
				jp	c,seb_sh_done
				srl	a
				inc	b
				jp	seb_sh_loop
	seb_sh_done:		
				ld	a,b
				and	a
; No shift needed
				jp	z,seb_apply_vel
				
	seb_div_loop:		
; Calculate VXS (X velocity)
				ld	a,d
				sra	a
				jp	nz,.skip_x
; If 0, but distance not 0
				ld	a,d
; keep 1 (or -1)
				and	a
				jp	z,.skip_x
; Keep sign
				bit	7,d
				ld	a,1
				jp	z,.skip_x
				ld	a,-1
	.skip_x:		ld	d,a
				
; Calculate VYS (Y velocity)
				ld	a,e
				sra	a
				jp	nz,.skip_y
				ld	a,e
				and	a
				jp	z,.skip_y
				bit	7,e
				ld	a,1
				jp	z,.skip_y
				ld	a,-1
	.skip_y:		ld	e,a
				
				djnz	seb_div_loop
				
; Restore bullet index
	seb_apply_vel:		pop	bc
				push	de
				ld	d,0
				ld	e,c
				ld	hl,ebullet_vx
				add	hl,de
				pop	de
; Save vx
				ld	(hl),d
				
				push	de
				ld	d,0
				ld	e,c
				ld	hl,ebullet_vy
				add	hl,de
				pop	de
; Save vy
				ld	(hl),e
				ret
				
	update_ebullets:	
				ld	b,MAX_EBULLETS
				ld	c,0
	ueb_loop:		push	bc
				ld	hl,ebullet_active
				ld	b,0
				add	hl,bc
				ld	a,(hl)
				and	a
; Jump directly to next enemy bullet processing
				jp	z,ueb_next_eb
				
				ld	hl,ebullet_px
				add	hl,bc
				ld	d,(hl)
				ld	hl,ebullet_py
				add	hl,bc
				ld	e,(hl)
				
				push	de
				push	bc
				call	PlotPixel
				call	get_vram_bc
				
; --- DON'T ERASE ENEMY BODY ---
				ld	a,(hl)
				cp	187
				jp	z,ueb_skip_erase
				cp	183
				jp	z,ueb_skip_erase
				cp	175
				jp	z,ueb_skip_erase
				cp	173
				jp	z,ueb_skip_erase
				
				ld	a,32
				ld	(hl),a
	ueb_skip_erase:		
				pop	bc
				pop	de
				
				ld	hl,ebullet_vx
				add	hl,bc
				ld	a,d
				add	a,(hl)
; New PX
				ld	d,a
				
				ld	hl,ebullet_vy
				add	hl,bc
				ld	a,e
				add	a,(hl)
; New PY
				ld	e,a
				
				ld	a,d
				cp	128
				jp	nc,ueb_destroy
				ld	a,e
; Top of HUD
				cp	42
				jp	nc,ueb_destroy
				
				ld	hl,ebullet_px
				add	hl,bc
				ld	(hl),d
				ld	hl,ebullet_py
				add	hl,bc
				ld	(hl),e
				
				push	bc
				call	PlotPixel
				push	af
				
; --- CHECK PLAYER HIT ---
				call	check_player_hit
				jp	c,ueb_hit_player
				
				call	get_vram_bc
				ld	a,(hl)
				call	check_ebullet_walkable
; Hit wall!
				jp	nz,ueb_destroy_cl
				
; --- DO NOT DRAW OVER ENEMY BODY ---
				ld	a,(hl)
				cp	187
				jp	z,ueb_skip_draw
				cp	183
				jp	z,ueb_skip_draw
				cp	175
				jp	z,ueb_skip_draw
				cp	173
				jp	z,ueb_skip_draw
				
				pop	af
; Drawing
				ld	(hl),a
				jp	ueb_after_draw
				
	ueb_skip_draw:		pop	af
	ueb_after_draw:		pop	bc
				jp	ueb_next_eb
				
	ueb_destroy_cl:		pop	af
				pop	bc
	ueb_destroy:		ld	hl,ebullet_active
				add	hl,bc
				ld	(hl),0
				jp	ueb_next_eb
				
	ueb_next_eb:		
				pop	bc
				inc	c
				dec	b
				jp	nz,ueb_loop
				ret
				
; -----------------------------------------------------------------------------
; PLAYER HIT AND DEATH SEQUENCE
; -----------------------------------------------------------------------------
	ueb_hit_player:		
; Clean up immediate stack
				pop	af
				pop	bc
				
				ld	hl,player_hp
				dec	(hl)
				ld	a,(hl)
				
				push	af			; Z flag kimentése a dec (hl) után
				call	draw_hp_bar		; HP sáv csökkentése a képernyőn
				pop	af			; Z flag visszatöltése
				
				jp	z,.player_die		; Ha 0 lett a HP, meghal
				
; Player got hit but survived
				push	bc
				call	music_mute
				call	trigger_shoot_sound
				ld	a,4
				ld	(music_skip_count),a
				pop	bc
				jp	ueb_destroy
				
	.player_die:		
; Hard reset stack to be perfectly safe before sequence
				pop	hl			; recover stack afetr call but without returning with ret
				jp	player_death
				
	player_death:		
				call	music_mute
; Hardware explosion sound
				call	trigger_explosion
				
; Phase 1 (Solid block)
				call	get_player_addr
				ld	(hl),191
				inc	hl
				ld	(hl),191
				ld	de,63
				add	hl,de
				ld	(hl),191
				inc	hl
				ld	(hl),191
				call	delay_death
				
; Phase 2 (Medium particles)
				call	get_player_addr
				ld	(hl),138
				inc	hl
				ld	(hl),133
				ld	de,63
				add	hl,de
				ld	(hl),148
				inc	hl
				ld	(hl),160
				call	delay_death
				
; Phase 3 (Small dispersed)
				call	get_player_addr
				ld	(hl),136
				inc	hl
				ld	(hl),129
				ld	de,63
				add	hl,de
				ld	(hl),130
				inc	hl
				ld	(hl),144
				call	delay_death
				
; Phase 4 (Erase)
				call	erase_player
				
; Update Lives
				call	decrease_lives
				jp	c,game_over
				jp	restart_level_after_death
				
; -----------------------------				
; --- AY HARDWARE EXPLOSION ---
; -----------------------------
	trigger_shoot_sound:	
				ld	d,7
				ld	e,$37			; Noise enabled on A only. Tone disabled
				call	write_ay
				ld	d,6
				ld	e,5
; Noise Period (higher pitch for shoot)
				call	write_ay
				ld	d,8
				ld	e,$10
; Vol A: Envelope mode
				call	write_ay
				ld	d,9
				ld	e,0			; Vol B: Off for quieter sound
				call	write_ay
				ld	d,10
				ld	e,0			; Vol C: Off for quieter sound
				call	write_ay
				ld	d,11
				ld	e,$00
; Env Period L
				call	write_ay
				ld	d,12
				ld	e,$0A
; Env Period H (short burst)
				call	write_ay
				ld	d,13
				ld	e,0
; Env Shape: Single decay and off
				call	write_ay
				ret
				
	trigger_explosion:	
				ld	d,7
				ld	e,$27			; Noise enabled on A & B. Tone disabled
				call	write_ay
				ld	d,6
				ld	e,15
; Noise Period (mid-low rumble)
				call	write_ay
				ld	d,8
				ld	e,$10
; Vol A: Envelope mode
				call	write_ay
				ld	d,9
				ld	e,$10			; Vol B: Envelope mode
				call	write_ay
				ld	d,10
				ld	e,0			; Vol C: Off for quieter sound
				call	write_ay
				ld	d,11
				ld	e,$00
; Env Period L
				call	write_ay
				ld	d,12
				ld	e,$20
; Env Period H ($20 is fairly long)
				call	write_ay
				ld	d,13
				ld	e,0
; Env Shape: Single decay and off
				call	write_ay
				ret
				
	write_ay:		
				ld	c,$1F
				out	(c),d
				ld	c,$1E
				out	(c),e
				ret
; -----------------------------
				
	delay_death:		
; Extended loop count to balance missing music_play
				ld	b,30
	.dd_loop:		
				push	bc
				call	waste_time_loop
				pop	bc
				dec	b
				jp	nz,.dd_loop
				ret
				
	decrease_lives:		
; Decrement numeric lives counter
				ld	hl,player_lives
				dec	(hl)
				
; Decrement ASCII HUD values
				ld	hl,HUD_MEN+1
				ld	a,(hl)
				dec	a
				cp	'0'-1
				jp	nz,.dl_ok
; Set units to 9
				ld	a,'9'
				ld	(hl),a
; Decrement tens
				dec	hl
				ld	a,(hl)
				dec	a
	.dl_ok:			
				ld	(hl),a
				
; Update HUD on screen
				ld	hl,HUD_MEN
				ld	de,$3C00 + 1024 - 64 + 34
				ld	bc,2
				ldir
				
; Check Game Over using the numeric value
				ld	a,(player_lives)
				and	a			; Check if lives reached 0
				jp	nz,.dl_alive
				
; Signal Game Over (Carry=1)
				scf
				ret
	.dl_alive:		
; Signal Alive (Carry=0)
				and	a
				ret
				
	game_over:		
; Először frissítjük a rekordot, ha kell
				call	check_highscore
				
; Ezután nullázzuk a HUD_TEXT első 6 karakterét ASCII '0'-ra
				ld	hl,HUD_TEXT
				ld	b,6
				ld	a,'0'
	.rst_sc_loop:		
				ld	(hl),a
				inc	hl
				djnz	.rst_sc_loop
				
; Törlés és kiírás
				call	$01c9
				call	draw_copyright
				jp	copy_loop
				
	check_highscore:	
				ld	hl,COPY_TEXT4
				ld	bc,18			; Max length to search
				ld	a,'-'
				cpir
				ld	d,h
				ld	e,l
				ld	hl,HUD_TEXT
				ld	b,6
	.ch_loop:		
				ld	a,(de)
				cp	(hl)
				jp	c,.ch_update
				jp	nz,.ch_done
				inc	hl
				inc	de
				dec	b
				jp	nz,.ch_loop
	.ch_done:		
				ret
				
	.ch_update:		
				ld	hl,COPY_TEXT4
				ld	bc,18			; Max length to search
				ld	a,'-'
				cpir
				ld	d,h
				ld	e,l
				ld	hl,HUD_TEXT
				ld	bc,6
				ldir
				ret
				
	restart_level_after_death:	
; Mute music while loading
				call	music_mute
				
; Decompress the map again (resets to start)
				ld	hl,MAP_LEVEL_01_ZX7
				ld	de,MAP_BUFFER
				call	ZX7_DECOMPRESS
				
; Read original enemy count for current level (Offset is 5 bytes in level_data)
				ld	a,(current_level)
				ld	l,a
				ld	h,0
				add	hl,hl
				add	hl,hl
				add	hl,hl
				ld	de,level_data
				add	hl,de
				
				push	hl
				ld	de,3
				add	hl,de
				ld	a,(hl)
				ld	(HUD_ENEMY),a
				inc	hl
				ld	a,(hl)
				ld	(HUD_ENEMY+1),a
				pop	hl
				
				ld	de,5
				add	hl,de
				ld	a,(hl)
				ld	(current_enemy_cnt),a
				
; Reset map pointers
				ld	hl,MAP_BUFFER+256*64-1
				ld	(prev_char_ptr3+1),hl
				ld	hl,LEVEL_SIZE
				ld	(level_counter+1),hl
				
				call	generate_enemies
				call	generate_medkits
				
; CLS
				call	$01c9
; Draw HUD
				call	draw_HUD
				
; Init player (also resets player and enemy bullets!)
				call	init_player
; Draw Player initially
				call	draw_player
				jp	game_loop
				
; Input: B = Bullet cx, C = Bullet cy
; Output: Carry = 1 if hit
	check_player_hit:	
				ld	a,b
				ld	hl,player_x
				sub	(hl)
				jp	c,.cph_no
				cp	2
				jp	nc,.cph_no
				
				ld	a,c
				ld	hl,player_y
				sub	(hl)
				jp	c,.cph_no
				cp	2
				jp	nc,.cph_no
				
; HIT!
				scf
				ret
	.cph_no:		
				and	a
				ret
				
; -----------------------------------------------------------------------------
; HELPER: FIND SPAWN X
; Scans row E in MAP_BUFFER for a walkable 2x2 space
; Input: E = Map Y row (0-255)
; Output: A = Map X column (0-63)
; -----------------------------------------------------------------------------
	find_spawn_x:		
; Calculate HL = MAP_BUFFER ($C000) + E * 64
				ld	a,e
				rrca
				rrca
				ld	l,a
				and	$C0
				ld	l,a
				ld	a,e
				rrca
				rrca
				and	$3F
; High byte of MAP_BUFFER
				add	a,$C0
				ld	h,a
				
				call	get_random
; Random starting X (0-63)
				and	$3F
; Limit to 62 to avoid 2x2 wrapping
				cp	63
				jp	c,.fsx_start
				ld	a,62
	.fsx_start:		
; B = X counter
				ld	b,a
; Try max 64 times
				ld	c,64
				
	fsx_scan_loop:		
				push	hl
				ld	e,b
				ld	d,0
; HL points to MAP_BUFFER[Y][X]
				add	hl,de
				
; Top-Left
				ld	a,(hl)
				call	check_spawnable
				jp	nz,fsx_next_spot
; Top-Right
				inc	hl
				ld	a,(hl)
				call	check_spawnable
				jp	nz,fsx_next_spot
; Bottom-Left
				ld	de,63
				add	hl,de
				ld	a,(hl)
				call	check_spawnable
				jp	nz,fsx_next_spot
; Bottom-Right
				inc	hl
				ld	a,(hl)
				call	check_spawnable
				jp	z,fsx_found_spot
				
	fsx_next_spot:		
				pop	hl
				inc	b
				ld	a,b
				cp	63
				jp	c,.fsx_nowrap
				ld	b,0
	.fsx_nowrap:		
				dec	c
				jp	nz,fsx_scan_loop
				
				ld	a,b
				ret
				
	fsx_found_spot:		
				pop	hl
				ld	a,b
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
; COMMANDO ENGINE - PLAYER MOVEMENT & ANIMATION
;--------------------------------------------------------------------------------------------------------------------------------------
; Player X coordinate (0-63)
	player_x		db	32
; Player Y coordinate (10-13 for bottom 1/3)
	player_y		db	13
; Player hit points (internal)
	player_hp		db	5
; Background character storage
	bg_char			db	32
; Delay counter for movement speed
	move_delay		db	0
; Animation frame counter
	anim_cnt		db	0
; Flag to trigger animation step
	anim_req		db	0
; Flag to trigger map scroll
	scroll_requested	db	0
				
	MAX_BULLETS		equ	4
				
; 1=Up, 2=Right, 3=Left (Default: Up)
	player_dir		db	1
; 0=Released, 1=Pressed
	fire_debounce		db	0
; Temporary storage for bullet update
	temp_dir		db	0
				
; 0=Inactive, 1=Up, 2=Right, 3=Left
	bullet_active		ds	MAX_BULLETS
	bullet_x		ds	MAX_BULLETS
	bullet_y		ds	MAX_BULLETS
				
	old_player_x		db	32
	old_player_y		db	12
	old_anim_cnt		db	0
				
	init_player:		
				ld	a,32
				ld	(player_x),a
; Initialize old X
				ld	(old_player_x),a
				ld	a,12
				ld	(player_y),a
; Initialize old Y
				ld	(old_player_y),a
				xor	a
				ld	(move_delay),a
				
				ld	a,6
				ld	(player_hp),a
				
				ld	a,32
				ld	(player_x),a
; init vertical position
				ld	a,12
				ld	(player_y),a
				xor	a
				ld	(move_delay),a
				ld	(scroll_requested),a
				ld	(anim_cnt),a
				ld	(music_skip_count),a
; Clear all bullets
				call	init_bullets
; Init enemy bullets
				call	init_ebullets
				
				call	draw_hp_bar		; Kezdeti tele HP sáv kirajzolása
				
				ret
				
	erase_player:		
				call	get_player_addr
; ASCII space (or 128 if you prefer)
				ld	a,32
				
; Erase Top-Left
				ld	(hl),a
				inc	hl
; Erase Top-Right
				ld	(hl),a
				
; Move to Bottom-Left
				ld	bc,63
				add	hl,bc
				
; Erase Bottom-Left
				ld	(hl),a
				inc	hl
; Erase Bottom-Right
				ld	(hl),a
				ret
				
	draw_player:		
				call	get_player_addr
				
; Draw Top-Left
				ld	(hl),174
				inc	hl
; Draw Top-Right
				ld	(hl),158
				
; Move to Bottom-Left
				ld	bc,63
				add	hl,bc
				
; Evaluate animation frame
				ld	a,(anim_cnt)
				bit	2,a
				jp	z,draw_frame_1
				
	draw_frame_2:		
; Draw Bottom-Left F2
				ld	(hl),134
				inc	hl
; Draw Bottom-Right F2
				ld	(hl),169
				ret
				
	draw_frame_1:		
; Draw Bottom-Left F1
				ld	(hl),150
				inc	hl
; Draw Bottom-Right F1
				ld	(hl),137
				ret
				
	read_keyboard:		
				ld	a,(move_delay)
				and	a
				jp	z,do_move
				dec	a
				ld	(move_delay),a
; Skip movement this frame
				ret
				
	do_move:		
; Speed throttle (delay frames)
				ld	a,2
				ld	(move_delay),a
				
; Clear animation step request
				xor	a
				ld	(anim_req),a
				
; HL points to Top-Left position in VRAM
				call	get_player_addr
				
; Read keyboard matrix row 7 (14400)
				ld	a,($3840)
				
	chk_left:		
; Check Left
				bit	5,a
				jp	z,chk_right
				ld	a,3
; Update facing direction
				ld	(player_dir),a
				ld	a,(player_x)
				and	a
; Hit left edge (0)
				jp	z,chk_right
				
; Collision check left (Top-Left - 1, Bottom-Left - 1)
				push	hl
				dec	hl
				ld	a,(hl)
				call	check_player_walkable
				jp	nz,skip_left
				ld	de,64
				add	hl,de
				ld	a,(hl)
				call	check_player_walkable
	skip_left:		
				pop	hl
; Skip if obstacle
				jp	nz,chk_right
				
				ld	a,(player_x)
				dec	a
				ld	(player_x),a
				ld	a,1
				ld	(anim_req),a
				
	chk_right:		
				ld	a,($3840)
; Check Right
				bit	6,a
				jp	z,chk_up
				ld	a,2
; Update facing direction
				ld	(player_dir),a
				ld	a,(player_x)
				cp	62
				jp	z,chk_up
				
; Collision check right (Top-Right + 1, Bottom-Right + 1)
				push	hl
				inc	hl
				inc	hl
				ld	a,(hl)
				call	check_player_walkable
				jp	nz,skip_right
				ld	de,64
				add	hl,de
				ld	a,(hl)
				call	check_player_walkable
	skip_right:		
				pop	hl
; Skip if obstacle
				jp	nz,chk_up
				
				ld	a,(player_x)
				inc	a
				ld	(player_x),a
				ld	a,1
				ld	(anim_req),a
				
	chk_up:			
				ld	a,($3840)
; Check Up
				bit	3,a
				jp	z,chk_down
				ld	a,1
; Update facing direction
				ld	(player_dir),a
				
; Collision check up (Top-Left - 64, Top-Right - 64)
				push	hl
				ld	de,64
				and	a
				sbc	hl,de
				ld	a,(hl)
				call	check_player_walkable
				jp	nz,skip_up
				inc	hl
				ld	a,(hl)
				call	check_player_walkable
	skip_up:		
				pop	hl
; Skip if obstacle
				jp	nz,chk_down
				
; Limit to bottom 1/3 (row 10)
				ld	a,(player_y)
				cp	10
				jp	z,request_scroll
				
				dec	a
				ld	(player_y),a
				ld	a,1
				ld	(anim_req),a
				jp	chk_down
				
	request_scroll:		
				ld	a,1
				ld	(scroll_requested),a
				ld	(anim_req),a
				jp	chk_down
				
	chk_down:		
				ld	a,($3840)
; Check Down
				bit	4,a
				jp	z,chk_fire
				
; No direction update when moving down (can't shoot down)
				
				ld	a,(player_y)
				cp	12
				jp	z,chk_fire
				
; Collision check down (Bottom-Left + 64, Bottom-Right + 64)
				push	hl
				ld	de,128
				add	hl,de
				ld	a,(hl)
				call	check_player_walkable
				jp	nz,skip_down
				inc	hl
				ld	a,(hl)
				call	check_player_walkable
	skip_down:		
				pop	hl
; Skip if obstacle
				jp	nz,chk_fire
				
				ld	a,(player_y)
				inc	a
				ld	(player_y),a
				ld	a,1
				ld	(anim_req),a
				
	chk_fire:		
				ld	a,($3840)
; Space key
				bit	7,a
				jp	z,.fire_released
				
				ld	a,(fire_debounce)
				and	a
; Wait for key release
				jp	nz,move_done
				
; HL points to Top-Left of player
				call	get_player_addr
				
				ld	a,(player_dir)
				cp	1
				jp	z,.chk_fire_up
				cp	2
				jp	z,.chk_fire_right
				
	.chk_fire_left:		
				dec	hl
				ld	a,(hl)
				call	check_ebullet_walkable
				jp	nz,.fire_blocked
				ld	de,64
				add	hl,de
				ld	a,(hl)
				call	check_ebullet_walkable
				jp	nz,.fire_blocked
				jp	.fire_ok
				
	.chk_fire_right:	
				inc	hl
				inc	hl
				ld	a,(hl)
				call	check_ebullet_walkable
				jp	nz,.fire_blocked
				ld	de,64
				add	hl,de
				ld	a,(hl)
				call	check_ebullet_walkable
				jp	nz,.fire_blocked
				jp	.fire_ok
				
	.chk_fire_up:		
				ld	de,64
				and	a
				sbc	hl,de
				ld	a,(hl)
				call	check_ebullet_walkable
				jp	nz,.fire_blocked
				inc	hl
				ld	a,(hl)
				call	check_ebullet_walkable
				jp	nz,.fire_blocked
				
	.fire_ok:		
				ld	a,1
; Lock firing
				ld	(fire_debounce),a
				call	spawn_bullet
				
				call	music_mute
				call	trigger_shoot_sound
				ld	a,4
				ld	(music_skip_count),a
				
				jp	move_done
				
	.fire_blocked:		
				ld	a,1
; Lock firing even if blocked to prevent spamming
				ld	(fire_debounce),a
				jp	move_done
				
	.fire_released:		
				xor	a
				ld	(fire_debounce),a
				
	move_done:		
				ld	a,(anim_req)
				and	a
				ret	z
				
				ld	a,(anim_cnt)
				inc	a
				ld	(anim_cnt),a
				ret
				
; -----------------------------------------------------------------------------
; HELPER: ERASE OLD PLAYER POSITION AND UPDATE COORDS
; -----------------------------------------------------------------------------
	update_old_coords:	
				ld	a,(player_x)
				ld	(old_player_x),a
				ld	a,(player_y)
				ld	(old_player_y),a
				ret
				
	erase_old_player:	
				ld	a,(old_player_x)
				ld	d,a
				ld	a,(old_player_y)
				ld	e,a
				call	get_screen_addr
				
; Erase with spaces
				ld	a,32
				ld	(hl),a
				inc	hl
				ld	(hl),a
				ld	bc,63
				add	hl,bc
				ld	(hl),a
				inc	hl
				ld	(hl),a
				ret
				
; -----------------------------------------------------------------------------
; HELPER: Check medkit pickup for player
; -----------------------------------------------------------------------------
	check_medkit_pickup:	
				call	get_player_addr
				
				; Check Top-Left
				ld	a,(hl)
				call	is_medkit_char
				jp	c,.pickup
				
				; Check Top-Right
				inc	hl
				ld	a,(hl)
				call	is_medkit_char
				jp	c,.pickup
				
				; Check Bottom-Left
				ld	de,63
				add	hl,de
				ld	a,(hl)
				call	is_medkit_char
				jp	c,.pickup
				
				; Check Bottom-Right
				inc	hl
				ld	a,(hl)
				call	is_medkit_char
				jp	c,.pickup
				ret
	.pickup:		
				ld	a,6
				ld	(player_hp),a
				call	draw_hp_bar
				
				push	hl
				call	trigger_shoot_sound
				pop	hl
				
				call	add_score		; +10 pont
				call	add_score		; +10 pont
				
				ld	a,(player_x)
				sub	2
				jp	p,.px_ok
				xor	a
	.px_ok:			
				ld	d,a
				ld	a,(player_y)
				sub	2
				jp	p,.py_ok
				xor	a
	.py_ok:			
				ld	e,a
				
				; 6x6 erase area needed to cover 3x3 medkit touched by 2x2 player
				ld	c,6
	.er_row:		
				push	bc
				push	de
				call	get_screen_addr
				ld	b,6
	.er_col:		
				ld	a,(hl)
				call	is_medkit_char
				jp	nc,.er_skip		; If not carry (not medkit), skip erase
	.er_do:			
				ld	(hl),32
	.er_skip:		
				inc	hl
				djnz	.er_col
				pop	de
				inc	e
				pop	bc
				dec	c
				jp	nz,.er_row
				ret
				
; -----------------------------------------------------------------------------
; HELPER: Check if A is a medkit character
; Returns Carry=1 if yes, Carry=0 if no
; -----------------------------------------------------------------------------
	is_medkit_char:		
				cp	'+'
				scf
				ret	z
				cp	140
				scf
				ret	z
				cp	141
				scf
				ret	z
				cp	142
				scf
				ret	z
				cp	149
				scf
				ret	z
				cp	156
				scf
				ret	z
				cp	170
				scf
				ret	z
				cp	172
				scf
				ret	z
				and	a			; Clear carry
				ret
				
; -----------------------------------------------------------------------------
; HELPER: GET VRAM FROM BC
; Input: B = cx (0-63), C = cy (0-15)
; Output: HL = VRAM Address
; -----------------------------------------------------------------------------
	get_vram_bc:		
				ld	d,b
				ld	e,c
				jp	get_screen_addr
				
;--------------------------------------------------------------------------------------------------------------------------------------
; HELPER: Check if character in A is walkable space for PLAYER
; Returns Z flag SET if walkable, otherwise NZ
;--------------------------------------------------------------------------------------------------------------------------------------
	check_player_walkable:	
				cp	32
				ret	z
				cp	128
				ret	z
				cp	'+'
				ret	z
; Allow walking through the new medkit graphics
				cp	140
				ret	z
				cp	141
				ret	z
				cp	142
				ret	z
				cp	149
				ret	z
				cp	156
				ret	z
				cp	170
				ret	z
				cp	172
				ret	z
				
				cp	128
				jp	c,cpw.cw_solid
				push	bc
				ld	c,a
				sub	128
				ld	b,a
				dec	b
				and	b
				ld	a,c
				pop	bc
				ret	z
	cpw.cw_solid:		
				or	1
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------
; HELPER: Check if character in A is walkable space
; Returns Z flag SET if walkable, otherwise NZ
;--------------------------------------------------------------------------------------------------------------------------------------
	check_walkable:		
; Check for ASCII space
				cp	32
				ret	z
; Check for graphic empty space
				cp	128
				ret	z
; Ignore single-pixel pseudo-graphics (bullets)
				cp	128
				jp	c,.cw_solid
				
; Protect BC registers used by parent loops
				push	bc
				ld	c,a
				sub	128
				ld	b,a
				dec	b
				and	b
				ld	a,c
				pop	bc
				ret	z
				
	.cw_solid:		
; Force NZ flag
				or	1
				ret
				
	check_spawnable:	
				cp	32
				ret	z
				cp	128
				ret	z
				or	1
				ret
				
	get_player_addr:	
				ld	a,(player_x)
				ld	d,a
				ld	a,(player_y)
				ld	e,a
				jp	get_screen_addr
				
	check_ebullet_walkable:	
; Enemy Top-Left
				cp	187
				ret	z
; Enemy Top-Right
				cp	183
				ret	z
; Enemy Bottom-Left
				cp	175
				ret	z
; Enemy Bottom-Right
				cp	173
				ret	z
; For the rest, jump to check_walkable
				jp	check_walkable
				
; -----------------------------------------------------------------------------
; BULLET ENGINE ROUTINES (128x48 Pseudo-Pixel version)
; -----------------------------------------------------------------------------
; Pseudo X (0-127)
	bullet_px		ds	MAX_BULLETS
; Pseudo Y (0-47)
	bullet_py		ds	MAX_BULLETS
	hit_cnt:		db	0
	tmp_px:			db	0
	tmp_py:			db	0
				
	init_bullets:		
				ld	hl,bullet_active
				ld	b,MAX_BULLETS
				xor	a
	.ib_loop:		
				ld	(hl),a
				inc	hl
				djnz	.ib_loop
				
; Lock firing initially to prevent shooting if SPACE is still held from menu
				ld	a,1
				ld	(fire_debounce),a
				
; Default direction to up
				ld	(player_dir),a
				ret
				
	spawn_bullet:		
				ld	hl,bullet_active
				ld	b,MAX_BULLETS
				ld	c,0
	.find_slot:		
				ld	a,(hl)
				and	a
				jp	z,.found_slot
				inc	hl
				inc	c
				djnz	.find_slot
				ret
				
	.found_slot:		
				ld	a,(player_dir)
; Activate bullet (1=Up, 2=Right, 3=Left)
				ld	(hl),a
				
				ld	a,c
; Store index temporarily here
				ld	(hit_cnt),a
				
				ld	a,(player_dir)
				cp	2
				jp	z,.s_right
				cp	3
				jp	z,.s_left
				
	.s_up:			
				ld	a,(player_x)
				add	a,a
				add	a,2
; D = Starting PX
				ld	d,a
				ld	a,(player_y)
				ld	h,a
				add	a,a
				add	a,h
				dec	a
; E = Starting PY
				ld	e,a
				jp	.s_final
				
	.s_right:		
				ld	a,(player_x)
				add	a,a
				add	a,4
				ld	d,a
				ld	a,(player_y)
				ld	h,a
				add	a,a
				add	a,h
				inc	a
				ld	e,a
				jp	.s_final
				
	.s_left:		
				ld	a,(player_x)
				add	a,a
				dec	a
				ld	d,a
				ld	a,(player_y)
				ld	h,a
				add	a,a
				add	a,h
				inc	a
				ld	e,a
				
	.s_final:		
; Restore index
				ld	a,(hit_cnt)
				ld	c,a
				ld	b,0
				ld	hl,bullet_px
				add	hl,bc
; Save PX
				ld	(hl),d
				ld	hl,bullet_py
				add	hl,bc
; Save PY
				ld	(hl),e
				ret
				
; -----------------------------------------------------------------------------
; FULL PLAYER BULLET ENGINE (128x48 Pseudo-Pixel version)
; -----------------------------------------------------------------------------
	update_bullets:		
				ld	b,MAX_BULLETS
				ld	c,0
	.ub_loop:		
				push	bc
				
				ld	hl,bullet_active
				ld	e,c
				ld	d,0
				add	hl,de
				ld	a,(hl)
				and	a
; Jump directly to next bullet processing
				jp	z,.ub_skip_inactive
				
				ld	(temp_dir),a
				
				ld	e,c
				ld	d,0
				ld	hl,bullet_px
				add	hl,de
; A = Current PX
				ld	a,(hl)
				
				ld	hl,bullet_py
				add	hl,de
; E = Current PY
				ld	e,(hl)
; D = Current PX
				ld	d,a
; -----------------------
				
; --- ERASE ---
; Save coord for erase
				push	de
; Protect BC
				push	bc
				call	PlotPixel
				call	get_vram_bc
				ld	a,32
				ld	(hl),a
; Restore BC
				pop	bc
; Restore coord for movement
				pop	de
				
; --- MOVEMENT ---
				ld	a,(temp_dir)
				cp	1
				jp	z,.move_up
				cp	2
				jp	z,.move_right
	.move_left:		
				dec	d
				dec	d
				jp	.check_bounds
	.move_right:		
				inc	d
				inc	d
				jp	.check_bounds
	.move_up:		
				dec	e
				
	.check_bounds:		
; Boundary check
				ld	a,d
				cp	128
				jp	nc,ber.destroy
				ld	a,e
				cp	42
				jp	nc,ber.destroy
				
; --- SAVE NEW COORDINATES ---
; Save PX, PY
				ld	(hl_temp),de
				
				ld	hl,bullet_px
				ld	e,c
				ld	d,0
				add	hl,de
				ld	a,(h_temp)
				ld	(hl),a
				
				ld	hl,bullet_py
				add	hl,de
				ld	a,(l_temp)
				ld	(hl),a
				
; --- COLLISION CHECK AND DRAWING ---
				ld	a,(h_temp)
				ld	d,a
				ld	a,(l_temp)
				ld	e,a
				
; Protect loop index
				push	bc
				
; Output: B=cx, C=cy, A=char_code
				call	PlotPixel
; Save char code (A)
				push	af
				
; Save char coord
				push	bc
				call	check_enemy_hit
				pop	bc
; If Carry=1, hit!
				jp	c,ber.destroy_cl
				
; Input: B=cx, C=cy. Output: HL=VRAM Address
				call	get_vram_bc
				ld	a,(hl)
				call	check_walkable
; Destroy if hit wall
				jp	nz,ber.destroy_cl
				
; Restore char code
				pop	af
; DRAWING!
				ld	(hl),a
; Restore loop index
				pop	bc
				
	.ub_skip_inactive:	
; Restore loop state
				pop	bc
				inc	c
				dec	b
; Long jump
				jp	nz,.ub_loop
				ret
				
	ber.destroy_cl:		
				pop	af
				pop	bc
	ber.destroy:		
				ld	hl,bullet_active
				ld	e,c
				ld	d,0
				add	hl,de
				xor	a
				ld	(hl),a
				jp	.ub_skip_inactive
				
; -----------------------------------------------------------------------------
; DECREASE ENEMY COUNT ON HUD
; -----------------------------------------------------------------------------
	decrease_enemy_count:	
				ld	a,(current_enemy_cnt)
				and	a
				ret	z
				dec	a
				ld	(current_enemy_cnt),a
				
				ld	hl,HUD_ENEMY+1
				ld	a,(hl)
				dec	a
				cp	'0'-1
				jp	nz,.dec_units_ok
				ld	a,'9'
				ld	(hl),a
				dec	hl
				dec	(hl)
				jp	.dec_draw
	.dec_units_ok:		
				ld	(hl),a
	.dec_draw:		
				ld	hl,HUD_ENEMY
				ld	de,$3c00 + 1024 - 64 + 48
				ld	bc,2
				ldir
				ret
				
; -----------------------------------------------------------------------------
; CHECK ENEMY HIT (Coordinate based)
; Input: B = Bullet Char X (0-63), C = Bullet Char Y (0-15)
; -----------------------------------------------------------------------------
	check_enemy_hit:	
				ld	ix,enemy_data
				ld	a,MAX_ENEMIES
				ld	(hit_count_temp),a
	.h_loop:		
				ld	a,(ix+0)
; Active enemy only
				cp	2
				jp	nz,.h_next
				
; X check
				ld	a,b
				sub	(ix+3)
				jp	c,.h_next
				cp	2
				jp	nc,.h_next
				
; Y check
				ld	a,c
				sub	(ix+4)
				jp	c,.h_next
				cp	2
				jp	nc,.h_next
				
; --- HIT! ---
; State = 3 (Dying)
				ld	(ix+0),3
; Timer for animation frames (6 ticks)
				ld	(ix+5),6
				
				push	bc
				call	decrease_enemy_count
				pop	bc
				
				call	music_mute
				call	trigger_explosion
				ld	a,12
				ld	(music_skip_count),a
				
				call	add_score_100
; Signal hit (Carry=1)
				scf
				ret
				
	.h_next:		
; Fix: 6 bytes offset
				ld	de,6
				add	ix,de
				ld	a,(hit_count_temp)
				dec	a
				ld	(hit_count_temp),a
				jp	nz,.h_loop
				
; No hit (Carry=0)
				and	a
				ret
				
	hit_count_temp:		db	0
				
; -----------------------------------------------------------------------------
; Scroll Bullets
; -----------------------------------------------------------------------------
	scroll_bullets:		
				ld	b,MAX_BULLETS
				ld	c,0
	.sb_loop:		
				push	bc
				ld	hl,bullet_active
				ld	b,0
				add	hl,bc
				ld	a,(hl)
				and	a
; Skip inactive
				jp	z,.sb_next
				
				ld	hl,bullet_py
				add	hl,bc
				ld	a,(hl)
; Shift logic Y down by 3 pseudo-pixels (1 character)
				add	a,3
				ld	(hl),a
				
; Entered HUD area? (HUD starts at pseudo-Y 42)
				cp	42
				jp	c,.sb_next
				
; Destroy if scrolled into HUD
				ld	hl,bullet_active
				add	hl,bc
				xor	a
				ld	(hl),a
				
	.sb_next:		
				pop	bc
				inc	c
				djnz	.sb_loop
				ret
				
; -------------------------------------------------------------
; HELPER - SetPseudoPixel
; Input: D = px (0-127), E = py (0-47)
; Output: B = cx (0-63), C = cy (0-15), A = char_code (128-191)
; -----------------------------------------------------------------------------
	PlotPixel:		
				ld	a,d
; Divide by 2
				srl	a
; B = cx
				ld	b,a
				
				ld	a,d
				and	$01
; H = sub_x (0 or 1)
				ld	h,a
				
; A = y
				ld	a,e
; SAVE H (sub_x) BEFORE using HL for lookup!
				push	hl
				
				ld	l,a
				ld	h,0
				ld	de,y_div3_table
				add	hl,de
; C = cy (0-15)
				ld	c,(hl)
				
				ld	l,a
				ld	h,0
				ld	de,y_mod3_table
				add	hl,de
; E = sub_y (0-2)
				ld	e,(hl)
				
; RESTORE H (sub_x)
				pop	hl
				
; bit index = sub_y * 2 + sub_x
				ld	a,e
; *2
				add	a,a
; +sub_x
				add	a,h
				ld	l,a
				ld	h,0
				ld	de,bit_table
				add	hl,de
; A = bit_value (1..32)
				ld	a,(hl)
				
; char_code = 128 + bit_value
				add	a,$80
				ret
				
; bit table: [row][col] = 1,2,4,8,16,32
	bit_table:		
				db	1,2,4,8,16,32
				
; y / 3 table (0-47)
	y_div3_table:		
				db	0,0,0, 1,1,1, 2,2,2, 3,3,3, 4,4,4, 5,5,5
				db	6,6,6, 7,7,7, 8,8,8, 9,9,9, 10,10,10, 11,11,11
				db	12,12,12, 13,13,13, 14,14,14, 15,15,15
				
; y % 3 table (0-47)
	y_mod3_table:		
				db	0,1,2, 0,1,2, 0,1,2, 0,1,2, 0,1,2, 0,1,2
				db	0,1,2, 0,1,2, 0,1,2, 0,1,2, 0,1,2, 0,1,2
				db	0,1,2, 0,1,2, 0,1,2, 0,1,2, 0,1,2, 0,1,2
				
; Fast Screen Row Lookup Table (0-15)
	row_table:		
				dw	$3c00, $3c40, $3c80, $3cc0, $3d00, $3d40, $3d80, $3dc0
				dw	$3e00, $3e40, $3e80, $3ec0, $3f00, $3f40, $3f80, $3fc0
				
; Input: D = X (0-63), E = Y (0-15)
; Output: HL = VRAM Address
	get_screen_addr:	
				ld	a,e
				add	a,a
				ld	l,a
				ld	h,0
				ld	bc,row_table
				add	hl,bc
				ld	a,(hl)
				inc	hl
				ld	h,(hl)
				ld	l,a
				ld	e,d
				ld	d,0
				add	hl,de
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   
; ZX7_DECOMPRESS - HL: Compressed data, DE: Target address
				
	ZX7_DECOMPRESS						;di				; disable interrupts               
	DZX7STANDARD		ld	A,$80
	COPYBYTELOOPEV		ldi				; copy literal byte
	MAINLOOPEV		add	A,A			; check next bit
				jp	Z,LOADBITS1		; no more bits left?
				jp	C,LENSIZESTARTOD	; next bit indicates either literal or sequence
				
	COPYBYTELOOPOD		ldi				; copy literal byte
	MAINLOOPOD		add	A,A			; check next bit
				jp	NC,COPYBYTELOOPEV	; next bit indicates either literal or sequence
				
; determine number of bits used for length (Elias gamma coding)
	LENSIZESTARTEV		push	DE
				ld	BC,1
				ld	D,B
	LENSIZELOOPEV		inc	D
				add	A,A			; check next bit
				jp	Z,LOADBITS2EV		; no more bits left?
				jp	NC,LENSIZELOOPEV
				jp	LENVALUESTARTEV
				
; determine number of bits used for length (Elias gamma coding)
	LENSIZESTARTOD		push	DE
				ld	BC,1
				ld	D,B
	LENSIZELOOPOD		inc	D
				add	A,A			; check next bit
				jp	Z,LOADBITS2OD		; no more bits left?
				jp	NC,LENSIZELOOPOD
				jp	LENVALUESTARTOD
				
; determine length
	LENVALUELOOPEV		add	A,A			; check next bit
				jp	Z,LOADBITS3EV		; no more bits left?
				rl	C
				rl	B
				jp	C,EXITEV		; check end marker
	LENVALUESTARTEV		dec	D
				jp	NZ,LENVALUELOOPEV
				inc	BC			; adjust length
				
; determine offset                           
	OFFSETSTARTOD		ld	E,(HL)			; load offset flag (1 bit) + offset value (7 bits)
				inc	HL
				sll	E			; opcode for undocumented instruction "SLL E" aka "SLS E"
				jp	NC,OFFSETENDOD		; if offset flag is set,load 4 extra bits
				add	A,A			; check next bit
				rl	D			; insert first bit into D
				add	A,A			; check next bit
				jp	Z,LOADBITS4		; no more bits left?
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				jp	Z,LOADBITS5		; no more bits left?
				ccf
				jp	C,OFFSETENDOD
	OFFSETINCOD		inc	D			; equivalent to adding 128 to DE
	OFFSETENDOD		rr	E			; insert inverted fourth bit into E
				
; copy previous sequence
				ex	(SP),HL			; store source,restore destination
				push	HL			; store destination
				sbc	HL,DE			; HL = destination - offset - 1
				pop	DE			; DE = destination
				ldir
				pop	HL			; restore source address (compressed data)
				jp	MAINLOOPOD
				
	LOADBITS1		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jp	C,LENSIZESTARTOD	; next bit indicates either literal or sequence
				jp	COPYBYTELOOPOD
				
	LOADBITS2EV		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jp	NC,LENSIZELOOPEV
				jp	LENVALUESTARTEV
				
	LOADBITS2OD		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jp	NC,LENSIZELOOPOD
				jp	LENVALUESTARTOD
				
	LOADBITS3EV		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	C
				rl	B
				jp	NC,LENVALUESTARTEV	; check end marker
	EXITEV			pop	DE
				ret
				
	LOADBITS4		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jp	C,OFFSETENDOD
				jp	OFFSETINCOD
				
	LOADBITS5		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				ccf
				jp	C,OFFSETENDOD
				jp	OFFSETINCOD
				
; determine length
	LENVALUELOOPOD		add	A,A			; check next bit
				jp	Z,LOADBITS3OD		; no more bits left?
				rl	C
				rl	B
				jp	C,EXITOD		; check end marker
	LENVALUESTARTOD		dec	D
				jp	NZ,LENVALUELOOPOD
				inc	BC			; adjust length                              
				
; determine offset
	OFFSETSTARTEV		ld	E,(HL)			; load offset flag (1 bit) + offset value (7 bits)
				inc	HL
				sll	E			; opcode for undocumented instruction "SLL E" aka "SLS E"
				jp	NC,OFFSETENDEV		; if offset flag is set,load 4 extra bits
				add	A,A			; check next bit
				jp	Z,LOADBITS6		; no more bits left?
				rl	D			; insert first bit into D
				add	A,A			; check next bit
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				jp	Z,LOADBITS7		; no more bits left?
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jp	C,OFFSETENDEV
	OFFSETINCEV		inc	D			; equivalent to adding 128 to DE
	OFFSETENDEV		rr	E			; insert inverted fourth bit into E
				
; copy previous sequence
				ex	(SP),HL			; store source,restore destination
				push	HL			; store destination
				sbc	HL,DE			; HL = destination - offset - 1
				pop	DE			; DE = destination
				ldir
				pop	HL			; restore source address (compressed data)
				jp	MAINLOOPEV
				
	LOADBITS3OD		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	C
				rl	B
				jp	NC,LENVALUESTARTOD	; check end marker
	EXITOD			pop	DE
				ret
				
	LOADBITS6		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	D			; insert first bit into D
				add	A,A			; check next bit
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jp	C,OFFSETENDEV
				jp	OFFSETINCEV
				
	LOADBITS7		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jp	C,OFFSETENDEV
				jp	OFFSETINCEV
				ret
				
;===============================================================================
; PLAY  PT2/PT3 sound files
;===============================================================================
;	Ported to HT-1080Z by Béla Szalontai (Fast & Force)
				
;
; ProTracker3 Extreme (P3X) player for ZX Spectrum
; Copyright (c) 2004-2007 S.V.Bulba (http://bulba.untergrund.net)
; formatted for Pasmo by Gasman
; optimized by Cheveron
; sjasmplus adaptation by © 2013 z00m/SinDiKat
; improved by © 2016-2020 mborik/SinDiKat		
				
	NULL			equ	0
				
; bit.0 if you want to play without looping
; bit.1 if you play looped but fadeout after few seconds
; bit.7 is set each time when loop or fadeout was passed
; ...or simplified:	2 - fadeout after loop
;			1 - no loop
;			0 - loop forever
	music_setup:		db	0
				
	music_init:		ld	hl,MUS_BUFFER
	music_init0:		push	hl
				ld	bc,$40			; look for "by" identifier
				add	hl,bc
				ld	a,(hl)
				cp	'y'
				dec	hl
				ld	a,(hl)
				pop	hl
				jr	z,pt3fmt_init
				cp	'b'
				jr	z,pt3fmt_init
				ld	a,(hl)			; and first byte of PT2 is delay
				cp	c			; compared to PT3 text identifier
				jp	c,pt2fmt_init
				
	pt3fmt_init		call	setmodaddr
				push	hl
				ld	de,100
				add	hl,de
				ld	a,(hl)
				ld	(delay),a
				push	hl
				pop	ix
				add	hl,de
				ld	(CrPsPtr+1),hl
				ld	e,(ix+2)
				add	hl,de
				inc	hl
				ld	(LPosPtr+1),hl
				pop	de
				ld	l,(ix+3)
				ld	h,(ix+4)
				add	hl,de
				ld	(PatsPtr+1),hl
				ld	hl,$A9
				add	hl,de
				ld	(OrnPtrs+1),hl
				ld	hl,$69
				add	hl,de
				ld	(SamPtrs+1),hl
				
				ld	a,(ix+256-87)		; extract version number
				sub	'0'
				jr	c,l20
				cp	10
				jr	c,l21
	l20:			ld	a,6
	l21:			ld	(Version+1),a
				push	af
				cp	4
				ld	a,(ix+256-1)		; tone table number
				rla
				and	7
				push	af
				
				ld	hl,$18 + ((smp_-SamCnv-2)<<8); jr smp_
				ld	(SamCnv),hl
				ld	a,$BA			; cp d
				ld	(OrnCP),a
				ld	(SamCP),a
				ld	a,$7B			; ld a,e
				ld	(OrnLD),a
				ld	(SamLD),a
				ld	a,$87			; add a,a
				ld	(SamClc2),a
				ld	hl,0
				ld	de,PT3_EmptySmpOrn
				ld	a,pt3pattdc-ptdecode-2
				jr	ptx_initcommon
				
	pt2fmt_init:		ld	(delay),a
				push	hl
				push	hl
				push	hl
				inc	hl
				inc	hl
				ld	a,(hl)
				inc	hl
				ld	(SamPtrs+1),hl
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
				pop	hl
				and	a
				sbc	hl,de
				call	setmodaddr
				pop	hl
				ld	de,67
				add	hl,de
				ld	(OrnPtrs+1),hl
				ld	e,32
				add	hl,de
				ld	c,(hl)
				inc	hl
				ld	b,(hl)
				ld	e,30
				add	hl,de
				ld	(CrPsPtr+1),hl
				ld	e,a
				inc	hl
				
				add	hl,de
				ld	(LPosPtr+1),hl
				pop	hl
				add	hl,bc
				ld	(PatsPtr+1),hl
				ld	a,5
				ld	(Version+1),a
				push	af
				ld	a,2
				push	af
				ld	hl,$51CB		; bit 2,c
				ld	(SamCnv),hl
				ld	a,$BB			; cp e
				ld	(OrnCP),a
				ld	(SamCP),a
				ld	a,$7A			; ld a,d
				ld	(OrnLD),a
				ld	(SamLD),a
				ld	a,$80			; add a,b
				ld	(SamClc2),a
				ld	hl,$8687		; add a,a,(hl)
				ld	de,PT2_EmptySmpOrn
				ld	a,pt2pattdc-ptdecode-2
				
	ptx_initcommon:		ld	(PsCalc),hl
				ld	(ptdecode+1),a
				push	de
				
; note table data depacker
				ld	de,T_PACK
				ld	bc,T1_+(2*49)-1
	tp_0:			ld	a,(de)
				inc	de
				cp	15*2
				jr	nc,tp_1
				ld	h,a
				ld	a,(de)
				ld	l,a
				inc	de
				jr	tp_2
	tp_1:			push	de
				ld	d,0
				ld	e,a
				add	hl,de
				add	hl,de
				pop	de
	tp_2:			ld	a,h
				ld	(bc),a
				dec	bc
				ld	a,l
				ld	(bc),a
				dec	bc
				sub	$F0			; low ($F8*2)
				jr	nz,tp_0
				
				ld	(GlobalAttn+1),a
				ld	(chkfadeout+1),a
				ld	hl,music_setup
				res	7,(hl)
				
				ld	hl,VARS
				ld	(hl),a
				ld	de,VARS+1
				ld	bc,VAR0END-VARS-1
				ldir
				inc	hl
				ld	(AdInPtA+1),hl		; ptr to zero
				inc	a
				ld	(DelyCnt),a
				ld	hl,$F001		; H - CHP.Volume, L - CHP.NtSkCn
				ld	(ChanA+CHP.NtSkCn),hl
				ld	(ChanB+CHP.NtSkCn),hl
				ld	(ChanC+CHP.NtSkCn),hl
				pop	hl
				ld	(ChanA+CHP.OrnPtr),hl	; ornament 0 is "0,1,0"
				ld	(ChanB+CHP.OrnPtr),hl	; in all versions from
				ld	(ChanC+CHP.OrnPtr),hl	; 3.xx to 3.6x and VTII
				pop	af
				
;NoteTableCreator (c) Ivan Roshin
;A - NoteTableNumber*2+VersionForNoteTable
;	xx1b - 3.xx..3.4r
;	xx0b - 3.4x..3.6x - VortexTracker II
				
				ld	hl,nt_data
				push	de
				ld	d,b
				add	a,a
				ld	e,a
				add	hl,de
				ld	e,(hl)
				inc	hl
				srl	e
				sbc	a,a
				and	$A7			; $00 (NOP) or $A7 (AND A)
				ld	(l3),a
				ex	de,hl
				pop	bc			; bc = T1_
				add	hl,bc
				ld	a,(de)
				add	a,T_ & FFh
				ld	c,a
				adc	a,T_ / 256
				sub	c
				ld	b,a
				push	bc
				ld	de,NT_
				push	de
				ld	b,12
	l1:			push	bc
				ld	c,(hl)
				inc	hl
				push	hl
				ld	b,(hl)
				push	de
				ex	de,hl
				ld	de,$17
				ld	ixh,8
	l2:			srl	b
				rr	c
	l3:			add	hl,de			; will be replaced by AND A or NOP apparently
				ld	a,c
				adc	a,d
				ld	(hl),a
				inc	hl
				ld	a,b
				adc	a,d
				ld	(hl),a
				add	hl,de
				dec	ixh
				jr	nz,l2
				
				pop	de
				inc	de
				inc	de
				pop	hl
				inc	hl
				pop	bc
				djnz	l1
				
				pop	hl
				pop	de
				ld	a,e
				cp	TCOLD_1 & FFh
				jr	nz,corr_1
				ld	a,$FD
				ld	(NT_+$002E),a
	corr_1:			ld	a,(de)
				and	a
				jr	z,tc_exit
				rra
				push	af
				add	a,a
				ld	c,a
				add	hl,bc
				pop	af
				jr	nc,corr_2
				dec	(hl)
				dec	(hl)
	corr_2:			inc	(hl)
				and	a
				sbc	hl,bc
				inc	de
				jr	corr_1
	tc_exit:		pop	af
				
; VolTableCreator (c) Ivan Roshin
; A - VersionForVolumeTable
;	(0..4 - v3.xx .. v3.4x
;	(5..  - v2.x, v3.5x .. v3.6x (VT2) .. v3.7)
				
				cp	5
				ld	hl,17
				ld	d,h
				ld	e,h
				ld	a,$17
				jr	nc,m1
				dec	l
				ld	e,l
				xor	a
	m1:			ld	(m2),a
				ld	ix,VT_+16
				ld	c,16
	initloop2:		push	hl
				add	hl,de
				ex	de,hl
				sbc	hl,hl
	initloop1:		ld	a,l
	m2:			ld	a,l
				ld	a,h
				adc	a,0
				ld	(ix+0),a
				inc	ix
				add	hl,de
				inc	c
				ld	a,c
				and	15
				jr	nz,initloop1
				pop	hl
				ld	a,e
				cp	$77
				jr	nz,m3
				inc	e
	m3:			ld	a,c
				and	a
				jr	nz,initloop2
				jp	rout_a0
				
	setmodaddr:		ld	(modaddr+1),hl
				ld	(mdaddr1+1),hl
				ld	(mdaddr2+1),hl
				ret
				
; PT2 pattern decoder ---------------------------------------------------------
	pd2_sam			call	setsam
				jr	pd2_loop
				
	pd2_eoff		ld	(ix+256-12+CHP.Env_En),a
				jr	pd2_loop
				
	pd2_env			ld	(ix+256-12+CHP.Env_En),16
				ld	(AYREGS+AR_EnvTp),a
				ld	a,(bc)
				inc	bc
				ld	l,a
				ld	a,(bc)
				inc	bc
				ld	h,a
				ld	(EnvBase),hl
				jr	pd2_loop
				
	pd2_orn			call	setorn
				jr	pd2_loop
				
	pd2_skip		inc	a
				ld	(ix+256-12+CHP.NNtSkp),a
				jr	pd2_loop
				
	pd2_vol			rrca
				rrca
				rrca
				rrca
				ld	(ix+256-12+CHP.Volume),a
				jr	pd2_loop
				
	pd2_del			call	c_delay
				jr	pd2_loop
				
	pd2_glis		set	2,(ix+256-12+CHP.Flags)
				inc	a
				ld	(ix+256-12+CHP.TnSlDl),a
				ld	(ix+256-12+CHP.TSlCnt),a
				ld	a,(bc)
				inc	bc
				ld	(ix+256-12+CHP.TSlStp),a
				add	a,a
				sbc	a,a
				ld	(ix+256-12+CHP.TSlStp+1),a
				scf
				jr	pd2_loop2
				
	pd2_port:		res	2,(ix+256-12+CHP.Flags)
				ld	a,(bc)
				inc	bc
				inc	bc			; ignoring precalc delta to right sound
				inc	bc
				scf
				jr	pd2_loop2
				
	pd2_stop:		ld	(ix+256-12+CHP.TSlCnt),a
				jr	pd2_loop
				
	pt2pattdc:		and	a
	pd2_loop2:		ex	af,af'
	pd2_loop:		ld	a,(bc)
				inc	bc
				add	a,$20
				jr	z,pd2_rel
				jr	c,pd2_sam
				add	a,96
				jr	c,pd2_note
				inc	a
				jr	z,pd2_eoff
				add	a,15
				jp	z,pd_fin
				jr	c,pd2_env
				add	a,$10
				jr	c,pd2_orn
				add	a,$40
				jr	c,pd2_skip
				add	a,$10
				jr	c,pd2_vol
				inc	a
				jr	z,pd2_del
				inc	a
				jr	z,pd2_glis
				inc	a
				jr	z,pd2_port
				inc	a
				jr	z,pd2_stop
				ld	a,(bc)
				inc	bc
				ld	(ix+256-12+CHP.CrNsSl),a
				jr	pd2_loop
				
	pd2_rel:		ld	(ix+256-12+CHP.Flags),a
				jr	pd2_exit
				
	pd2_note:		ld	l,a
				ld	a,(ix+256-12+CHP.Note)
				ld	(PrNote+1),a
				ld	(ix+256-12+CHP.Note),l
				xor	a
				ld	(ix+256-12+CHP.TSlCnt),a
				set	0,(ix+256-12+CHP.Flags)
				ex	af,af'
				jr	nc,pd2_noglis
				bit	2,(ix+256-12+CHP.Flags)
				jr	nz,pd2_noport
				ld	(LoStep+1),a
				add	a,a
				sbc	a,a
				ex	af,af'
				ld	h,a
				ld	l,a
				inc	a
				call	setport
	pd2_noport:		ld	(ix+256-12+CHP.TSlCnt),1
	pd2_noglis:		xor	a
				
	pd2_exit:		ld	(ix+256-12+CHP.PsInSm),a
				ld	(ix+256-12+CHP.PsInOr),a
				ld	(ix+256-12+CHP.CrTnSl),a
				ld	(ix+256-12+CHP.CrTnSl+1),a
				jp	pd_fin
				
				
	ptdecode:		jr	pt3pattdc		; patter decoder fork
				
; PT3 pattern decoder ---------------------------------------------------------
	PD_OrSm:		ld	(ix+256-12+CHP.Env_En),0
				call	setorn
	pd_sam_:		ld	a,(bc)
				inc	bc
				rrca
	pd_sam:			call	setsam
				jr	pd_loop
				
	pd_vol:			rrca
				rrca
				rrca
				rrca
				ld	(ix+256-12+CHP.Volume),a
				jr	pd_lp2
				
	pd_eoff:		ld	(ix+256-12+CHP.Env_En),a
				ld	(ix+256-12+CHP.PsInOr),a
				jr	pd_lp2
				
	pd_SorE:		dec	a
				jr	nz,pd_env
				ld	a,(bc)
				inc	bc
				ld	(ix+256-12+CHP.NNtSkp),a
				jr	pd_lp2
				
	pd_env:			call	setenv
				jr	pd_lp2
				
	pd_orn:			call	setorn
				jr	pd_loop
				
	pd_esam:		ld	(ix+256-12+CHP.Env_En),a
				ld	(ix+256-12+CHP.PsInOr),a
				call	nz,setenv
				jr	pd_sam_
				
	pt3pattdc:		ld	a,(ix+256-12+CHP.Note)
				ld	(PrNote+1),a
				ld	l,(ix+256-12+CHP.CrTnSl)
				ld	h,(ix+256-12+CHP.CrTnSl+1)
				ld	(PrSlide+1),hl
				
	pd_loop:		ld	de,$2010
	pd_lp2:			ld	a,(bc)
				inc	bc
				add	a,e
				jr	c,PD_OrSm
				add	a,d
				jr	z,pd_fin
				jr	c,pd_sam
				add	a,e
				jr	z,pd_rel
				jr	c,pd_vol
				add	a,e
				jr	z,pd_eoff
				jr	c,pd_SorE
				add	a,$60
				jr	c,pd_note
				add	a,e
				jr	c,pd_orn
				add	a,d
				jr	c,pd_nois
				add	a,e
				jr	c,pd_esam
				add	a,a
				ld	e,a
				ld	hl,spccoms-$20E0
				add	hl,de
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
				push	de
				jr	pd_loop
				
	pd_nois:		ld	(Ns_base),a
				jr	pd_lp2
				
	pd_rel:			res	0,(ix+256-12+CHP.Flags)
				jr	pd_res
				
	pd_note:		ld	(ix+256-12+CHP.Note),a
				set	0,(ix+256-12+CHP.Flags)
				xor	a
	pd_res:			ld	(pdsp_+1),sp
				ld	sp,ix
				ld	h,a
				ld	l,a
				push	hl
				push	hl
				push	hl
				push	hl
				push	hl
				push	hl
	pdsp_:			ld	sp,NULL
	pd_fin:			ld	a,(ix+256-12+CHP.NNtSkp)
				ld	(ix+256-12+CHP.NtSkCn),a
				ret
				
	c_portm:		ld	a,(bc)
				inc	bc
				inc	bc			; skip precalculated tone delta
				inc	bc			; (because cannot be right after pt3 compilation)
				ex	af,af'
				ld	a,(bc)			; signed tone step
				inc	bc
				ld	(LoStep+1),a
				ld	a,(bc)
				inc	bc
				and	a
				ex	af,af'
				ld	l,(ix+256-12+CHP.CrTnSl)
				ld	h,(ix+256-12+CHP.CrTnSl+1)
				
; Set portamento variables
; A - Delay; A' - Hi(Step); ZF' - (A'=0); HL - CrTnSl
	setport			res	2,(ix+256-12+CHP.Flags)
				ld	(ix+256-12+CHP.TnSlDl),a
				ld	(ix+256-12+CHP.TSlCnt),a
				push	hl
				ld	de,NT_
				ld	a,(ix+256-12+CHP.Note)
				ld	(ix+256-12+CHP.SlToNt),a
				add	a,a
				ld	l,a
				ld	h,0
				add	hl,de
				ld	a,(hl)
				inc	hl
				ld	h,(hl)
				ld	l,a
				push	hl
	PrNote:			ld	a,NULL
				ld	(ix+256-12+CHP.Note),a
				add	a,a
				ld	l,a
				ld	h,0
				add	hl,de
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
				pop	hl
				sbc	hl,de
				ld	(ix+256-12+CHP.TnDelt),l
				ld	(ix+256-12+CHP.TnDelt+1),h
				pop	de
	Version:		ld	a,NULL
				cp	6
				jr	c,LoStep		; old 3xxx for PT v3.5-
	PrSlide:		ld	de,NULL
				ld	(ix+256-12+CHP.CrTnSl),e
				ld	(ix+256-12+CHP.CrTnSl+1),d
	LoStep:			ld	a,0			; signed tone step
				ex	af,af'
				jr	z,nosig
				ex	de,hl
	nosig:			sbc	hl,de
				jp	p,set_stp
				cpl
				ex	af,af'
				neg
				ex	af,af'
	set_stp:		ld	(ix+256-12+CHP.TSlStp+1),a
				ex	af,af'
				ld	(ix+256-12+CHP.TSlStp),a
				ld	(ix+256-12+CHP.COnOff),0
				ret
				
	c_gliss:		set	2,(ix+256-12+CHP.Flags)
				ld	a,(bc)
				inc	bc
				ld	(ix+256-12+CHP.TnSlDl),a
				and	a
				jr	nz,gl36
				ld	a,(Version+1)		;AlCo PT3.7+
				cp	7
				sbc	a,a
				inc	a
	gl36:			ld	(ix+256-12+CHP.TSlCnt),a
				ld	a,(bc)
				inc	bc
				ex	af,af'
				ld	a,(bc)
				inc	bc
				jr	set_stp
				
	c_smpos:		ld	a,(bc)
				inc	bc
				ld	(ix+256-12+CHP.PsInSm),a
				ret
				
	c_orpos:		ld	a,(bc)
				inc	bc
				ld	(ix+256-12+CHP.PsInOr),a
				ret
				
	c_vibrt:		ld	a,(bc)
				inc	bc
				ld	(ix+256-12+CHP.OnOffD),a
				ld	(ix+256-12+CHP.COnOff),a
				ld	a,(bc)
				inc	bc
				ld	(ix+256-12+CHP.OffOnD),a
				xor	a
				ld	(ix+256-12+CHP.TSlCnt),a
				ld	(ix+256-12+CHP.CrTnSl),a
				ld	(ix+256-12+CHP.CrTnSl+1),a
				ret
				
	c_engls:		ld	a,(bc)
				inc	bc
				ld	(Env_Del+1),a
				ld	(CurEDel),a
				ld	a,(bc)
				inc	bc
				ld	l,a
				ld	a,(bc)
				inc	bc
				ld	h,a
				ld	(ESldAdd+1),hl
				ret
				
	c_delay:		ld	a,(bc)
				inc	bc
				ld	(delay),a
				ld	(DelyCnt),a		; bugfix by Lee_dC
				ret
				
	setenv:			ld	(ix+256-12+CHP.Env_En),e
				ld	(AYREGS+AR_EnvTp),a
				ld	a,(bc)
				inc	bc
				ld	h,a
				ld	a,(bc)
				inc	bc
				ld	l,a
				ld	(EnvBase),hl
				xor	a
				ld	(ix+256-12+CHP.PsInOr),a
				ld	(CurEDel),a
				ld	h,a
				ld	l,a
				ld	(CurESld),hl
	c_nop:			ret
				
	setorn:			add	a,a
				ld	e,a
				ld	d,0
				ld	(ix+256-12+CHP.PsInOr),d
	OrnPtrs:		ld	hl,NULL
				add	hl,de
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
	mdaddr2:		ld	hl,NULL
				add	hl,de
				ld	(ix+256-12+CHP.OrnPtr),l
				ld	(ix+256-12+CHP.OrnPtr+1),h
				ret
				
	setsam:			add	a,a
				ld	e,a
				ld	d,0
	SamPtrs:		ld	hl,NULL
				add	hl,de
				ld	e,(hl)
				inc	hl
				ld	d,(hl)
	mdaddr1:		ld	hl,NULL
				add	hl,de
				ld	(ix+256-12+CHP.SamPtr),l
				ld	(ix+256-12+CHP.SamPtr+1),h
				ret
				
; all 16 addresses filled to protect from broken pt3 modules
	spccoms:		dw	c_nop
				dw	c_gliss
				dw	c_portm
				dw	c_smpos
				dw	c_orpos
				dw	c_vibrt
				dw	c_nop
				dw	c_nop
				dw	c_engls
				dw	c_delay
				dw	c_nop
				dw	c_nop
				dw	c_nop
				dw	c_nop
				dw	c_nop
				dw	c_nop
				
	chregs:			xor	a
				ld	(Ampl),a
				bit	0,(ix+CHP.Flags)
				push	hl
				jp	z,ch_exit
				ld	(csp_+1),sp
				ld	l,(ix+CHP.OrnPtr)
				ld	h,(ix+CHP.OrnPtr+1)
				ld	sp,hl
				pop	de
				ld	h,a
				ld	a,(ix+CHP.PsInOr)
				ld	l,a
				add	hl,sp
				inc	a			; PT2	| PT3
	OrnCP:			cp	d			; cp e	| cp d
				jr	c,ch_orps
	OrnLD:			ld	a,e			; a,d	| a,e
	ch_orps:		ld	(ix+CHP.PsInOr),a
				ld	a,(ix+CHP.Note)
				add	a,(hl)
				jp	p,ch_ntp
				xor	a
	ch_ntp:			cp	96
				jr	c,ch_nok
				ld	a,95
	ch_nok:			add	a,a
				ex	af,af'
				ld	l,(ix+CHP.SamPtr)
				ld	h,(ix+CHP.SamPtr+1)
				ld	sp,hl
				pop	de
				ld	h,0
				ld	a,(ix+CHP.PsInSm)
				ld	b,a
				add	a,a			; PT2	| PT3
	SamClc2:		add	a,a			; a,b	| a,a
				ld	l,a
				add	hl,sp
				ld	sp,hl
				ld	a,b
				inc	a
	SamCP:			cp	d			; cp e	| cp d
				jr	c,ch_smps
	SamLD:			ld	a,e			; a,d	| a,e
	ch_smps:		ld	(ix+CHP.PsInSm),a
				pop	bc
				pop	hl
								; PT2     | PT3
	SamCnv:			jr	smp_			; bit 2,c | jr smp_
				
				ld	h,b			; Convert PT2 sample to PT3
				jr	nz,SamCnv1
				ex	de,hl
				and	a
				sbc	hl,hl
				sbc	hl,de
	SamCnv1:		ld	d,c
				rr	c
				sbc	a,a
				cpl
				and	$3E
				rr	c
				rr	b
				and	c
				ld	c,a
				ld	a,b
				rra
				rra
				rr	d
				rra
				and	$9F
				ld	b,a
				
	smp_:			ld	e,(ix+CHP.TnAcc)
				ld	d,(ix+CHP.TnAcc+1)
				add	hl,de
				bit	6,b
				jr	z,ch_noac
				ld	(ix+CHP.TnAcc),l
				ld	(ix+CHP.TnAcc+1),h
	ch_noac:		ex	de,hl
				ex	af,af'
				ld	l,a
				ld	h,0
				ld	sp,NT_
				add	hl,sp
				ld	sp,hl
				pop	hl
				add	hl,de
				ld	e,(ix+CHP.CrTnSl)
				ld	d,(ix+CHP.CrTnSl+1)
				add	hl,de
	csp_:			ld	sp,NULL
				ex	(sp),hl
				xor	a
				or	(ix+CHP.TSlCnt)
				jr	z,ch_amp
				dec	(ix+CHP.TSlCnt)
				jr	nz,ch_amp
				ld	a,(ix+CHP.TnSlDl)
				ld	(ix+CHP.TSlCnt),a
				ld	l,(ix+CHP.TSlStp)
				ld	h,(ix+CHP.TSlStp+1)
				ld	a,h
				add	hl,de
				ld	(ix+CHP.CrTnSl),l
				ld	(ix+CHP.CrTnSl+1),h
				bit	2,(ix+CHP.Flags)
				jr	nz,ch_amp
				ld	e,(ix+CHP.TnDelt)
				ld	d,(ix+CHP.TnDelt+1)
				and	a
				jr	z,ch_stpp
				ex	de,hl
	ch_stpp:		sbc	hl,de
				jp	m,ch_amp
				ld	a,(ix+CHP.SlToNt)
				ld	(ix+CHP.Note),a
				xor	a
				ld	(ix+CHP.TSlCnt),a
				ld	(ix+CHP.CrTnSl),a
				ld	(ix+CHP.CrTnSl+1),a
	ch_amp:			ld	a,(ix+CHP.CrAmSl)
				bit	7,c
				jr	z,ch_noam
				bit	6,c
				jr	z,ch_amin
				cp	15
				jr	z,ch_noam
				inc	a
				jr	ch_svam
	ch_amin:		cp	256-15
				jr	z,ch_noam
				dec	a
	ch_svam:		ld	(ix+CHP.CrAmSl),a
	ch_noam:		ld	l,a
				ld	a,b
				and	15
				add	a,l
				jp	p,ch_apos
				xor	a
	ch_apos:		cp	16
				jr	c,ch_vol
				ld	a,15
	ch_vol:			or	(ix+CHP.Volume)
				ld	l,a
				ld	h,0
				ld	de,VT_
				add	hl,de
				ld	e,(hl)
	GlobalAttn:		ld	a,0			; GLOBAL ATTENUATION
				cp	8			; if value of attenuation is higher
				jr	c,ch_globvol		; then this value we will stop
				set	0,c			; also envelopes (bit.0 in flags)...
	ch_globvol:		sub	e
				jr	c,ch_env
				xor	a
	ch_env:			neg
				bit	0,c
				jr	nz,ch_noen
				or	(ix+CHP.Env_En)
	ch_noen:		ld	(Ampl),a
				bit	7,b
				ld	a,c
				jr	z,no_ensl
				rla
				rla
				sra	a
				sra	a
				sra	a
				add	a,(ix+CHP.CrEnSl)
				bit	5,b
				jr	z,no_enac
				ld	(ix+CHP.CrEnSl),a
	no_enac:		ld	hl,AddToEn+1
				add	a,(hl)
				ld	(hl),a
				jr	ch_mix
				
	no_ensl:		rra
				add	a,(ix+CHP.CrNsSl)
				ld	(AddToNs),a
				bit	5,b
				jr	z,ch_mix
				ld	(ix+CHP.CrNsSl),a
	ch_mix:			ld	a,b
				rra
				and	$48
	ch_exit:		ld	hl,AYREGS+AR_Mixer
				or	(hl)
				rrca
				ld	(hl),a
				pop	hl
				xor	a
				or	(ix+CHP.COnOff)
				ret	z
				dec	(ix+CHP.COnOff)
				ret	nz
				xor	(ix+CHP.Flags)
				ld	(ix+CHP.Flags),a
				rra
				ld	a,(ix+CHP.OnOffD)
				jr	c,ch_ondl
				ld	a,(ix+CHP.OffOnD)
	ch_ondl:		ld	(ix+CHP.COnOff),a
				ret
				
;------------------------------------------------------------------------------
	music_play:		xor	a
				ld	(AddToEn+1),a
				ld	(AYREGS+AR_Mixer),a
				dec	a
				ld	(AYREGS+AR_EnvTp),a
				ld	hl,DelyCnt
				dec	(hl)
				jp	nz,pl2
				call	chkfadeout
				ld	hl,ChanA+CHP.NtSkCn
				dec	(hl)
				jr	nz,pl1b
	AdInPtA:		ld	bc,NULL
				ld	a,(bc)
				and	a
				jr	nz,pl1a
				ld	d,a
				ld	(Ns_base),a
	CrPsPtr:		ld	hl,NULL
				inc	hl
				ld	a,(hl)
				inc	a
				jr	nz,plnlp
				call	checklp
	LPosPtr:		ld	hl,NULL
				ld	a,(hl)
				inc	a
	plnlp:			ld	(CrPsPtr+1),hl
				dec	a			; PT2		PT3
	PsCalc:			nop				; add a,a	nop
				nop				; add a,(hl)	nop
				add	a,a
				ld	e,a
				rl	d
	PatsPtr:		ld	hl,NULL
				add	hl,de
	modaddr:		ld	de,NULL
				ld	(psp_+1),sp
				ld	sp,hl
				pop	hl
				add	hl,de
				ld	b,h
				ld	c,l
				pop	hl
				add	hl,de
				ld	(AdInPtB+1),hl
				pop	hl
				add	hl,de
				ld	(AdInPtC+1),hl
	psp_:			ld	sp,NULL
	pl1a:			ld	ix,ChanA+12
				call	ptdecode
				ld	(AdInPtA+1),bc
				
	pl1b:			ld	hl,ChanB+CHP.NtSkCn
				dec	(hl)
				jr	nz,pl1c
				ld	ix,ChanB+12
	AdInPtB:		ld	bc,NULL
				call	ptdecode
				ld	(AdInPtB+1),bc
				
	pl1c:			ld	hl,ChanC+CHP.NtSkCn
				dec	(hl)
				jr	nz,pl1d
				ld	ix,ChanC+12
	AdInPtC:		ld	bc,NULL
				call	ptdecode
				ld	(AdInPtC+1),bc
	delay:			=	$+1
	pl1d:			ld	a,NULL
				ld	(DelyCnt),a
	pl2:			ld	ix,ChanA
				ld	hl,(AYREGS+AR_TonA)
				call	chregs
				ld	(AYREGS+AR_TonA),hl
				
				ld	a,(Ampl)
				ld	(AYREGS+AR_AmplA),a
				ld	ix,ChanB
				ld	hl,(AYREGS+AR_TonB)
				call	chregs
				ld	(AYREGS+AR_TonB),hl
				
				ld	a,(Ampl)
				ld	(AYREGS+AR_AmplB),a
				ld	ix,ChanC
				ld	hl,(AYREGS+AR_TonC)
				call	chregs
				ld	(AYREGS+AR_TonC),hl
				
				ld	hl,(Ns_base)		; read together with AddToNs
				ld	a,h
				add	a,l
				ld	(AYREGS+AR_Noise),a
				
	AddToEn:		ld	a,NULL
				ld	e,a
				add	a,a
				sbc	a,a
				ld	d,a
				ld	hl,(EnvBase)
				add	hl,de
				ld	de,(CurESld)
				add	hl,de
				ld	(AYREGS+AR_Env),hl
				
				xor	a
				ld	hl,CurEDel
				or	(hl)
				jr	z,rout_a0
				dec	(hl)
				jr	nz,rout
	Env_Del:		ld	a,NULL
				ld	(hl),a
	ESldAdd:		ld	hl,NULL
				add	hl,de
				ld	(CurESld),hl
				
	rout:			xor	a
	rout_a0:		ld	de,$1F1E		; D := RSEL, E := RDAT for HT-1080Z
				ld	c,d			; RSEL
				ld	hl,AYREGS
	lout:			out	(c),a
				ld	c,e			; RDAT
				outi
				ld	c,d			; RSEL
				inc	a
				cp	$0D
				jr	nz,lout
				out	(c),a
				ld	a,(hl)
				and	a
				ret	m
				ld	c,e			; RDAT
				out	(c),a
				ret
				
	checklp:		ld	hl,music_setup
				bit	1,(hl)
				jr	nz,enablefade
				bit	0,(hl)
				ret	z
				
	noloop:			set	7,(hl)
	deadend:		pop	hl
				ld	hl,DelyCnt
				inc	(hl)
				ld	hl,ChanA+CHP.NtSkCn
				inc	(hl)
				
	music_mute:		xor	a
				ld	h,a
				ld	l,a
				ld	(AYREGS+AR_AmplA),a
				ld	(AYREGS+AR_AmplB),hl
				jr	rout_a0
				
	enablefade:		ld	a,48
	forcefade:		ld	hl,chkfadeout+1
				inc	(hl)
				ld	hl,(CrPsPtr+1)
				ld	(resetfadeout+1),hl
				ld	(resetfadeout1+1),bc
				ld	(countfadeout+1),a
				ld	(divfadeout+1),a
				
	chkfadeout:		ld	a,0
				or	a
				ret	z
				ld	a,(music_setup)
				rlca
				jr	c,deadend
	countfadeout:		ld	a,NULL
				dec	a
				ld	(countfadeout+1),a
				ret	nz
				ld	a,(GlobalAttn+1)
				inc	a
				cp	16
				jr	z,resetfadeout
				ld	(GlobalAttn+1),a
	divfadeout:		ld	a,NULL
				srl	a
				ld	l,a
				srl	l
				add	a,l
				jr	nz,divfadeout1
				inc	a
	divfadeout1:		ld	(countfadeout+1),a
				ld	(divfadeout+1),a
				ret
				
	resetfadeout:		ld	hl,NULL
				ld	(CrPsPtr+1),hl
	resetfadeout1:		ld	hl,NULL
				ld	(AdInPtA+1),hl
				xor	a
				ld	(ChanA+CHP.NtSkCn),a
				ld	hl,music_setup
				jr	noloop
				
;------------------------------------------------------------------------------
; note table data
	nt_data:		db	(T_NEW_0-T1_)*2
				db	TCNEW_0-T_
				db	(T_OLD_0-T1_)*2+1
				db	TCOLD_0-T_
				db	(T_NEW_1-T1_)*2+1
				db	TCNEW_1-T_
				db	(T_OLD_1-T1_)*2+1
				db	TCOLD_1-T_
				db	(T_NEW_2-T1_)*2
				db	TCNEW_2-T_
				db	(T_OLD_2-T1_)*2
				db	TCOLD_2-T_
				db	(T_NEW_3-T1_)*2
				db	TCNEW_3-T_
				db	(T_OLD_3-T1_)*2
				db	TCOLD_3-T_
	T_			
				
	TCOLD_0			db	$00+1,$04+1,$08+1,$0A+1,$0C+1,$0E+1,$12+1,$14+1
				db	$18+1,$24+1,$3C+1,0
	TCOLD_1			db	$5C+1,0
	TCOLD_2			db	$30+1,$36+1,$4C+1,$52+1,$5E+1,$70+1,$82,$8C,$9C
				db	$9E,$A0,$A6,$A8,$AA,$AC,$AE,$AE,0
	TCNEW_3			db	$56+1
	TCOLD_3			db	$1E+1,$22+1,$24+1,$28+1,$2C+1,$2E+1,$32+1,$BE+1,0
	TCNEW_0			db	$1C+1,$20+1,$22+1,$26+1,$2A+1,$2C+1,$30+1,$54+1
				db	$BC+1,$BE+1,0
	TCNEW_1			=	TCOLD_1
	TCNEW_2			db	$1A+1,$20+1,$24+1,$28+1,$2A+1,$3A+1,$4C+1,$5E+1
				db	$BA+1,$BC+1,$BE+1,0
				
	PT3_EmptySmpOrn		=	$-1
				db	1,0			;$90 ; delete $90 if you don't need default sample
				
	PT2_EmptySmpOrn		=	VT_+31			; 1,0,0 sequence
				
; first 12 values of tone tables (packed)
	T_PACK			db	$0d, $d8		;high ($06EC*2),low($06EC*2)
				db	$0755-$06EC
				db	$07C5-$0755
				db	$083B-$07C5
				db	$08B8-$083B
				db	$093D-$08B8
				db	$09CA-$093D
				db	$0A5F-$09CA
				db	$0AFC-$0A5F
				db	$0BA4-$0AFC
				db	$0C55-$0BA4
				db	$0D10-$0C55
				db	$0C, $DA		; high ($066D*2),low($066D*2)
				db	$06CF-$066D
				db	$0737-$06CF
				db	$07A4-$0737
				db	$0819-$07A4
				db	$0894-$0819
				db	$0917-$0894
				db	$09A1-$0917
				db	$0A33-$09A1
				db	$0ACF-$0A33
				db	$0B73-$0ACF
				db	$0C22-$0B73
				db	$0CDA-$0C22
				db	$0E, $08		;high ($0704*2),low($0704*2)
				db	$076E-$0704
				db	$07E0-$076E
				db	$0858-$07E0
				db	$08D6-$0858
				db	$095C-$08D6
				db	$09EC-$095C
				db	$0A82-$09EC
				db	$0B22-$0A82
				db	$0BCC-$0B22
				db	$0C80-$0BCC
				db	$0D3E-$0C80
				db	$0F, $C0		;high ($07E0*2),low($07E0*2)
				db	$0858-$07E0
				db	$08E0-$0858
				db	$0960-$08E0
				db	$09F0-$0960
				db	$0A88-$09F0
				db	$0B28-$0A88
				db	$0BD8-$0B28
				db	$0C80-$0BD8
				db	$0D60-$0C80
				db	$0E10-$0D60
				db	$0EF8-$0E10
				
; channel data offsets
				struct	CHP,
					PsInOr.b,
					PsInSm.b,
					CrAmSl.b,
					CrNsSl.b,
					CrEnSl.b,
					TSlCnt.b,
					CrTnSl.w,
					TnAcc.w,
					COnOff.b,
					OnOffD.b,
					OffOnD.b,			; IX for PTDECOD here (+12)
					OrnPtr.w,
					SamPtr.w,
					NNtSkp.b,
					Note.b,
					SlToNt.b,
					Env_En.b,
					Flags.b,
					TnSlDl.b,			; Enabled - 0, SimpleGliss - 2
					TSlStp.w,
					TnDelt.w,
					NtSkCn.b,
					Volume.b
				
				
	AR_TonA			equ	0			; word 1
	AR_TonB			equ	2			; word 1
	AR_TonC			equ	4			; word 1
	AR_Noise		equ	6			; byte 1
	AR_Mixer		equ	7			; byte 1
	AR_AmplA		equ	8			; byte 1
	AR_AmplB		equ	9			; byte 1
	AR_AmplC		equ	10			; byte 1
	AR_Env			equ	11			; word 1
	AR_EnvTp		equ	13			; byte 1
	AR_Size			equ	14
				
				
;------------------------------------------------------------------------------
; variables are 541 bytes long
				
	VARS			
	ChanA			ds	29
	ChanB			ds	29
	ChanC			ds	29
				
; GlobalVars
	DelyCnt			db	0
	CurESld			dw	0
	CurEDel			db	0
	Ns_base			db	0
	AddToNs			db	0
				
	AYREGS			=	$
	Ampl			=	AYREGS+AR_AmplC
				
	VT_			ds	256			; Volume Table
	NT_			ds	192			; Note Table				
				
	EnvBase			=	VT_+14
	T1_			=	VT_+16			; Tone tables data depacked here
	T_OLD_1			=	T1_
	T_OLD_2			=	T_OLD_1+24
	T_OLD_3			=	T_OLD_2+24
	T_OLD_0			=	T_OLD_3+2
	T_NEW_0			=	T_OLD_0
	T_NEW_1			=	T_OLD_1
	T_NEW_2			=	T_NEW_0+24
	T_NEW_3			=	T_OLD_3
				
	VAR0END			=	T1_			; init zeroes from VARS to VAR0END-1
	VARSEND			=	$
				
; -----------------------------------------------------------------------------
; FULL AY-3-8910 RESET
; -----------------------------------------------------------------------------
	fade_out:		
				ld	B,15			; 15-ös hangerőről indulunk (max)				
	FADE_LOOP:		
    ; --- A csatorna (R8) ---
				ld	A,8			; R8 kiválasztása
				out	($1f),A
				ld	A,B
				out	($1e),A			; Aktuális hangerő kiírása
				
    ; --- B csatorna (R9) ---
				ld	A,9			; R9 kiválasztása
				out	($1f),A
				ld	A,B
				out	($1e),A
				
    ; --- C csatorna (R10) ---
				ld	A,10			; R10 kiválasztása
				out	($1f),A
				ld	A,B
				out	($1e),A
				
    ; --- Késleltetés (Delay) ---
    ; Hogy 1.5 mp legyen: 15 lépés * 0.1 mp várakozás
				ld	DE,15000		; Ez kb. 0.1 másodperc 1.77 MHz-en
	DELAY:			
				dec	DE
				ld	A,D
				or	E
				jr	NZ,DELAY
				
				djnz	FADE_LOOP		; B csökkentése, ha nem 0, hurok vissza
				
    ; Végén teljes csend (B=0-nál kilépett, de biztosra megyünk)
				ret
				
; -----------------------------------------------------------------------------				
