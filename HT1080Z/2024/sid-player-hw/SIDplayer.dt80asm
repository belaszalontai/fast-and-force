;===============================================================================
; PLAYS converted C64 SID music on HT-1080Z using AY-3-8910 sound chip
;===============================================================================
; (c) 2024 by Béla Szalontai (Fast & Force)
;===============================================================================
				
				; HT-1080Z
				org	17129
				genbinary
				
				call	$01c9			; CLS
				
				ld	hl,TITLE_PIC		; a ZX7-el tömörített HTPIC kép címe
				ld	de,$3c00		; a video memória címe
				call	ZX7_DECOMPRESS		; kicsomagoljuk egyből a video RAM-ba
				
				ld	hl,TITLE_TEXT1		; title text 1
				ld	de,$3c00+11*64
				ld	bc,64
				ldir
				
				ld	hl,TITLE_TEXT2		; title text 2
				ld	de,$3c00+12*64
				ld	bc,64
				ldir
				
				ld	hl,TITLE_TEXT3		; title text 3
				ld	de,$3c00+13*64
				ld	bc,64
				ldir
				
				ld	hl,MUSIC_DATA_ZX7	; átmásoljuk a zx7-el becsomagolt zenét a memória tetejére
				ld	de,MUSIC_DATA_TEMP
				ld	bc,MUSIC_DATA_LENGTH
				ldir
				
				ld	hl,MUSIC_DATA_TEMP	; kicsomagoljuk a ZX7-el tömörített zenét
				ld	de,MUSIC_DATA
				call	ZX7_DECOMPRESS
				
				call	AY_init
	demoloop		call	WAITQ			; waits for 20ms programmed
				call	play_SID_frame
				jp	demoloop
				
; Programmed Waiting
	WAITQ			
				ld	BC,800			; ~800 * 40 T state
	DLY1			dec	BC			; [6]
				nop				; [4]
				nop				; [4]
				nop				; [4]
				nop				; [4]
				ld	A,B			; [4]
				or	C			; [4]
				jp	NZ,DLY1			; [10]
				ret
				
; init AY chip, enable Tone and set volume to max for all channels
	AY_init			ld	a,7			; MIXER - R7 = $FF-7 (11111000b)
				out	($1F),a
				ld	a,255-7			; enable Tone for all channels
				out	($1E),a
				ld	a,8			; R8 - channel A amplitude
				out	($1F),a
				ld	a,$0F			; max volume, no envelope
				out	($1E),a
				ld	a,9			; R9 - channel B amplitude
				out	($1F),a
				ld	a,$0F			; max volume, no envelope
				out	($1E),a
				ld	a,10			; R10 - channel C amplitude
				out	($1F),a
				ld	a,$0F			; max volume, no envelope
				out	($1E),a
				ret
				
; PLAYS one frame of converted C64 SID music
	play_SID_frame		
; Handling ADSR for channels (only volume release)				
	CH1_VOL_RELEASE_CNT	ld	bc,256
				dec	bc
				ld	(CH1_VOL_RELEASE_CNT+1),bc
				ld	a,b
				or	c
				jp	nz,CH2_VOL_RELEASE_CNT_B
	CH1_VOL_RELEASE		ld	bc,256			; reset counter
				ld	(CH1_VOL_RELEASE_CNT+1),bc
				ld	a,(CH1_VOLUME+1)
				dec	a			; decrease volume 
				jp	c,CH2_VOL_RELEASE_CNT_B6
				ld	(CH1_VOLUME+1),a
				jp	CH2_VOL_RELEASE_CNT
				
	CH2_VOL_RELEASE_CNT_B	jp	CH2_VOL_RELEASE_CNT_B1	; balance 80 T state 
	CH2_VOL_RELEASE_CNT_B1	jp	CH2_VOL_RELEASE_CNT_B2
	CH2_VOL_RELEASE_CNT_B2	jp	CH2_VOL_RELEASE_CNT_B3
	CH2_VOL_RELEASE_CNT_B3	jp	CH2_VOL_RELEASE_CNT_B4
	CH2_VOL_RELEASE_CNT_B4	jp	CH2_VOL_RELEASE_CNT_B5
	CH2_VOL_RELEASE_CNT_B5	jp	CH2_VOL_RELEASE_CNT_B6
	CH2_VOL_RELEASE_CNT_B6	jp	CH2_VOL_RELEASE_CNT_B7
	CH2_VOL_RELEASE_CNT_B7	jp	CH2_VOL_RELEASE_CNT
				
	CH2_VOL_RELEASE_CNT	ld	bc,256
				dec	bc
				ld	(CH2_VOL_RELEASE_CNT+1),bc
				ld	a,b
				or	c
				jp	nz,CH3_VOL_RELEASE_CNT_B
	CH2_VOL_RELEASE		ld	bc,256			; reset counter
				ld	(CH2_VOL_RELEASE_CNT+1),bc
				ld	a,(CH2_VOLUME+1)
				dec	a			; decrease volume 
				jp	c,CH3_VOL_RELEASE_CNT_B6
				ld	(CH2_VOLUME+1),a
				jp	CH3_VOL_RELEASE_CNT
				
	CH3_VOL_RELEASE_CNT_B	jp	CH3_VOL_RELEASE_CNT_B1	; balance 80 T state 
	CH3_VOL_RELEASE_CNT_B1	jp	CH3_VOL_RELEASE_CNT_B2
	CH3_VOL_RELEASE_CNT_B2	jp	CH3_VOL_RELEASE_CNT_B3
	CH3_VOL_RELEASE_CNT_B3	jp	CH3_VOL_RELEASE_CNT_B4
	CH3_VOL_RELEASE_CNT_B4	jp	CH3_VOL_RELEASE_CNT_B5
	CH3_VOL_RELEASE_CNT_B5	jp	CH3_VOL_RELEASE_CNT_B6
	CH3_VOL_RELEASE_CNT_B6	jp	CH3_VOL_RELEASE_CNT_B7
	CH3_VOL_RELEASE_CNT_B7	jp	CH3_VOL_RELEASE_CNT
				
	CH3_VOL_RELEASE_CNT	ld	bc,256
				dec	bc
				ld	(CH3_VOL_RELEASE_CNT+1),bc
				ld	a,b
				or	c
				jp	nz,MUSICPOS_B
	CH3_VOL_RELEASE		ld	bc,256			; reset counter
				ld	(CH3_VOL_RELEASE_CNT+1),bc
				ld	a,(CH3_VOLUME+1)
				dec	a			; decrease volume 
				jp	c,MUSICPOS_B6
				ld	(CH3_VOLUME+1),a
				jp	MUSICPOS
				
	MUSICPOS_B		jp	MUSICPOS_B1		; balance 80 T state 
	MUSICPOS_B1		jp	MUSICPOS_B2
	MUSICPOS_B2		jp	MUSICPOS_B3
	MUSICPOS_B3		jp	MUSICPOS_B4
	MUSICPOS_B4		jp	MUSICPOS_B5
	MUSICPOS_B5		jp	MUSICPOS_B6
	MUSICPOS_B6		jp	MUSICPOS_B7
	MUSICPOS_B7		jp	MUSICPOS
				
; parse record							
	MUSICPOS		ld	HL,MUSIC_DATA
				ld	d,$48			; high address of sound frequency constant lookup table
	MP_CH1			inc	hl
				ld	a,(hl)			; load first byte of music record
; check control codes for channel 1
				cp	LOOP			; first byte can be LOOP control
				jp	nz,MP_SKIP
	MUSIC_RESTART		ld	HL,MUSIC_DATA-1		; reset music data pointer
				ld	(MUSICPOS+1),HL
				jp	MP_CH1			; restart parsing
				
	MP_SKIP			cp	SKIP
				jp	z,MP_CH2		; SKIP -> skip channel 1
				cp	FRQINC00
				jp	c,MP_CH1_NEXT1
				cp	FRQINC0F + 1
				jp	nc,MP_CH1_NEXT1
; INCFREQ0x -> increment frequency
				sub	FRQINC00		; A = freq delta / 16
				srl	a
				srl	a
				srl	a
				srl	a
				push	hl
				ld	hl,(PAC1+1)
				ld	b,0
				ld	c,a
				or	a			; clear CY
				sbc	hl,bc
				ld	(PAC1+1),hl
				pop	hl
				jp	MP_CH2
	MP_CH1_NEXT1		cp	FRQDEC00
				jp	c,MP_CH1_NEXT2
				cp	FRQDEC0F + 1
				jp	nc,MP_CH1_NEXT2
; DECFREQ0x -> decrement frequency
				sub	FRQDEC00		; A = freq delta / 16
				srl	a
				srl	a
				srl	a
				srl	a
				push	hl
				ld	hl,(PAC1+1)
				ld	b,0
				ld	c,a
				add	hl,bc
				ld	(PAC1+1),hl
				pop	hl
				jp	MP_CH2
	MP_CH1_NEXT2		call	CHECK_RELEASE_CONTROL
				jp	nz,MP_CH1_NEXT3
				ld	(CH1_VOL_RELEASE+1),bc
				jp	MP_CH1
; handle normal musical note on CH1
	MP_CH1_NEXT3		ld	e,a
				sla	e			; low address of sound frequency constant lookup table = control code * 2
				ld	a,(de)			; load frequ constant for CH1
				inc	de
				ld	c,a
				ld	a,(de)
				ld	b,a
				ld	(PAC1+1),BC		; put into CH1 freq constant in irq handler    
				ld	a,MASTER_VOLUME_CH1	; new sound -> new volume
				ld	(CH1_VOLUME+1),a
				ld	bc,(CH1_VOL_RELEASE+1)
				ld	(CH1_VOL_RELEASE_CNT+1),bc
				
	MP_CH2			inc	hl
				ld	a,(hl)
; check control codes for channel 2
				cp	SKIP
				jp	z,MP_CH3		; SKIP -> skip channel 2
				cp	FRQINC00
				jp	c,MP_CH2_NEXT1
				cp	FRQINC0F + 1
				jp	nc,MP_CH2_NEXT1
; INCFREQ0x -> increment frequency
				sub	FRQINC00		; A = freq delta / 16
				srl	a
				srl	a
				srl	a
				srl	a
				push	hl
				ld	hl,(PAC2+1)
				ld	b,0
				ld	c,a
				or	a			; clear CY
				sbc	hl,bc
				ld	(PAC2+1),hl
				pop	hl
				jp	MP_CH3
	MP_CH2_NEXT1		cp	FRQDEC00
				jp	c,MP_CH2_NEXT2
				cp	FRQDEC0F + 1
				jp	nc,MP_CH2_NEXT2
; DECFREQ0x -> decrement frequency
				sub	FRQDEC00		; A = freq delta / 16
				srl	a
				srl	a
				srl	a
				srl	a
				push	hl
				ld	hl,(PAC2+1)
				ld	b,0
				ld	c,a
				add	hl,bc
				ld	(PAC2+1),hl
				pop	hl
				jp	MP_CH3
	MP_CH2_NEXT2		call	CHECK_RELEASE_CONTROL
				jp	nz,MP_CH2_NEXT3
				ld	(CH2_VOL_RELEASE+1),bc
				jp	MP_CH2
; handle normal musical note on CH2
	MP_CH2_NEXT3		ld	e,a
				sla	e			; low address of sound frequency constant lookup table
				ld	a,(de)			; load frequ constant for CH2
				inc	de
				ld	c,a
				ld	a,(de)
				ld	b,a
				ld	(PAC2+1),BC		; put into CH2 freq constant in irq handler     
				ld	a,MASTER_VOLUME_CH2	; new sound -> new volume
				ld	(CH2_VOLUME+1),a
				ld	bc,(CH2_VOL_RELEASE+1)
				ld	(CH2_VOL_RELEASE_CNT+1),bc
				
	MP_CH3			inc	hl
				ld	a,(hl)
; check control codes for channel 3
				cp	SKIP
				jp	z,MP_END		; SKIP -> skip channel 3
				cp	FRQINC00
				jp	c,MP_CH3_NEXT1
				cp	FRQINC0F + 1
				jp	nc,MP_CH3_NEXT1
; INCFREQ0x -> increment frequency
				sub	FRQINC00		; A = freq delta / 16
				srl	a
				srl	a
				srl	a
				srl	a
				push	hl
				ld	hl,(PAC3+1)
				ld	b,0
				ld	c,a
				or	a			; clear CY
				sbc	hl,bc
				ld	(PAC3+1),hl
				pop	hl
				jp	MP_END
	MP_CH3_NEXT1		cp	FRQDEC00
				jp	c,MP_CH3_NEXT2
				cp	FRQDEC0F + 1
				jp	nc,MP_CH3_NEXT2
; DECFREQ0x -> decrement frequency
				sub	FRQDEC00		; A = freq delta / 16
				srl	a
				srl	a
				srl	a
				srl	a
				push	hl
				ld	hl,(PAC3+1)
				ld	b,0
				ld	c,a
				add	hl,bc
				ld	(PAC3+1),hl
				pop	hl
				jp	MP_END
	MP_CH3_NEXT2		call	CHECK_RELEASE_CONTROL
				jp	nz,MP_CH3_NEXT3
				ld	(CH3_VOL_RELEASE+1),bc
				jp	MP_CH3
; handle normal musical note on CH3
	MP_CH3_NEXT3		ld	e,a
				sla	e			; low address of sound frequency constant lookup table
				ld	a,(de)			; load frequ constant for CH3
				inc	de
				ld	c,a
				ld	a,(de)
				ld	b,a
				ld	(PAC3+1),BC		; put into CH3 freq constant in irq handler    				
				ld	a,MASTER_VOLUME_CH3	; new sound -> new volume
				ld	(CH3_VOLUME+1),a
				ld	bc,(CH3_VOL_RELEASE+1)
				ld	(CH3_VOL_RELEASE_CNT+1),bc
				
	MP_END			ld	(MUSICPOS+1),HL
				
; set AY-3-8910 registers
	PAC1			ld	hl,0			; freq for channel A
				xor	a			; R0
				out	($1F),a
				ld	a,l			; Channel A Tone Period = HL
				out	($1E),a
				ld	a,1			; R1
				out	($1F),a
				ld	a,h
				out	($1E),a
	PAC2			ld	hl,0			; freq for channel B
				ld	a,2			; R2
				out	($1F),a
				ld	a,l			; Channel B Tone Period = HL
				out	($1E),a
				ld	a,3			; R3
				out	($1F),a
				ld	a,h
				out	($1E),a
	PAC3			ld	hl,0			; freq for channel C
				ld	a,4			; R4
				out	($1F),a
				ld	a,l			; Channel C Tone Period = HL
				out	($1E),a
				ld	a,5			; R5
				out	($1F),a
				ld	a,h
				out	($1E),a
				
				ld	a,8			; R8 - channel A amplitude
				out	($1F),a
	CH1_VOLUME		ld	a,$0F			; max volume, no envelope
				out	($1E),a
				ld	a,9			; R9 - channel A amplitude
				out	($1F),a
	CH2_VOLUME		ld	a,$0F			; max volume, no envelope
				out	($1E),a
				ld	a,10			; R10 - channel A amplitude
				out	($1F),a
	CH3_VOLUME		ld	a,$0F			; max volume, no envelope
				out	($1E),a
				ret
;--------------------------------------------------------------------------------------------------------------------------------------                                   
; check and set ADSR Release control code
; INPUT: 	A = control code to be look up
; OUTPUT: 	BC = VOL RELEASE COUNTER if RELEASE00..RELEASE0F code is found
; 		Z = 1 if found
;--------------------------------------------------------------------------------------------------------------------------------------                                   
	CHECK_RELEASE_CONTROL	cp	ADSR00
				jp	nz,MP_CH1_NEXT21
				ld	bc,1			; ~ 7ms
				ret
	MP_CH1_NEXT21		cp	ADSR01
				jp	nz,MP_CH1_NEXT22
				ld	bc,1			; ~ 24ms
				ret
	MP_CH1_NEXT22		cp	ADSR02
				jp	nz,MP_CH1_NEXT23
				ld	bc,1			; ~ 49ms
				ret
	MP_CH1_NEXT23		cp	ADSR03
				jp	nz,MP_CH1_NEXT24
				ld	bc,1			; ~ 74ms
				ret
	MP_CH1_NEXT24		cp	ADSR04
				jp	nz,MP_CH1_NEXT25
				ld	bc,1			; ~ 116ms
				ret
	MP_CH1_NEXT25		cp	ADSR05
				jp	nz,MP_CH1_NEXT26
				ld	bc,1			; ~ 169ms
				ret
	MP_CH1_NEXT26		cp	ADSR06
				jp	nz,MP_CH1_NEXT27
				ld	bc,1			; ~ 204ms
				ret
	MP_CH1_NEXT27		cp	ADSR07
				jp	nz,MP_CH1_NEXT28
				ld	bc,1			; ~ 240ms
				ret
	MP_CH1_NEXT28		cp	ADSR08
				jp	nz,MP_CH1_NEXT29
				ld	bc,2			; ~ 300ms
				ret
	MP_CH1_NEXT29		cp	ADSR09
				jp	nz,MP_CH1_NEXT2A
				ld	bc,4			; ~ 752ms
				ret
	MP_CH1_NEXT2A		cp	ADSR0A
				jp	nz,MP_CH1_NEXT2B
				ld	bc,7			; ~ 1501ms
				ret
	MP_CH1_NEXT2B		cp	ADSR0B
				jp	nz,MP_CH1_NEXT2C
				ld	bc,10			; ~ 2402ms
				ret
	MP_CH1_NEXT2C		cp	ADSR0C
				jp	nz,MP_CH1_NEXT2D
				ld	bc,28			; ~ 3002ms
				ret
	MP_CH1_NEXT2D		cp	ADSR0D
				jp	nz,MP_CH1_NEXT2E
				ld	bc,46			; ~ 9001ms
				ret
	MP_CH1_NEXT2E		cp	ADSR0E
				jp	nz,MP_CH1_NEXT2F
				ld	bc,75			; ~ 15000ms
				ret
	MP_CH1_NEXT2F		cp	ADSR0F
				ret	nz
				ld	bc,150			; ~ 24001ms
				ret
				
;--------------------------------------------------------------------------------------------------------------------------------------                                   
; ZX7_DECOMPRESS - HL: Compressed data, DE: Target address
				
	ZX7_DECOMPRESS						;di				; disable interrupts               
	DZX7STANDARD		ld	A,$80
	COPYBYTELOOPEV		ldi				; copy literal byte
	MAINLOOPEV		add	A,A			; check next bit
				jp	Z,LOADBITS1		; no more bits left?
				jp	C,LENSIZESTARTOD	; next bit indicates either literal or sequence
				
	COPYBYTELOOPOD		ldi				; copy literal byte
	MAINLOOPOD		add	A,A			; check next bit
				jp	NC,COPYBYTELOOPEV	; next bit indicates either literal or sequence
				
	               ; determine number of bits used for length (Elias gamma coding)
	LENSIZESTARTEV		push	DE
				ld	BC,1
				ld	D,B
	LENSIZELOOPEV		inc	D
				add	A,A			; check next bit
				jp	Z,LOADBITS2EV		; no more bits left?
				jp	NC,LENSIZELOOPEV
				jp	LENVALUESTARTEV
				
	               ; determine number of bits used for length (Elias gamma coding)
	LENSIZESTARTOD		push	DE
				ld	BC,1
				ld	D,B
	LENSIZELOOPOD		inc	D
				add	A,A			; check next bit
				jp	Z,LOADBITS2OD		; no more bits left?
				jp	NC,LENSIZELOOPOD
				jp	LENVALUESTARTOD
				
	               ; determine length
	LENVALUELOOPEV		add	A,A			; check next bit
				jp	Z,LOADBITS3EV		; no more bits left?
				rl	C
				rl	B
				jp	C,EXITEV		; check end marker
	LENVALUESTARTEV		dec	D
				jp	NZ,LENVALUELOOPEV
				inc	BC			; adjust length
				
				   ; determine offset                           
	OFFSETSTARTOD		ld	E,(HL)			; load offset flag (1 bit) + offset value (7 bits)
				inc	HL
				sll	E			; opcode for undocumented instruction "SLL E" aka "SLS E"
				jp	NC,OFFSETENDOD		; if offset flag is set,load 4 extra bits
				add	A,A			; check next bit
				rl	D			; insert first bit into D
				add	A,A			; check next bit
				jp	Z,LOADBITS4		; no more bits left?
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				jp	Z,LOADBITS5		; no more bits left?
				ccf
				jp	C,OFFSETENDOD
	OFFSETINCOD		inc	D			; equivalent to adding 128 to DE
	OFFSETENDOD		rr	E			; insert inverted fourth bit into E
				
	               ; copy previous sequence
				ex	(SP),HL			; store source,restore destination
				push	HL			; store destination
				sbc	HL,DE			; HL = destination - offset - 1
				pop	DE			; DE = destination
				ldir
				pop	HL			; restore source address (compressed data)
				jp	MAINLOOPOD
				
	LOADBITS1		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jp	C,LENSIZESTARTOD	; next bit indicates either literal or sequence
				jp	COPYBYTELOOPOD
				
	LOADBITS2EV		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jp	NC,LENSIZELOOPEV
				jp	LENVALUESTARTEV
				
	LOADBITS2OD		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				jp	NC,LENSIZELOOPOD
				jp	LENVALUESTARTOD
				
	LOADBITS3EV		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	C
				rl	B
				jp	NC,LENVALUESTARTEV	; check end marker
	EXITEV			pop	DE
				ret
				
	LOADBITS4		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jp	C,OFFSETENDOD
				jp	OFFSETINCOD
				
	LOADBITS5		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				ccf
				jp	C,OFFSETENDOD
				jp	OFFSETINCOD
				
	               ; determine length
	LENVALUELOOPOD		add	A,A			; check next bit
				jp	Z,LOADBITS3OD		; no more bits left?
				rl	C
				rl	B
				jp	C,EXITOD		; check end marker
	LENVALUESTARTOD		dec	D
				jp	NZ,LENVALUELOOPOD
				inc	BC			; adjust length                              
				
	               ; determine offset
	OFFSETSTARTEV		ld	E,(HL)			; load offset flag (1 bit) + offset value (7 bits)
				inc	HL
				sll	E			; opcode for undocumented instruction "SLL E" aka "SLS E"
				jp	NC,OFFSETENDEV		; if offset flag is set,load 4 extra bits
				add	A,A			; check next bit
				jp	Z,LOADBITS6		; no more bits left?
				rl	D			; insert first bit into D
				add	A,A			; check next bit
				rl	D			; insert second bit into D
				add	A,A			; check next bit
				jp	Z,LOADBITS7		; no more bits left?
				rl	D			; insert third bit into D
				add	A,A			; check next bit
				ccf
				jp	C,OFFSETENDEV
	OFFSETINCEV		inc	D			; equivalent to adding 128 to DE
	OFFSETENDEV		rr	E			; insert inverted fourth bit into E
				
	               ; copy previous sequence
				ex	(SP),HL			; store source,restore destination
				push	HL			; store destination
				sbc	HL,DE			; HL = destination - offset - 1
				pop	DE			; DE = destination
				ldir
				pop	HL			; restore source address (compressed data)
				jp	MAINLOOPEV
				
	LOADBITS3OD		ld	A,(HL)			; load another group of 8 bits
				inc	HL
				rla
				rl	C
				rl	B
				jp	NC,LENVALUESTARTOD	; check end marker
	EXITOD			pop	DE
				ret
				
