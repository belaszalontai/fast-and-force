	src:			dw	0
	dst:			dw	0
				
				
				
;------------------------------------------------------------------------------			
;	src:=#circle;
;	dst:= $3c00;
;	
;	for i:=0 to 16 do
;	begin
;		for j:=0 to 64 do
;		begin
;			pixel:=src[j+table_pointer+16]+time;
;			if (pixel < 128 ) then pixel+=128;
;			if (pixel > 224 ) then pixel:=128 // blank character
;			else if (pixel > 191 ) then pixel:=129;
;			dst[j]:=pixel;
;		end;
;		dst+=64;
;		src+=128;
;------------------------------------------------------------------------------				
	RenderCircles		ld	a,(time)
				ld	(place_of_time+1),a	; set up time variable out of the loop

				ld	hl,circles		; plasma table
				ld	de,(table_pointer)
				add	hl,de
				ld	de,16
				add	hl,de			; hl = circles + table_pointer + 16

				ld	de,$3c00+2*64		; de = video memory
				ld	c,12			; loop outer
	RenderCircle_loop1	ld	b,64			; loop inner
	RenderCircle_loop2	ld	a,(hl)			; a = src[ j + table_pointer + 16 ]
				inc	hl
	place_of_time		add	a,0			; a = src[ j + table_pointer + 16 ] + time
				cp	128
				jp	c,pot1			; if (a < 128)
				jp	pot11				
	pot1			add	a,128			; a = a + 128
	pot11			;cp	224			
				;jp	c,pot2			; if (a > 224)
				;ld	a,128			; a = 128
				;jp	pote			
	pot2			;cp	191
				;jp	c,pote			; else if (a > 191)
				;ld	a,129			; a = 129	
	pote			ld	(de),a			; dst[j]:=pixel;
				inc	de
				djnz 	RenderCircle_loop2
				
				push	de			; src = src + 64
				ld	de,64
				add	hl,de
				pop de
				
				dec	c
				jp	nz,RenderCircle_loop1

				ret

;------------------------------------------------------------------------------			
	init_plasma		ld	a,$80
				ld	(time),a
				ret

;------------------------------------------------------------------------------				
	render_plasma		call	RenderCircles
				ld	a,(plasma_speed+1)
				inc	a
				ld	(plasma_speed+1),a
				cp	5
				jp	nz,ps1
				ld	a,1
				ld	(plasma_speed+1),a

	; 'a:=a + const'  optimization 
	ps1			ld	a,(time)
	plasma_speed		add	a,1
				ld	(time),a
	; Binary clause core: EQUALS
	; Compare with pure num / var optimization
				ld	a,(alternate)
				or	a
				jp	nz,MainProgram_eblock416
	MainProgram_ctb415:					;Main true block ;keep :
	; 16 bit BINOP
	; RHS is pure 
				ld	de,$01
	; Variable is 16-bit
				ld	hl,(table_pointer)
				add	hl,de
				ld	(table_pointer),hl
				ld	de,$20
				xor	a			; clear carry
				sbc	hl,de
				jr	nz,MainProgram_edblock562
	MainProgram_ctb560:					;Main true block ;keep :
				ld	a,$1
				ld	(alternate),a
	MainProgram_edblock562:	
				ret
	MainProgram_eblock416:	
	; Binary clause core: EQUALS
	; Compare with pure num / var optimization
				ld	a,(alternate)
				cp	$1
				jp	nz,MainProgram_eblock568
	MainProgram_ctb567:					;Main true block ;keep :
	; 16 bit BINOP
	; RHS is pure 
				ld	de,$80
	; Variable is 16-bit
				ld	hl,(table_pointer)
				add	hl,de
				ld	(table_pointer),hl
				ld	de,$1020
				xor	a			; clear carry
				sbc	hl,de
				jr	nz,MainProgram_edblock638
	MainProgram_ctb636:					;Main true block ;keep :
				ld	a,$2
				ld	(alternate),a
	MainProgram_edblock638:	
				ret
	MainProgram_eblock568:	
	; Binary clause core: EQUALS
	; Compare with pure num / var optimization
				ld	a,(alternate)
				cp	$2
				jr	nz,MainProgram_eblock644
	MainProgram_ctb643:					;Main true block ;keep :
	; 16 bit BINOP
	; RHS is pure 
				ld	de,$01
	; Variable is 16-bit
				ld	hl,(table_pointer)
				xor	a			; clear carry
				sbc	hl,de
				ld	(table_pointer),hl
				ld	de,$1000
				xor	a			; clear carry
				sbc	hl,de
				jr	nz,MainProgram_edblock676
	MainProgram_ctb674:					;Main true block ;keep :
				ld	a,$3
				ld	(alternate),a
	MainProgram_edblock676:	
				ret
	MainProgram_eblock644:	
	; Binary clause core: EQUALS
	; Compare with pure num / var optimization
				ld	a,(alternate)
				cp	$3
				ret	nz
	MainProgram_ctb681:					;Main true block ;keep :
	; 16 bit BINOP
	; RHS is pure 
				ld	de,$80
	; Variable is 16-bit
				ld	hl,(table_pointer)
				xor	a			; clear carry
				sbc	hl,de
				ld	(table_pointer),hl
				ld	de,$00
				xor	a			; clear carry
				sbc	hl,de
				ret	nz
	MainProgram_ctb693:					;Main true block ;keep :
				ld	a,$0
				ld	(alternate),a
				
				ret
				
				end